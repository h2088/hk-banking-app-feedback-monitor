{"author":{"uri":{"label":"https://itunes.apple.com/hk/reviews/id1572711215"}, "name":{"label":"maggielauu"}, "label":""}, "updated":{"label":"2024-02-05T18:24:29-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"7.3.0"}, "id":{"label":"10906741354"}, "title":{"label":"Some problem"}, "content":{"label":"I like the new interface of the app. But the app is not working when I try to open a deposit account. It stuck and keep loading after I enter the SMS code.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/hk/review?id=445795688&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"應用程式"}}, "im:voteCount":{"label":"0"}}, 
