		.sc-video-column--full {
            background-color: #2b2929 !important;
        }
        .sc-banner-promotion--right-img .sc-banner {
            overflow: unset;
            background-color: transparent;
        }

        @media (max-width: 1240px) {
            .sc-banner-promotion--right-img .sc-banner__content {
                padding: 0;
            }
        }
        .sc-banner-promotion--right-img .sc-banner__right-image {
                margin-top: -30px;
                right: -30px;
                margin-bottom: -80px;
                top: -10px;
            }
        @media (min-width: 680px) {
          
            .sc-banner-promotion--right-img .sc-banner__bg {
                border-radius: 32px 122px;
            }

            

            .sc-banner-promotion--right-img .sc-banner__right-image img {
                object-fit: contain;
                object-position: 0%;
                max-height:550px;
            }
             .sc-banner-promotion.sc-banner-promotion--right-img .sc-content-wrapper .sc-content-wrapper {
                align-items: end;
                width:59%;
            }
            .sc-banner-promotion.sc-banner-promotion--right-img .sc-content-wrapper .sc-content-wrapper .sc-banner__content{
                max-width:400px;
            }
            .sc-banner-promotion.sc-banner-promotion--right-img .sc-content-wrapper .sc-banner__right-image {
                width:41%;
            }
        }

        @media (max-width: 680px) {
            .sc-banner-promotion--right-img .sc-content-wrapper {
                padding: 24px 16px;
            }

            .sc-banner-promotion--right-img .sc-banner__bg {
                border-radius: 12px 64px;
            }

            .sc-banner-promotion--right-img .sc-banner__title {
                text-align: center;
            }

            .sc-banner-promotion--right-img .sc-banner__right-image {
                top: -40px;
            }

            .sc-banner-promotion--right-img .sc-banner__right-image img {
                object-fit: contain;
                object-position: bottom;
                height: auto;
                transform: rotate(10.57deg);
                
            }
            
            .sc-banner-promotion.sc-banner-promotion--right-img .sc-banner__content {
               padding-top:64px;
            }
            .sc-banner-promotion--right-img .sc-banner__right-image img {
                  max-width: 250px;
              }
        }
        .sc-banner-promotion .sc-banner .sc-content-wrapper {
            min-height: 400px !important;
        }
       
        .sc-banner-promotion.sc-banner-promotion--right-img .sc-content-wrapper .sc-banner__title {
            font-size: 1.5rem;
        }
         .sc-banner-promotion.sc-banner-promotion--right-img .sc-content-wrapper .sc-banner__desc {
            font-size: 0.875rem;
        }
        .sc-banner-promotion.sc-banner-promotion--right-img  .sc-content-wrapper .sc-banner__bg {
                -webkit-filter: brightness(1);
                filter: brightness(1);
            }
