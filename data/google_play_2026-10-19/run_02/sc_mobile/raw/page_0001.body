",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXRDgY2-K_47KvcnoCUjyZG5opHqWB8Te-yaR75LAHK2zHNd5g\"]]],5,null,\"fast\",[1731916423,383000000],0,[\"Standard Chartered Bank PLC\",\"Hi Annie Ng, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Sara\",[1731979711,736000000]],null,[\"101694430656197727494\",\"Annie Ng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXRDgY2-K_47KvcnoCUjyZG5opHqWB8Te-yaR75LAHK2zHNd5g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,null,null,null,null,1],[\"239ce714-557e-4fc6-8a4e-10d5e1f43846\",[\"Mohammad Sarfraz\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUH4-d90rCF_yZTKbszhW0gnsJ4T00miVSPHA21l718IVxpUR3m\"]]],5,null,\"Easy to use and works Quicker.\",[1731905092,535000000],0,[\"Standard Chartered Bank PLC\",\"Hi Mohammad Sarfraz, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience. ~ Sara\",[1731979669,341000000]],null,[\"110997635979460255886\",\"Mohammad Sarfraz\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUH4-d90rCF_yZTKbszhW0gnsJ4T00miVSPHA21l718IVxpUR3m\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,null,null,null,null,1],[\"ff209d1a-ed0d-4cca-9afb-cd6a0ea3b330\",[\"Frankenstein 12\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX_NZwD4LD44WG_tJO1Gj6E_d2dNOoM69N3Kx2xD2eF7fVuY_K1\"]]],5,null,\"Great app, easy to use and very efficient.\",[1731469584,582000000],1,[\"Standard Chartered Bank PLC\",\"Hi Frankenstein 12, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Carl\",[1731470850,517000000]],null,[\"107820453875210045883\",\"Frankenstein 12\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX_NZwD4LD44WG_tJO1Gj6E_d2dNOoM69N3Kx2xD2eF7fVuY_K1\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,null,null,null,null,1],[\"c1c78b3a-438b-47c0-b1b3-679c7c90979d\",[\"Pradeep Halebeedu Prakash\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ_vbVJvzy7TnJFzk1GgQ2bwM1-N2K5BnHUhfPw4x-TZ9y6Xw\\u003dmo\"]]],1,null,\"Not working in Xiaomi K20 Pro. Please check it.\",[1731061589,567000000],0,[\"Standard Chartered Bank PLC\",\"Hi Pradeep Halebeedu Prakash, SC Mobile App is supported on iPhone 6S or later models with iOS 14/+, smartphones with Android 9.0/+ or Harmony 2.If you are Android User (without Google Play), you can refer our website: https://www.sc.com/hk/bank-with-us/app-sc-mobile/apk-download/ for install our Android application package (APK). ~ Sara\",[1731299028,515000000]],null,[\"102871973760948425865\",\"Pradeep Halebeedu Prakash\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ_vbVJvzy7TnJFzk1GgQ2bwM1-N2K5BnHUhfPw4x-TZ9y6Xw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,null,null,null,null,1],[\"dfcbf5a6-398e-46c4-8136-37683e7c2a41\",[\"Kirby Coja\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI-ocb7VNaqyAyfPYxZGUSkOH0m6ARqvPCueQuA1BcWXWLxjg\\u003dmo\"]]],1,null,\"Keeps on freezing.\",[1730593897,108000000],0,[\"Standard Chartered Bank PLC\",\"Hi kirby coja, we apologize for the inconvenience caused. As we need more information to understand and follow up on your case, please login to online banking, tap the icon of Stacy, our virtual assistance at the bottom right corner of the page and connect with our live agent. We will try our best to assist you to solve the issue. ~ Carl\",[1730704587,317000000]],null,[\"101268484015505730123\",\"Kirby Coja\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI-ocb7VNaqyAyfPYxZGUSkOH0m6ARqvPCueQuA1BcWXWLxjg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.6\",null,null,null,null,null,1],[\"983d9605-694a-4734-87da-77cf572f22e1\",[\"kennex Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWU6YyX5cL7lpaDXKsleeLgJeFwme6YIzM6BmqW-W3DYefIEnIJ\"]]],1,null,\"Push people to set up some key before using it.\",[1729147044,220000000],0,[\"Standard Chartered Bank PLC\",\"Hello kennex Chan, sorry for any inconvenience caused. SC Mobile Key is a virtual security token in 6 digits, which adds an extra layer of protection for our client. Client input SC Mobile Key for authenticating login and banking transactions to prevent account from being fraudulently used. Thank you for your understanding and support. ~ Danny\",[1729244805,930000000]],null,[\"107122694545023516194\",\"kennex Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWU6YyX5cL7lpaDXKsleeLgJeFwme6YIzM6BmqW-W3DYefIEnIJ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.3\",null,null,null,null,null,1],[\"b13bc666-78a6-4111-99c9-e4d00bf390aa\",[\"Sam Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVoVsAEfZk41fwH4pBiG3-p4-AcEdRgvVpjCqAdOpH7l_k8HzZc\"]]],3,null,\"Please support the use of password manager, like Bitwarden, don't do stupid design trick on the password input box, you are just promoting weak password that way.\",[1728654545,755000000],1,[\"Standard Chartered Bank PLC\",\"Hi Sam Wong, thank you for your valuable feedback. This is a security measure for protecting our customers and provide them with the safest digital banking experience. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Sara\",[1729070957,214000000]],null,[\"103994691685219285374\",\"Sam Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVoVsAEfZk41fwH4pBiG3-p4-AcEdRgvVpjCqAdOpH7l_k8HzZc\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.3\",null,null,null,null,null,1],[\"abdca580-dfed-488f-90ec-48e32f128f2a\",[\"Ryuya Lau\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVwW77mcW6N15KQ1XtAt7ouFZ4yA-ZU5ShQmnA4pE5oT_DSg5O6fw\"]]],2,null,\"The new update is great and easy to use, with useful new features. However, disabling screenshots is very inconvenient. It’s frustrating not being able to capture transactions to prove payments. Their FAQ suggests taking screenshots of SMS or email notifications, but this is impractical and captures other transactions too. HSBC’s app also disables screenshots, but they allow it after a transaction is completed. HSBC’s approach is better.\",[1728448671,602000000],6,[\"Standard Chartered Bank PLC\",\"Hi Ryuya Lau, thank you for your valuable feedback. With the rise of malware related incidents, our bank has increased its security controls to protect customers and provide the safest digital banking experience. We're continuously working to strike a balance between security and user experience.~ Wes\",[1728532630,878000000]],null,[\"117855936350098604696\",\"Ryuya Lau\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVwW77mcW6N15KQ1XtAt7ouFZ4yA-ZU5ShQmnA4pE5oT_DSg5O6fw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.3\",null,null,null,null,null,1],[\"cbb33d28-b2aa-47d5-bc72-c247af744455\",[\"Nick C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVCc-d4_3hGF2m60be7EC8fFwKkJ4GTgIt42mLCxmsbYvb69rUBSw\"]]],1,null,\"Please improve the screen capture / sharing function for FPS/ payment transfer, the current GIF animation is looking stupid, unprofessiibal and missing the details.\",[1728378797,911000000],1,[\"Standard Chartered Bank PLC\",\"Hi Nick C, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Carl\",[1728459511,350000000]],null,[\"115230906600265938765\",\"Nick C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVCc-d4_3hGF2m60be7EC8fFwKkJ4GTgIt42mLCxmsbYvb69rUBSw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.3\",null,null,null,null,null,1],[\"9abc6bb7-de48-49bb-8cd8-a3fc66bc8273\",[\"Arlik Kwong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV3XG-pkA9nGg6Wg14vQ1PQDi-KUztSdGvxvtorf0n0Gvd-Dvk6\"]]],1,null,\"it just keep stop working edit: online banking need the app to approve login, and the app is dead ...\",[1728285807,427000000],0,[\"Standard Chartered Bank PLC\",\"Hi Arlik Kwong, we apologize for the inconvenience caused. As we need more information to understand and follow up on your case, please login to online banking, tap the icon of Stacy, our virtual assistance at the bottom right corner of the page. We will try our best to assist you to solve the issue. ~ Danny\",[1728285271,923000000]],null,[\"103330331611561935991\",\"Arlik Kwong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV3XG-pkA9nGg6Wg14vQ1PQDi-KUztSdGvxvtorf0n0Gvd-Dvk6\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.3\",null,null,null,[true,false],null,1],[\"a0f42739-7b30-4c9e-b276-526a7fa84750\",[\"Tornado\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVEw8XegPfPOGaDNIR-YvDh-iUi0hbIVBcIW9258CRBBfrDfTO8EQ\"]]],1,null,\"Rubbish apps\",[1728087433,802000000],1,[\"Standard Chartered Bank PLC\",\"Hi Tornado, we apologize for the inconvenience caused. If you need assist, please login to online banking, tap the icon of Stacy at the bottom right corner of the page, login to the latest version of SC Mobile and tap “Contact \\u0026 Support” at the top right corner to connect with our live agent. We will try our best to assist you. ~ Danny\",[1728285180,456000000]],null,[\"112883072186299063998\",\"Tornado\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVEw8XegPfPOGaDNIR-YvDh-iUi0hbIVBcIW9258CRBBfrDfTO8EQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.3\",null,null,null,null,null,1]],[null,\"CtIBIskBAV8d1P3oPs8pCZdTgI6aWm3cEm2spdzlbpAcrBswHefrM6__WBcpHeggyLRXw29_wGxsh9N3G9epM5AHGtmKhvz6fBvubqDb_BlnmFE3bKxRsESr4M-5TXpEGuN950ovYAu-vYlawk4AMvuLZnQq4H10kLgaaQQMDanc2dnwrG7iDaKiUmbQ2YfQXrAT06YvC9prxDeUNmVzFIfKOQz5ZHvzC_TF6mZ4B9e-KQUTDeilybzqGHINtGRjozds3n9IS5_eJUYTViMKKKKW19YG\"],[[null,[[1800],null,[72000]]]]]",null,null,null,"generic"],["di",200],["af.httprm",199,"2563352613985853846",1]]