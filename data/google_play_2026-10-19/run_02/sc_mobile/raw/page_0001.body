)]}'

[["wrb.fr","oCPfdb","[[[\"5f83fbbc-a93d-4d43-93df-941558309c64\",[\"Patrick Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI01SPnERM5mP_dm5HveXXMN8t8_08BWnOUvKWz9K4PzMnZwQ\\u003dmo\"]]],1,null,\"the app force closed unexpectedly after the update, can't even manage anything. please fix ASAP\",[1792113903,195000000],0,null,null,[\"114927760217803196660\",\"Patrick Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI01SPnERM5mP_dm5HveXXMN8t8_08BWnOUvKWz9K4PzMnZwQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"59e741ca-f459-479c-a6e7-d1152ba6908e\",[\"Ricky Kam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKEIqQCJadT9DuPRdXDDWUAwgz2fVu8sYmNUrdu90XHTWIA5g\\u003dmo\"]]],1,null,\"Crashing after latest update\",[1791888302,145000000],0,[\"Standard Chartered Bank PLC\",\"Hello Ricky Kam, we apologize for the inconvenienced caused. As we need more information to understand and follow up on your case, you can visit our website: www.sc.com/hk/ and tap the icon of Stacy, our virtual assistance in the bottom right corner of the page, to connect with our live agent. We will our best to assist you. Thank you. ~ Danny\",[1791970754,970000000]],null,[\"105688826225803212812\",\"Ricky Kam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKEIqQCJadT9DuPRdXDDWUAwgz2fVu8sYmNUrdu90XHTWIA5g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_battery_heat\",[3]],[\"vaf_app_quality_battery_efficiency\",[3]]]],null,null,null,1],[\"27c5537b-bc12-444e-9c7e-14a6a86d832b\",[\"NY LO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWanbTO4_6950HZGMZ8I9Tfqq3-3OgUbbOgXm4EICCivuKBuvA\"]]],1,null,\"Terrible, let me use website and detach from the app. Even the enq call said you can, but NOOOOOOOOO. U CAN'T. i hate the app. Btw, if your call hv a separated selection called credit card of online system/mobile app (or what) on enq call, please don't say you can't see/you don't know what's capable of and struggling with. Please test your staff about their work content before they work with human. Sigh\",[1790834797,279000000],0,[\"Standard Chartered Bank PLC\",\"Hello NY LO, sorry for the inconvenience caused. SC Mobile Key has replaced SMS one time passcode. You are required to authenticate online banking login through SC Mobile. This helps enhance security by performing the authentication directly on your registered device, reducing the risk of SMS interception. Thank you for your understanding. ~ Wes\",[1791285493,288000000]],null,[\"105435748952479685193\",\"NY LO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWanbTO4_6950HZGMZ8I9Tfqq3-3OgUbbOgXm4EICCivuKBuvA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_app_quality_battery_efficiency\",[1]],[\"vaf_app_quality_ads_presence\",[2]],[\"vaf_app_quality_performance\",[2]]]],null,null,null,1],[\"9b28a0a6-a723-4347-bbd3-6ceb6e7cf95f\",[\"Tentertain Tsz\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIaBKVV7gQevxE2BLEkFM1SF_1rpiFm9yppKofge7nMsi9UTg\\u003dmo\"]]],3,null,\"突然話我指模認證唔成功，入極都入唔到 28 sep 2026: 前幾日仍然有發生\",[1790528159,285000000],0,[\"Standard Chartered Bank PLC\",\"你好Tentertain Tsz，很抱歉未能為你帶來滿意的SC Mobile 使用體驗，如問題仍未解決，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1790243825,782000000]],null,[\"113853208017849144901\",\"Tentertain Tsz\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIaBKVV7gQevxE2BLEkFM1SF_1rpiFm9yppKofge7nMsi9UTg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"2742140c-bb8e-4eef-a4dd-1af6544ed6a1\",[\"SUMN MEHRA\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjViJBkcybgfoxdZtgv9n8wG0LRa9gtlE_x1AWw2rd9oDLTzBPw\"]]],5,null,\"easy to use thanks\",[1790517051,456000000],0,[\"Standard Chartered Bank PLC\",\"Hi SUMN MEHRA, thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Danny\",[1791279112,278000000]],null,[\"117740526709212475808\",\"SUMN MEHRA\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjViJBkcybgfoxdZtgv9n8wG0LRa9gtlE_x1AWw2rd9oDLTzBPw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"6afe152f-7cc5-4b44-9de8-45e7bb29b181\",[\"Keung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIyFcOmycrQPyk816PkxVcQNVY6TCnL7rZOrwSz2HVVYCkEcw\\u003dmo\"]]],5,null,\"easy as pie !\",[1790048131,733000000],0,[\"Standard Chartered Bank PLC\",\"Hello Keung, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future and your continuous support. ~ Danny\",[1790933369,82000000]],null,[\"115212236947067890617\",\"Keung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIyFcOmycrQPyk816PkxVcQNVY6TCnL7rZOrwSz2HVVYCkEcw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"386912f6-16ac-450e-bea1-2f5b625a7be7\",[\"Alex\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXHBAAiJYcZnD41pEgc0_YYS8XoThKnvSs47ywmI6X5QYcDqxKV\"]]],1,null,\"crash immediately when login, I am guessing the code are doing some weird OS check before starting. Maybe it is because i am using a custom ROM and then the code are unable to identify the OS. You should try to have a default that could work without checking the OS\",[1790048092,77000000],0,[\"Standard Chartered Bank PLC\",\"Hi Alex, sorry for any inconvenience caused. We need more information to understand and follow up on your case, please tap the icon of Stacy in website: sc.com/hk/, and select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to contact our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1789970156,503000000]],null,[\"112452330240359294342\",\"Alex\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXHBAAiJYcZnD41pEgc0_YYS8XoThKnvSs47ywmI6X5QYcDqxKV\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,[true,false],null,1],[\"bdb2455e-2ed2-4672-8dd3-8c24f1116257\",[\"Lam Tran\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW-56ggrDya46D57UC2gIxJYx8AwUr8jVDoYR8y2a2MA-gouYDqew\"]]],1,null,\"I cant never receive the authentication for my credit card - notification is sent to say I can click on it to approve the transaction, but when I click on the notification, it redirect me to the app, and nothing is there. Sometimes it shows approve button, but hours after the transaction is made. Why can't you just provide the OTP in notification for authentication?\",[1790037215,236000000],0,[\"Standard Chartered Bank PLC\",\"Hello Lam Tran, we apologize for the inconvenienced caused and this is not our expected experience. As we need more information to understand and follow up on your case, please login to the SC Mobile App and tap “Contact \\u0026 Support” at the top right corner to connect with our live agent. We will try our best to solve the issue. ~ Danny\",[1790933633,78000000]],null,[\"113171988046907803189\",\"Lam Tran\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW-56ggrDya46D57UC2gIxJYx8AwUr8jVDoYR8y2a2MA-gouYDqew\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"dd65efa9-8084-4b36-ab56-a7b892ab2ac6\",[\"Ben Cheng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKVhcvymy_coP_xW5_-6msF32ajiEMlWqRydb0tyDjwmXICSw\\u003dmo\"]]],1,null,\"I have already updated the app but your app keeps crashing, please fix it.\",[1789947556,91000000],0,[\"Standard Chartered Bank PLC\",\"Hi Ben Cheng, sorry for the inconvenience. To investigate the SC Mobile crashing issue, please visit sc.com/hk, tap Stacy and type \\\"SC Mobile crashing issue\\\" to connect with a live agent. Please provide the issue date/time, device model and SC Mobile version. We will try our best to resolve the issue you encounter. ~ Carl\",[1790312136,966000000]],null,[\"103261394886987973183\",\"Ben Cheng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKVhcvymy_coP_xW5_-6msF32ajiEMlWqRydb0tyDjwmXICSw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,[true,false],null,1],[\"0b5e720f-575c-4136-a614-57eb04811435\",[\"Sunshine Pon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLvXEz-xVCV6zcvPU8CXAJ9qOIAGB5G4IpqF1Bpsh_-0HTaMw\\u003dmo\"]]],2,null,\"apps layout is so messy, not easy to find a simple function key, too much investment information and repeatedly everywhere, much helpful if its separate into few areas for banking, investment and others\",[1789531756,185000000],0,[\"Standard Chartered Bank PLC\",\"Hello Sunshine Pon, we appreciate you taking the time to share your experience with SC Mobile and will continuously enhance and optimize SC Mobile to provide a more intuitive and seamless user experience for our clients. Thank you for your valuable feedback. ~ Wes\",[1790242951,832000000]],null,[\"109290571611356838473\",\"Sunshine Pon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLvXEz-xVCV6zcvPU8CXAJ9qOIAGB5G4IpqF1Bpsh_-0HTaMw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.0\",null,null,null,null,null,1],[\"8c8cb6ef-7b68-4dcb-b5db-e82ba3d7eef1\",[\"MIKE JACKMAN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjXS4nLyH5kbJmWEsuAn20dk1GD8kbYPNSW0U3jlRd7WIO6Q\\u003dmo\"]]],5,null,\"good service!\",[1789303752,693000000],0,[\"Standard Chartered Bank PLC\",\"Hello MIKE JACKMAN, thank you for your 5 stars rating. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Wes\",[1790226476,494000000]],null,[\"113292481328374980330\",\"MIKE JACKMAN\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjXS4nLyH5kbJmWEsuAn20dk1GD8kbYPNSW0U3jlRd7WIO6Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,null,null,null,null,1],[\"c0f2f983-03fe-4efb-a50d-d99e74e4232e\",[\"Jeffrey Wong TL\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLObKaQJjA_YralPOvgyPIT9-j1_qkbanNzQBxo_fDaCknVzW0\\u003dmo\"]]],2,null,\"The app is so slow and it requires log in every time due to inactivity, also this app does not allow screenshot, which causes extreme inconvenience!! 😡😤\",[1789295052,859000000],0,[\"Standard Chartered Bank PLC\",\"Hi Jeffrey Wong TL, sorry for the inconvenience caused. The screencap restriction is a security control to protect our customers and provide them with safer digital banking experience. We will continue to optimize SC Mobile to provide better user experience. We look forward to obtaining your kindly understanding. ~ Danny\",[1790243452,976000000]],null,[\"105002675750896610880\",\"Jeffrey Wong TL\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLObKaQJjA_YralPOvgyPIT9-j1_qkbanNzQBxo_fDaCknVzW0\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,null,null,[true,false],null,1],[\"e2ea8bc6-bcac-4ced-a98c-e2a421f73cc8\",[\"Henry Sin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIRE5rwtDJRnCaLjf28oT873wIBY_T-lRgVAEOKBTvHY8kL-Q\\u003dmo\"]]],5,null,\"perfect presentation\",[1789018398,314000000],0,[\"Standard Chartered Bank PLC\",\"Hi Henry Sin, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to provide you with quality services in the future and your continuous support. ~ Danny\",[1789970188,46000000]],null,[\"116932951031408839958\",\"Henry Sin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIRE5rwtDJRnCaLjf28oT873wIBY_T-lRgVAEOKBTvHY8kL-Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,[[[\"vaf_app_quality_ads_frequency\",[1]],[\"vaf_app_quality_performance\",[1]],[\"vaf_app_quality_battery_heat\",[2]]]],null,null,null,1],[\"2ced29b2-83ec-487c-8ba1-05d925262b2a\",[\"Papu Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLTWnlNIQ5A2ckEDC89kE45_i_2ysWJGt6j4kVSaH5aBKstwg\\u003dmo\"]]],5,null,\"open my account\",[1788652683,285000000],0,[\"Standard Chartered Bank PLC\",\"Hi Papu Chan, thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Danny\",[1789635840,251000000]],null,[\"104379562294346938276\",\"Papu Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLTWnlNIQ5A2ckEDC89kE45_i_2ysWJGt6j4kVSaH5aBKstwg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,[[[\"vaf_app_quality_battery_efficiency\",[3]],[\"vaf_app_quality_performance\",[1]],[\"vaf_app_quality_visual_appeal\",[1]]]],null,null,null,1],[\"89f6472a-4f30-48d3-844e-c87b0524dcf8\",[\"Hanson So\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL05HtnQHEAZPaygNdv7hnzE7y-_yA-3sps6-58uafdZlQbgg\\u003dmo\"]]],1,null,\"always delay, message hanging, and fail to connect\",[1788434246,324000000],0,[\"Standard Chartered Bank PLC\",\"Hi Hanson So, sorry for any inconvenience caused. We need more information to understand and follow up on your case, please tap the icon of Stacy in website: sc.com/hk/, and select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to contact our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1789112308,307000000]],null,[\"100231211133284874023\",\"Hanson So\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL05HtnQHEAZPaygNdv7hnzE7y-_yA-3sps6-58uafdZlQbgg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,null,null,null,null,1],[\"a1055324-2fa4-4a96-b1e5-6f8d3ab215dc\",[\"Isaac Choi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXpSxWFerZgZKB8GIDvTQe7XmRQZfSDAUl83uLC9Wl0UBkmI-lv\"]]],5,null,\"Chat service is broken...\",[1788429087,818000000],0,[\"Standard Chartered Bank PLC\",\"Hello Isaac Choi, sorry for the inconvenience caused. For your mentioned issue, please update the SC Mobile app to the latest version 7.17.0. If the issue persists, please tap the icon of Stacy in website: sc.com/hk/ to contact our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1788418762,633000000]],null,[\"114003445294431419207\",\"Isaac Choi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXpSxWFerZgZKB8GIDvTQe7XmRQZfSDAUl83uLC9Wl0UBkmI-lv\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,null,null,[true,false],null,1],[\"39461f6d-8c28-4666-9f91-41bde43f8946\",[\"Arta Tse\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJcGju71TZo5opmtMU1RNx0soYCrMgYRfv2ZgosEQ6vojrfcMQ\\u003dmo\"]]],5,null,\"excellent App\",[1788399573,657000000],0,[\"Standard Chartered Bank PLC\",\"Hi Arta Tse, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to provide you with quality services in the future and your continuous support. ~ Danny\",[1789108809,340000000]],null,[\"103460704185129512206\",\"Arta Tse\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJcGju71TZo5opmtMU1RNx0soYCrMgYRfv2ZgosEQ6vojrfcMQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"35c7508b-1b84-45a2-969f-e66ca7fe0a3d\",[\"James Brownell\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJews3R7Hbjj4IwpApo-lAMzOUE2tUzjONXi34C-f-jBSa7dg\\u003dmo\"]]],1,null,\"Many bugs. Frozen loops. Poor design, missing menus. Just awful.\",[1788154088,740000000],0,[\"Standard Chartered Bank PLC\",\"Hello James Brownell, sorry for any inconvenience caused. Please check and install the latest version 7.17 to ensure the best user experience. Should you need further assistance, please visit our official website: sc.com/hk , tap the icon of Stacy, in the bottom right corner of the page, to connect with our live agent. Thank you. ~ Wes\",[1788410865,309000000]],null,[\"109059004031770924501\",\"James Brownell\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJews3R7Hbjj4IwpApo-lAMzOUE2tUzjONXi34C-f-jBSa7dg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,[[[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]],[\"vaf_app_quality_ads_presence\",[2]]]],null,null,null,1],[\"78bd888c-e308-4064-8663-83bcac98f6e6\",[\"Benton Ray\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJT2aQOClxbYYTJ7MK_M5-yfO7SHYfTC7Z83DCd--yBAbpsLg\\u003dmo\"]]],1,null,\"This app has been crashing instantly on opening the app for weeks now. Unable to access any functions. Unacceptable for an app as important as a banking app. No fixes for weeks and weeks. No apparent path to fix the problem. Considering switching banks entirely just in order to have basic functionality. On Android 16.\",[1787540037,970000000],4,[\"Standard Chartered Bank PLC\",\"Hi Benton Ray, sorry for any inconvenience caused. We need more information to understand and follow up on your case, please tap the icon of Stacy in website: sc.com/hk/, and select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to contact our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1787898934,858000000]],null,[\"111529163348000430297\",\"Benton Ray\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJT2aQOClxbYYTJ7MK_M5-yfO7SHYfTC7Z83DCd--yBAbpsLg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"d564c9c3-d9b6-4c0b-8397-98ed206bb022\",[\"Endou Cheeray\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWuuW-NgoNZlGY24hdqKbThhfKkf4PEdmUaL34D5a4hbAeqDCE\"]]],1,null,\"error code #1001, can't log in\",[1787290513,71000000],1,[\"Standard Chartered Bank PLC\",\"Hi Endou Cheeray, sorry for any inconvenience caused. We need more information to understand and follow up on your case, please tap the icon of Stacy in website: sc.com/hk/, and select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to contact our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1787891166,443000000]],null,[\"104578466529555658499\",\"Endou Cheeray\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWuuW-NgoNZlGY24hdqKbThhfKkf4PEdmUaL34D5a4hbAeqDCE\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"04be1a9a-b1f1-4f30-a402-a0a5c3b4a352\",[\"Fenix Lai\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWmhw26k6nsI3YXXokqEj3S36xoXmekKWBMFC6tiHAtGO4Xe2U2sA\"]]],1,null,\"I've been unable to use the live chat service via app or web for more than 2 weeks. CS confirmed to me that it is a widespread issue while the problem is still yet to be resolved... Could you guys at least give us an expected time for the fix?\",[1786617921,162000000],1,[\"Standard Chartered Bank PLC\",\"Hi Fenix Lai, sorry for the inconvenience caused. You can try logging in to SC Mobile and tapping the “Chat” on main screen to contact our live agent.\\nIf the issue persists, please tap the icon of Stacy in our website: sc.com/hk to connect with our live agent. We will try our best to assist you to solve the issue. Thank you. ~ Danny\",[1787295317,595000000]],null,[\"116914773296199538111\",\"Fenix Lai\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWmhw26k6nsI3YXXokqEj3S36xoXmekKWBMFC6tiHAtGO4Xe2U2sA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"4ea93b8b-7445-4af8-87d5-0015f4a34262\",[\"David Ji\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV8Ccr3-QG08d9vFSPY6DE5pBmtd65pp_C_VcoChBjRm6zSUvq0Zg\"]]],1,null,\"Unstable, log out by itself while you are using it from time to time, which is fatal for banking operations! Notification by text message is slow some times delays by 10 minutes. Some of the buttons are touchy.\",[1786587951,574000000],3,[\"Standard Chartered Bank PLC\",\"Hi David Ji, sorry for any inconvenience caused. As this is a third party platform and we need more information to understand and follow up on your case, please tap the icon of Stacy in our website : www.sc.com/hk to connect with our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1787294966,590000000]],null,[\"102928328535375375738\",\"David Ji\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV8Ccr3-QG08d9vFSPY6DE5pBmtd65pp_C_VcoChBjRm6zSUvq0Zg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_usability\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[2]]]],null,[true,false],null,1],[\"abc6c247-d04e-4f9e-9e3b-061d6132bbca\",[\"Jezer Goh\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIy9YzH61xA6UMguxwiB0ndbgjPEFR84AkVdiNw-aFxUdtb_DIj\\u003dmo\"]]],1,null,\"worst app ever. often even logging in causes the app to become unresponsive, much less trying to do anything substantive. update: worst experience even when it works. chatted with a live agent. right after keying in my query it says the chat system is down. but I'm still getting notifications that the agent has replied. just that i can't access the chat system. I'd give it a zero if i could.\",[1786332992,399000000],6,[\"Standard Chartered Bank PLC\",\"Hello Jezer Goh, sorry for the inconvenience caused. For your mentioned issue, please update the SC Mobile app to the latest version 7.14.0. If the issue persists, please contact our live agent in SC Mobile app for assistance. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Sara\",[1781172128,605000000]],null,[\"107646559534064507836\",\"Jezer Goh\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIy9YzH61xA6UMguxwiB0ndbgjPEFR84AkVdiNw-aFxUdtb_DIj\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,[true,false],null,1],[\"d3527734-b381-492f-87fe-9973d1ecf1e8\",[\"Be C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUvvGZ4k2xe5mPDIw1XUVeYbq3tCYhBvyM4tB67yCjxaMti-f3Ahw\"]]],1,null,\"Marathon saving account has no info about when start , when end, interest rate for different period, why not follow your son (Mox bank app has detailed info for their flex boost saving account) Account title still cannot show all characters. Integrated deposits acc.... Integrated despairs acc.... there is no means to differentiate btw saving account and current account. App UI still buggy, when Marathon account balance is 0, it shows \\\"Add Money\\\" button,\",[1785866980,108000000],0,[\"Standard Chartered Bank PLC\",\"Hello Be C, for Marathon Savings Account (MSA), the bonus period and interest rates for different tenors are shown during application, and an email confirmation clearly states the bonus period and interest rate after MSA opening. We will continue to optimize to provide a better experience. Thank you for taking the time to share your feedback. ~ Wes\",[1786512842,681000000]],null,[\"113279167246872333383\",\"Be C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUvvGZ4k2xe5mPDIw1XUVeYbq3tCYhBvyM4tB67yCjxaMti-f3Ahw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,[true,false],null,1],[\"1b05c693-a8f9-4efb-804b-503182282d87\",[\"Doubraska García\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUP9V9_itlkRsGXQN_hkW7jQCyZJNxuCVSbCDcik74ig7JObOk\"]]],1,null,\"it's been impossible to use the past days, after deleting and reinstalling the app won't even open\",[1785814125,783000000],0,[\"Standard Chartered Bank PLC\",\"Hello Doubraska García, we are sorry to hear your unpleasant user experience. We need more information to understand and follow up on your case, please visit our official website: sc.com/hk, tap the icon of Stacy, in the bottom right corner of the page to connect with our live agent to further assist and follow up your case. Thank you. ~ Wes\",[1786094864,187000000]],null,[\"104822852836469360177\",\"Doubraska García\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUP9V9_itlkRsGXQN_hkW7jQCyZJNxuCVSbCDcik74ig7JObOk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_ads_intrusiveness\",[1]],[\"vaf_app_quality_performance\",[2]]]],null,[true,false],null,1],[\"0138ecc5-a86e-4704-88d4-c0a08a97a6e8\",[\"Bryan Chu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWDKHO13PGNlf4xHlASPCEQJBzjC-qtcvmo31awhlam1y0nDSbHDg\"]]],1,null,\"wow the statements service is down on Sunday. its 2026 fellas\",[1785661601,291000000],1,[\"Standard Chartered Bank PLC\",\"Hello Bryan Chu, sorry for any inconvenience caused. E-statement services is in normal operation now. Please try again. Should you need further assistance, please go to “Contact \\u0026 Support”, tap “Chat” to connect with our online customer service representative and provide more details for investigation. Thank you. ~ Wes\",[1786082030,994000000]],null,[\"108622226474571413663\",\"Bryan Chu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWDKHO13PGNlf4xHlASPCEQJBzjC-qtcvmo31awhlam1y0nDSbHDg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.1\",null,null,null,null,null,1],[\"d552543e-b23e-464c-b675-33fcf28ebe4e\",[\"Septi Dahlia\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocId9a6sJzaTTS5UYs45nDmPc83TV0rGtqw0poM492tIQq4koQ\\u003dmo\"]]],5,null,\"good\",[1784347436,860000000],0,[\"Standard Chartered Bank PLC\",\"Hello Septi Dahlia, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Danny\",[1785289478,695000000]],null,[\"114877577164531966593\",\"Septi Dahlia\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocId9a6sJzaTTS5UYs45nDmPc83TV0rGtqw0poM492tIQq4koQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,null,null,1],[\"3bee3a75-bc9d-47b6-8b6d-b00ecb6f5f53\",[\"chan chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIvcJa3_0qFEFw0Q5eOyAqsSB62k8ukmyhKGMysi0Cgbhsgiw\\u003dmo\"]]],1,null,\"disappointing . every time I log in to the app, it request me to setup biometric authentication and freezing\",[1784279439,467000000],0,null,null,[\"114863463942036271833\",\"chan chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIvcJa3_0qFEFw0Q5eOyAqsSB62k8ukmyhKGMysi0Cgbhsgiw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,[true,false],null,1],[\"ac9da198-b6ef-44f6-b57b-bf36ec895b13\",[\"Jasmine Wu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXLyV5UuflBlmqQoen6dBCUR4ZvzFoEtgZuekMiiKKh5sgqr598sQ\"]]],1,null,\"it keeps wiping my token very often. I had to repeatedly reset the biometric token on the phone and it keeps saying it cannot be set up again and I have to wait! I had waited a full day and still not working. This has got to be a joke! I need this for work and this is seriously disrupting!\",[1783954280,138000000],1,[\"Standard Chartered Bank PLC\",\"Hi Jasmine Wu, we apologize for the inconvenienced caused and this is not our expected flow. As we need more information to follow up on your case, you can visit our website : https://www.sc.com/hk/ and tap the icon of Stacy, our virtual assistance in the bottom right corner of the page. We will our best to assist you. Thank you. ~ Carl\",[1773829217,780000000]],null,[\"102293483857923225885\",\"Jasmine Wu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXLyV5UuflBlmqQoen6dBCUR4ZvzFoEtgZuekMiiKKh5sgqr598sQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,[true,false],null,1],[\"6a342565-357f-4fcb-8a6c-c68076249d9c\",[\"WK LAM\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJm2hoannjCPYzzxDzp2gTdlvz6CP0EhFKwqgi7o6PcI43svw\\u003dmo\"]]],1,null,\"This app does not allow messages to be sent. problem not able to be solved as not able to contact staff via this app\",[1783423505,969000000],0,null,null,[\"101344278656699653531\",\"WK LAM\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJm2hoannjCPYzzxDzp2gTdlvz6CP0EhFKwqgi7o6PcI43svw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,null,null,1],[\"064600a6-cccc-4192-9ba0-ff51c71115fb\",[\"Kevin Chung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKYTF-EQdN2XX5_2kvkY5kkEOoLw6fVOIYfqIkgb3dbEHTGFA\\u003dmo\"]]],1,null,\"Foreign Exchange Alert has been in a terrible mess these days (problem persist as of 1Jul2026), the alert list keep reloading indefinitely, showing some and disappearing some alerts, it's impossible to add alert / modify / delete alert properly. e-Ticketing. . . the \\\"Current Ticket\\\" showing on phone is actually the \\\"Next Ticket\\\" in branch screen. Have your developers ever visited the branch to see such misalignment? The latest app version 7.15.0\",[1782893528,636000000],1,[\"Standard Chartered Bank PLC\",\"你好Kevin，如未能經外匯交易平台進行外匯買賣，都可以使用「轉賬」進行「我的戶口」間轉賬。~ Vichy\",[1657071006,374000000]],null,[\"104412547103959614260\",\"Kevin Chung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKYTF-EQdN2XX5_2kvkY5kkEOoLw6fVOIYfqIkgb3dbEHTGFA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,[true,false],null,1],[\"9416c2d0-8971-4d4b-8b42-a2cbd095ec47\",[\"Piyush Kapaley\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLLDJWZzvzXRefRob0OY9BDj8J6FAPYIqpCaVwKANiImO5KmA\\u003dmo\"]]],1,null,\"Extremely unintuitive. Bad for card management. Should learn a thing or two from Mox. Edit: Extremely painful to pay without the card, everytime a transaction needs to be authenticated you need to log in and when you log in the approval request is gone. Horrific. Wish I could give 0 stars.\",[1782885937,903000000],2,[\"Standard Chartered Bank PLC\",\"Hi Piyush Kapaley, thank you for your feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Sara\",[1763364302,674000000]],null,[\"100699362274016182876\",\"Piyush Kapaley\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLLDJWZzvzXRefRob0OY9BDj8J6FAPYIqpCaVwKANiImO5KmA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,[true,false],null,1],[\"e4f7d5f3-d0d0-4261-87e2-0d32ed108b54\",[\"Blok Mieszkalny\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIqU2hOSOzoV9YvxT0AFvpsJHaf7yf2aLYQnmQbMu_RsYrZRQ\\u003dmo\"]]],1,null,\"Detects root. Bank's offer isn't that great in the first place, will close my account.\",[1782710112,816000000],1,[\"Standard Chartered Bank PLC\",\"Hello Blok Mieszkalny, as a hacked device is more susceptible to the risks of fraudulent transactions. To protect your interests, your SC Mobile will be suspended when your mobile device is detected to have been compromised. To ensure the safety of your account and personal information, please use a “clean” device to log in to SC Mobile. ~ Wes\",[1783507653,668000000]],null,[\"118437168457457402868\",\"Blok Mieszkalny\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIqU2hOSOzoV9YvxT0AFvpsJHaf7yf2aLYQnmQbMu_RsYrZRQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.15.0\",null,null,null,null,null,1],[\"417b305e-250d-485f-81fc-a85da5b38738\",[\"Jacky C. (滑鐵豪)\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKrfpnNGH77GmbzgzOzkC4OkCfqYGYeSa826CC8vlKekQQZ0g\\u003dmo\"]]],4,null,\"I would like to watch the password what I type\",[1781935772,775000000],0,[\"Standard Chartered Bank PLC\",\"Hello Jacky C. (滑鐵豪), sorry for the inconvenience caused. As a security measure, when client enter the password, the system will hide the password and show as asterisk symbol. We look forward to your continuous support. Thank you. ~ Danny\",[1782985516,94000000]],null,[\"114739846116345835286\",\"Jacky C. (滑鐵豪)\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKrfpnNGH77GmbzgzOzkC4OkCfqYGYeSa826CC8vlKekQQZ0g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.14.0\",null,null,null,null,null,1],[\"52589fab-67f3-42f1-bee3-8e53c1c43872\",[\"Ka Chun Kwok\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUqOqFDQZ-eizKkCM-ew52RUi3GwNqbfcFHlToa37xeaHyivWMs\"]]],2,null,\"跟來用唔到生物認證，啟動完一次每次都要重新啟動，每次都load 勁耐\",[1781344386,957000000],0,[\"Standard Chartered Bank PLC\",\"你好Ka Chun Kwok，抱歉為你帶來不便，關於你提及未能使用生物認證的問題。請你更新SC Mobile App到最新版本的7.15.0後再嘗試。如你需要進一步協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。~ Sara\",[1782122498,627000000]],null,[\"115634207408004981308\",\"Ka Chun Kwok\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUqOqFDQZ-eizKkCM-ew52RUi3GwNqbfcFHlToa37xeaHyivWMs\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.14.0\",null,null,null,null,null,1],[\"57e63e10-c42c-4a8c-a2d4-7adb98257119\",[\"Walan Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJLJIy8RUwofA7JTgBUUuNyMzmWZGUE4wwKDGrixebsQubbNXvF\\u003dmo\"]]],1,null,\"buggy app\",[1781340088,712000000],0,[\"Standard Chartered Bank PLC\",\"Hello Walan Wong, sorry for any inconvenience caused. Please check and install the latest version 7.15.0 to ensure the best user experience. Should you need further assistance, please go to “Contact \\u0026 Support”, tap “Chat” to connect with our online customer service representative and provide more case details for investigation. Thank you. ~ Wes\",[1782101743,196000000]],null,[\"101824412876473692847\",\"Walan Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJLJIy8RUwofA7JTgBUUuNyMzmWZGUE4wwKDGrixebsQubbNXvF\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.14.0\",null,[[[\"vaf_app_quality_battery_heat\",[2]],[\"vaf_app_quality_visual_appeal\",[2]],[\"vaf_app_quality_ads_presence\",[2]]]],null,null,null,1],[\"cdc8803d-7621-4241-b38b-8d1acf261958\",[\"Helena Wu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgCYzKwiRZq-J6ZItYTsx2XdxJT1quiLASdAHQ3-jWa3h2UFyo0g\"]]],5,null,\"easy and fast to make a transfer my money to the other bank acc for any payments.\",[1781034336,799000000],0,[\"Standard Chartered Bank PLC\",\"Hi Helena Wu, thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Wes\",[1780913055,326000000]],null,[\"101220699581284952821\",\"Helena Wu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgCYzKwiRZq-J6ZItYTsx2XdxJT1quiLASdAHQ3-jWa3h2UFyo0g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.14.0\",null,null,null,[true,false],null,1],[\"1e45e909-61a6-4878-bff7-e147ac77d536\",[\"candy W\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVhvCVV6luWEOsAEcgbVEvQRn-VgfxjKfujsYu-VB9VP6Jit6w_Bg\"]]],1,null,\"生物認證 load勁耐都未整到 卡又加唔到入Google wallet 唔明咁都宣傳自己係最佳數碼銀行 用其他銀行app都唔會有呢d問題\",[1780991490,600000000],0,[\"Standard Chartered Bank PLC\",\"你好candy W，抱歉為你帶來不便，關於你提及未能加入信用卡到電子錢包。請你更新SC Mobile App到最新版本的7.14.0後再嘗試。如你需要進一步協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。~ Sara\",[1781171541,858000000]],null,[\"105932669174607027667\",\"candy W\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVhvCVV6luWEOsAEcgbVEvQRn-VgfxjKfujsYu-VB9VP6Jit6w_Bg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,[true,false],null,1],[\"b74a3090-9299-4d0d-8b2a-e639b9c9637c\",[\"Fi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX32ZbaZ6mQKVCYya89LuI2AUqWRRoa9qI0uLQpKRsuhBGvNF0hvw\"]]],1,null,\"Locks card on Google pay all of a sudden, and now can't add the card back. when contacing CS team, they keep telling you to take screenshots of the app (which their amazing security restriction does not allow) Or they'll tell you to download an apk from their website instead (not sure how secure that is)\",[1780886223,831000000],1,[\"Standard Chartered Bank PLC\",\"Hello Fi, sorry for the inconvenience caused. For your mentioned issue, please update the SC Mobile app to the latest version 7.14.0. If the issue persists, please contact our live agent in SC Mobile app for assistance. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Sara\",[1781170740,627000000]],null,[\"113994115601961306576\",\"Fi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX32ZbaZ6mQKVCYya89LuI2AUqWRRoa9qI0uLQpKRsuhBGvNF0hvw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"f4e54217-a91f-4a12-8235-55b00e1d3dd7\",[\"Hilary Cheng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVNEhrKndVMzJCphMGe4i82Vk4RWyX9odlbPJlh-wUhkpPpW6jm\"]]],1,null,\"I wanna to top up my Octopus Card from Octopus App to SC mobile. Most of time are not working, after switching into SC Mobile, nothing HAPPENED, No Popup. Just hang there! A rubbish app. always show rubbish Animation\",[1780876416,918000000],0,[\"Standard Chartered Bank PLC\",\"Hello Hilary Cheng, sorry for the inconvenience caused. For your mentioned issue, please update the SC Mobile app to the latest version 7.14.0. If the issue persists, please contact our live agent in SC Mobile app for assistance. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Sara\",[1781170725,212000000]],null,[\"113783599676171698868\",\"Hilary Cheng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVNEhrKndVMzJCphMGe4i82Vk4RWyX9odlbPJlh-wUhkpPpW6jm\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"0da0b45c-5feb-41a7-a070-72d009ff969d\",[\"Ryan Chow\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW9KykJZCoGG5si5tgbfmCX9s39z8sKkhYxEMXU1OJi_IjlDBpyAw\"]]],2,null,\"確認新卡程序需要收 SMS，但當轉過去睇完 SMS 個 code 轉返去銀行 App 會彈咗出去主頁，啱啱個 code 已經無效，輪迴咗三次都輸入唔到個 code 確認唔到新卡。\",[1780390482,291000000],0,[\"Standard Chartered Bank PLC\",\"你好Ryan Chow，抱歉為你帶來不便，有關確認新信用卡問題，我們需要更多資料了解並跟進你的個案，請於登入SC Mobile後點擊右上角的「聯絡及支援」圖示透過智能助理Stacy聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile以帶來更好的用戶體驗，謝謝。 ~ Sara\",[1780913041,682000000]],null,[\"111626508969463311425\",\"Ryan Chow\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW9KykJZCoGG5si5tgbfmCX9s39z8sKkhYxEMXU1OJi_IjlDBpyAw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"5005d954-208d-4d65-ad9f-6374dd326c01\",[\"Fevie Feliciano\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXsdWFxlUqKT1EFPDqoUm17fp6qobW0HxGBV8X304m3150Jy0_e\"]]],5,null,\"more convenient\",[1780386357,528000000],0,[\"Standard Chartered Bank PLC\",\"Hi Fevie Feliciano, thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Sara\",[1780913006,883000000]],null,[\"102947350826344139342\",\"Fevie Feliciano\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXsdWFxlUqKT1EFPDqoUm17fp6qobW0HxGBV8X304m3150Jy0_e\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"ba209924-1546-40d7-ada9-e18e4a45c920\",[\"Jacky Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-GkUSa7hxI-UuU7T1zGWPUI2cLjxR6nbcm0gi1APATR4GQQ\\u003dmo\"]]],1,null,\"adding credit card to Google Wallet doesn't work ... please fix it\",[1780112395,865000000],0,[\"Standard Chartered Bank PLC\",\"Hello Jacky Leung, sorry for the inconvenience caused. For your mentioned issue, please update the SC Mobile app to the latest version 7.14.0. If the issue persists, please contact our live agent in SC Mobile app for assistance. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Sara\",[1780912939,619000000]],null,[\"110072665398664431355\",\"Jacky Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-GkUSa7hxI-UuU7T1zGWPUI2cLjxR6nbcm0gi1APATR4GQQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"ef29e196-1903-4511-92cb-8552a22f847c\",[\"Timothy Takenouchi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUfpNuiTO5T_TXLCchEUguMohEUKsXISOQO8ylg4XK50wYt-M\"]]],1,null,\"Everytime the app auto logged out, if I choose to biologin again on the same page I have to re-register. Contrary force close app then relogin won't trigger this re-register. 1 star. so annoying.\",[1780106630,44000000],0,[\"Standard Chartered Bank PLC\",\"Hello Timothy Takenouchi, sorry for any inconvenience caused. We need more information to understand and follow up on your case, please tap the icon of Stacy, our virtual assistance at the bottom right corner of our website : https://www.sc.com/hk/ to connect with our live agent. We will try our best to assist you to solve the issue. ~ Wes\",[1780914939,848000000]],null,[\"111076467137917195107\",\"Timothy Takenouchi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUfpNuiTO5T_TXLCchEUguMohEUKsXISOQO8ylg4XK50wYt-M\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"a64c9210-ba1f-45d5-bbca-a69f22c70bb2\",[\"Jimmy T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKdTNJHX-6SezcCzUq-yFaHJedFNsUhRxjZdw0oh8WSpJxz8mua\\u003dmo\"]]],1,null,\"Cannot add my card to Google Wallet. Tried doing it through this app as they instructed. Have been getting \\\"Unable to process your request\\\" for WEEKS now. Live chat to their customer service more than five times. Even tried calling up. All they can say is please wait. Thanks. How long is a multi billion dollar bank going to leave a basic functionality broken?\",[1779991912,842000000],1,[\"Standard Chartered Bank PLC\",\"Hello Jimmy T, apologize for the inconvenience caused. For your issue, please update your SC Mobile App to the latest 7.14.0 by APK in sc.com/hk/bank-with-us/app-sc-mobile/apk-download/ and try again. If you need further assistance, you can tap the icon of Stacy, in the bottom right corner of the page to connect with our live agent. ~ Danny\",[1780544466,763000000]],null,[\"109297958024811235807\",\"Jimmy T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKdTNJHX-6SezcCzUq-yFaHJedFNsUhRxjZdw0oh8WSpJxz8mua\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,[[[\"vaf_app_quality_usability\",[2]],[\"vaf_app_quality_battery_heat\",[3]],[\"vaf_app_quality_ads_presence\",[1]]]],null,[true,false],null,1],[\"016e7175-e4d6-4063-9de5-b5691c4667f1\",[\"Tauseef Ahmad\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKH5l_BJ9GKOzGM5FO5LB5SYwfdUIZJeHECZrqfd1CY6C6Yuw\\u003dmo\"]]],5,null,\"v good\",[1779294421,796000000],0,[\"Standard Chartered Bank PLC\",\"Hello Tauseef Ahmad thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Sara\",[1779781566,640000000]],null,[\"104408325402434243938\",\"Tauseef Ahmad\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKH5l_BJ9GKOzGM5FO5LB5SYwfdUIZJeHECZrqfd1CY6C6Yuw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"852e8bd1-768e-4a2f-a7b5-5b132f94933c\",[\"Rene Van Mil\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJCXAOULuabL40UvzPaDtzyiTHWX-rmVY-lkguA1s_F4nNkLw\\u003dmo\"]]],5,null,\"very smooth and easy\",[1778066541,270000000],1,[\"Standard Chartered Bank PLC\",\"Hello Rene Van Mil, thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Wes\",[1778817019,58000000]],null,[\"111038691998492892914\",\"Rene Van Mil\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJCXAOULuabL40UvzPaDtzyiTHWX-rmVY-lkguA1s_F4nNkLw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"4bb94b5d-9521-4e8d-ab7e-4eb58b6ec0ba\",[\"Hln Ho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL6W9NU1wKgo1TYolrr3AeZK8rksYZDl-HZiboEkvJPJVARrw\\u003dmo\"]]],5,null,\"I was not able to transfer USD to my checking account in the same currency recently.\",[1778040181,945000000],1,[\"Standard Chartered Bank PLC\",\"Hello Hln Ho, thank you for your feedback. If you cannot perform “Between My Accounts' transfer in SC Mobile, please confirm if you have updated the app to the latest 7.13.1 version. If the issue persists after update, please login SC Mobile and tap the “Contact \\u0026 Support” icon to contact our live agent for further assistance. ~ Wes\",[1778817108,697000000]],null,[\"105676333923811477890\",\"Hln Ho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL6W9NU1wKgo1TYolrr3AeZK8rksYZDl-HZiboEkvJPJVARrw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.1\",null,null,null,null,null,1],[\"59653828-0f00-4c80-add8-ef27d1506559\",[\"Anthony T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJE0Yt6B5b6To0YfQ-lCQeSTluIoprcfnfD8QJXZ3uqD8EVnw\\u003dmo\"]]],1,null,\"this app was fine until 2 days ago, there are bugs that do not allow me to transfer funding between my accounts. Only a limited number of accounts are selectable. i can only do all my transfer instructions via PC now. Please fix this!\",[1777605600,553000000],0,null,null,[\"114224092341821477403\",\"Anthony T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJE0Yt6B5b6To0YfQ-lCQeSTluIoprcfnfD8QJXZ3uqD8EVnw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.0\",null,null,null,null,null,1],[\"317d0776-380a-42d6-b7cb-4b0dc3b3e882\",[\"Riaz K\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLvxXxStGkyIxCs2o92B3zbgBAVrhrCRwQqYWe-hcqK1K5DXw\\u003dmo\"]]],1,null,\"recently ever since the recent redesign every time I open the app it disables my fingerprint auth and I have to turn it on again. I immediately receive an email saying I disabled it (I did not) and that I activated it. what's the point of a feature if you purposely cripple it on app start every damn time, this is the basics to be clear I don't want to reinstall it, I want updates to it to stop breaking it's ability to even open (it blocks the app being used at all)\",[1777544743,374000000],2,[\"Standard Chartered Bank PLC\",\"Hello Riaz K, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Wes\",[1760610057,934000000]],null,[\"101616076163373171312\",\"Riaz K\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLvxXxStGkyIxCs2o92B3zbgBAVrhrCRwQqYWe-hcqK1K5DXw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.0\",null,null,null,[true,false],null,1],[\"19e4bf8b-a6c3-4429-9525-2378891b447a\",[\"giF Jig\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKYkhnsagraslUjdQ8vviKSaKF9TdrVPPE-E86mEEZ9askvNAQ\\u003dmo\"]]],1,null,\"不能使用指紋登入。 設定開啟用指紋登入，一直轉，冇畫面更新。請盡快修正。 Samsung S24 Utlra, Android 16.\",[1777366589,784000000],0,[\"Standard Chartered Bank PLC\",\"你好Jig Jig，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1778042104,444000000]],null,[\"116267206561447061419\",\"giF Jig\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKYkhnsagraslUjdQ8vviKSaKF9TdrVPPE-E86mEEZ9askvNAQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.13.0\",null,null,null,null,null,1],[\"53f55360-0a6e-479c-8ed0-06c501cde833\",[\"Herbert Kwong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUbjYEZKGJsBb2wmfMgA6ivQM-vZIL0AOv9YdOovIvs6W0lYsNh\"]]],1,null,\"the fact that there is no way to easily share or capture a transfer record make this worst than a third world bank. unnecessary stringent security check. it used to work by installing in the work profile, but now it doesn't. i have to use it on my second phone, and may well switch to another bank with more reasonable policy\",[1776831834,526000000],3,[\"Standard Chartered Bank PLC\",\"Hi Herbert Kwong, for security enhancement, we have recently updated SC Mobile's security settings. Please move SC Mobile from the third-party secure folder to the device's desktop to ensure optimal user experience. If the issue still persists, please visit sc.com/hk/ and tap Stacy to connect with live agent for further follow-up. Thank you. ~ Sara\",[1746785811,886000000]],null,[\"109672131626720005176\",\"Herbert Kwong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUbjYEZKGJsBb2wmfMgA6ivQM-vZIL0AOv9YdOovIvs6W0lYsNh\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,[true,false],null,1],[\"54a07ddb-35e8-4ec4-8d31-6f2d148069a1\",[\"Rahman Khan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKw4FVqVDs-oXBwzW52aS7rfy_Vj5JlRIDepsLNPpYjjCQoFw\\u003dmo\"]]],1,null,\"Wonder who is this incompetent to think its a good idea to not be able to print or download a receipt after a fund transfer when the email transfer receipt has most of the account information removed. Genius at work here.\",[1776654021,446000000],0,[\"Standard Chartered Bank PLC\",\"Hi Rahman Khan, sorry for the inconvenience caused. The screencap restriction is a security control to protect our customers and provide them with safer digital banking experience. This is an industry-wide initiative and other banks in Hong Kong have similar security controls in place. We look forward to obtaining your kindly understanding. ~ Wes\",[1777258640,483000000]],null,[\"101637761671008047150\",\"Rahman Khan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKw4FVqVDs-oXBwzW52aS7rfy_Vj5JlRIDepsLNPpYjjCQoFw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"baea4236-b8b3-4eaf-a3c3-5c906ac11041\",[\"Ken Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLHfmcFf0PydoWvFnGkigV4csrdhia2xytI6oxr9ua75BObsg\\u003dmo\"]]],2,null,\"After using the Faster Payment System to pay someone, it is nice that the App provides an option to send \\\"Thank you \\\" message to notify the payee. However, the App just provides cartoon style emojis for your choice. These cartoon emojis, I think that they are not appropriate for formal transaction notification in some situations. Would the App provides an option of transaction notification without Emojis. Simply a payment notification with payer and payee is fine.\",[1774176499,810000000],0,[\"Standard Chartered Bank PLC\",\"Hello Ken Yeung, apologies for not being able to provide a satisfactory experience. After fund transfer, you can refer to the relevant email notification or transfer history in the SC Mobile App for reference. We will continue to optimize the App to provide our customers with the best experience and look forward to your continuous support. ~ Danny\",[1774504235,523000000]],null,[\"115338879937752781942\",\"Ken Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLHfmcFf0PydoWvFnGkigV4csrdhia2xytI6oxr9ua75BObsg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,[true,false],null,1],[\"01dbcc53-d477-4182-8a51-e84b3bfce229\",[\"Vincent Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIsPXDbp6DBL4X3PkvAtcZT8_xIsis4LX7Q9wzyj_RASaZHXjFx\\u003dmo\"]]],1,null,\"this app discriminate android users, app is very buggy on android phones\",[1773568753,28000000],0,[\"Standard Chartered Bank PLC\",\"Hello Vincent Cheung, we are sorry for unpleasant experience. SC Mobile are operating normally now, you can keep update to the latest version to ensure smooth and stable experience. If you need further assistance, please visit our website: https://www.sc.com/hk/ to connect with our live agent. Our live agent will try our best to assist you. ~ Sara\",[1773830256,490000000]],null,[\"117634492831585473341\",\"Vincent Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIsPXDbp6DBL4X3PkvAtcZT8_xIsis4LX7Q9wzyj_RASaZHXjFx\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"e52b6e71-146d-44f6-8e63-3583ea2cb6b0\",[\"Min Yu Shyu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJDUnOqAAvA7OK5WoobWS7WzMPyjDsbXbYep9Z0GORL-ilqYqQ2\\u003dmo\"]]],1,null,\"My bank accounts, investment accounts, and credit card accounts have been closed for 16 years. They still email me every two weeks. And frequently received mails without theirs logo that claim to be important.\",[1772541678,577000000],0,[\"Standard Chartered Bank PLC\",\"Hi Min Yu Shyu, as we need more information to understand and follow up on your case, please tap the icon of Stacy, our virtual assistance at the bottom right corner of SCB website to connect with our live agent. We will try our best to assist you. ~ Carl\",[1773829470,801000000]],null,[\"115677103935303582638\",\"Min Yu Shyu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJDUnOqAAvA7OK5WoobWS7WzMPyjDsbXbYep9Z0GORL-ilqYqQ2\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"ffc04825-a32d-4417-bf09-3210cfd18eef\",[\"Alan Mak\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKxXt5rKIhmDavc6bSXHBrrifL5JhLFs46Y8K7T5ySrTmmJdA\\u003dmo\"]]],1,null,\"very bad experience, had visit yr branch but cannot settled, what a banking service\",[1772466100,113000000],0,[\"Standard Chartered Bank PLC\",\"Hello Alan Mak, we are sorry to hear your unpleasant user experience. We need more information to understand and follow up on your case, please visit our official website: sc.com/hk, tap the icon of Stacy, in the bottom right corner of the page to connect with our live agent to further assist and follow up your case. Thank you. ~ Wes\",[1772609731,415000000]],null,[\"108726699943986934514\",\"Alan Mak\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKxXt5rKIhmDavc6bSXHBrrifL5JhLFs46Y8K7T5ySrTmmJdA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"b4d5157c-b7d9-4e62-aa54-3feb43ce19e6\",[\"Rhys Lau\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWOfloI8HI5s8EnBgfDGoMFVBUxyDs1uYmus5OkRCRGQBiVJK4\"]]],5,null,\"Best banking app\",[1772426598,508000000],0,[\"Standard Chartered Bank PLC\",\"Hi Rhys Lau, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Wes\",[1772603914,575000000]],null,[\"115912432065284501783\",\"Rhys Lau\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWOfloI8HI5s8EnBgfDGoMFVBUxyDs1uYmus5OkRCRGQBiVJK4\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"e7b27921-c47b-496a-9e47-fad952cb06d1\",[\"K J\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIMdOpVARB7qxMOGtpml7XVDRzw0JYMcF5pweuglKRHBTGudQ\\u003dmo\"]]],1,null,\"always give error mesage 3000\",[1772387132,740000000],0,[\"Standard Chartered Bank PLC\",\"Hi Ke Jing, the error code 3000 is a general error code. We need to further check with your account information to understand the reason why your instruction could not be processed. Please login to the SC Mobile App and tap “Contact \\u0026 Support” at the top right corner to connect with our live agent. We will try our best to assist you. ~ Carl\",[1772522106,51000000]],null,[\"109871094232915940492\",\"K J\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIMdOpVARB7qxMOGtpml7XVDRzw0JYMcF5pweuglKRHBTGudQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"f11a7cf9-8700-4ce4-9adf-2f174fe28b54\",[\"KC Ho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV0wJag77UTTUTAOyACUTRiDuG9TXwb4pCDvz9ok_sSh4_20rM\"]]],1,null,\"戇鳩鳩成日迫人更新\",[1772275725,757000000],0,[\"Standard Chartered Bank PLC\",\"你好KC Ho，為了向用戶提供更好的服務和更高的安全性，我們定期更新應用程式版本，我們會繼續改進SC Mobile app以令客戶獲得更佳體驗，謝謝。 ~ Carl\",[1772510577,453000000]],null,[\"118190971446146939892\",\"KC Ho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV0wJag77UTTUTAOyACUTRiDuG9TXwb4pCDvz9ok_sSh4_20rM\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"9f424e3d-5ee1-47b3-a01b-5eb749276150\",[\"Kay\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWhBk503pkved64Cn6_uUz1_HPpyrz1eI9fS7j7kzT0NxJNFS7z\"]]],1,null,\"enter correct account name and pw, but always can't login\",[1772088702,166000000],0,[\"Standard Chartered Bank PLC\",\"Hi Kay, sorry for any inconvenience caused. We need more information to understand and follow up on your case, please tap the icon of Stacy of our website: sc.com/hk/, and select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to connect with our live agent. We will try our best to assist you to solve the issue. ~ Danny\",[1772522774,408000000]],null,[\"117663397731482560856\",\"Kay\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWhBk503pkved64Cn6_uUz1_HPpyrz1eI9fS7j7kzT0NxJNFS7z\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"8979d602-0a67-4c9c-8fd8-79391ecf8f94\",[\"Joeee Wan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKHJCJi2305Ht8DzWblwjs608jM0MzoeqpBcySSbi-aZK9IfQ\\u003dmo\"]]],1,null,\"it is impossible to type any msg on the live agent page due to the setting of the live agent page.\",[1770862261,319000000],0,[\"Standard Chartered Bank PLC\",\"Hello Joeee Wan, sorry for any inconvenience caused. You can adjust the navigation bar settings of your device to swipe gesture to avoid text input being blocked. You can also log in to the online banking and click on the Stacy icon to contact our live agent. We will continue to optimize SC Mobile to provide a better experience. Thank you. ~ Carl\",[1770948763,465000000]],null,[\"117264791857589176027\",\"Joeee Wan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKHJCJi2305Ht8DzWblwjs608jM0MzoeqpBcySSbi-aZK9IfQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_meet_expectations\",[2]],[\"vaf_never_display_easy_to_use\",[2]],[\"vaf_never_display_deceptive_ads\",[3]]]],null,[true,false],null,1],[\"c140416d-c858-4352-ac42-19f3b9a2ebf8\",[\"Christina\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUe7fH3o-kdbQ5N-wp6qq7kp1eC5y6w2nRtOBzH-kTBP1Ds6vTa4w\"]]],5,null,\"clear and clean interface, user friendly, definitely better than certains bank's app\",[1770170951,736000000],1,[\"Standard Chartered Bank PLC\",\"Hi Christina, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Danny\",[1770269737,776000000]],null,[\"107950117791137673284\",\"Christina\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUe7fH3o-kdbQ5N-wp6qq7kp1eC5y6w2nRtOBzH-kTBP1Ds6vTa4w\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"852b6124-f144-4495-a6b1-fb00270c5a09\",[\"Laura Lees\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV_-Jl_6k6C5MQYWiKiTCvosTutuM6M-1MFu0YH4pnFoqchBwv6\"]]],1,null,\"live agent chat does not work on a samsung flip 6 - the entry box is too low. I reported this last year and it's still not fixed 🤦\\u200d♀️ To clarify, this is not a about talking to the bot but the live agent chat feature. I should not have to log into the website on my mobile phone to talk to an agent if I have the mobile app... please update your testing procedures to test all functionally on different device types.\",[1770122231,679000000],1,[\"Standard Chartered Bank PLC\",\"Hello Laura Lees, sorry for any inconvenience caused. You can adjust the navigation bar settings of your device to swipe gesture to avoid text input being blocked. You can also log in to the online banking and click on the Stacy icon to contact our chat agent. We will continue to optimize SC Mobile to provide a better experience. Thank you. ~ Wes\",[1770098546,269000000]],null,[\"103939966606804522813\",\"Laura Lees\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV_-Jl_6k6C5MQYWiKiTCvosTutuM6M-1MFu0YH4pnFoqchBwv6\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"73fe1909-cf3b-42f2-ae84-37cf11151221\",[\"Aumio Shahriar\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLeuDgrf5o5ZZAi9kOJKkMovplNq_9SMUDAKZnfoy35bZyjYWFw\\u003dmo\"]]],1,null,\"Zero support. Impossible to connect to call center. Chat function awfully tiny on an android and hidden behind bottom panel. Whoever designed the app needs to speak to some real customers and not buy ratings online\",[1769829328,645000000],0,[\"Standard Chartered Bank PLC\",\"Hello Aumio Shahriar, sorry for any inconvenience caused. You can adjust the navigation bar settings of your device to swipe gesture to avoid text input being blocked. You can also log in to the online banking and click on the Stacy to contact our live agent. We will continue to optimize SC Mobile to provide a better experience. Thank you. ~ Carl\",[1770103970,797000000]],null,[\"105501363686130730715\",\"Aumio Shahriar\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLeuDgrf5o5ZZAi9kOJKkMovplNq_9SMUDAKZnfoy35bZyjYWFw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"2e3ca71d-ef20-4fba-a958-a3186ca22852\",[\"Gennaro Pucci\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX9Me7R2101kNWgB5h13xrDu5S7e5vogNi4Y0kRm0smUyZLsfXa\"]]],1,null,\"the worste app for a mobile banking. you cannot change password. level of security is below zero.\",[1769537978,867000000],0,[\"Standard Chartered Bank PLC\",\"Hi Gennaro Pucci, please visit our official website sc.com/hk/ and log in to online banking. After logging in, please select \\\"Change password\\\" on the left-hand side menu bar to change login password. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Carl\",[1770097419,435000000]],null,[\"111318799832515701769\",\"Gennaro Pucci\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX9Me7R2101kNWgB5h13xrDu5S7e5vogNi4Y0kRm0smUyZLsfXa\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"3becc2e7-f61d-46b4-abcf-ff05f7d5d66e\",[\"Diane Hasselhoff Victoria Jasmine Elle Marilyn\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXyfuEeKkKeA2WL7dsCm5veLpHmNKKQAdeXCZhv28VdpOZTqNrV\"]]],5,null,\"The Nigerian app could take a leaf from the brilliant design.\",[1768663178,287000000],0,[\"Standard Chartered Bank PLC\",\"Hi Mercedes Benz, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Carl\",[1769574048,151000000]],null,[\"103471811233966250779\",\"Diane Hasselhoff Victoria Jasmine Elle Marilyn\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXyfuEeKkKeA2WL7dsCm5veLpHmNKKQAdeXCZhv28VdpOZTqNrV\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"50947dfb-1c87-4c62-816a-5d2cbfb9b018\",[\"Andy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKkFys-XYW0NoC0VcaytWvirc10rTyCCgJ5kNRuxqlE0vZ16A\\u003dmo\"]]],2,null,\"android的navigation bar會與app內客服對話的輸入欄重疊，請改善\",[1768561050,786000000],0,[\"Standard Chartered Bank PLC\",\"你好Andy，很抱歉為你帶來不便，如閣下手機的導覽列在聯絡線上客服時有遮擋輸入文字的情況，你可以於手機「設定」内選擇「顯示」\\u003e「導覽列」内更改導覽列設定，或者透過渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1769649413,863000000]],null,[\"106478239766944741376\",\"Andy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKkFys-XYW0NoC0VcaytWvirc10rTyCCgJ5kNRuxqlE0vZ16A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"504528ad-5921-4aa9-b672-fcbc8b0f0cd6\",[\"Andy Chung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJvN7J7-0J8kcIrjscMcj5F8JK8arsP6T5bN9cL76Kwyvm8ng\\u003dmo\"]]],1,null,\"指紋登記啟動咗有時要重新登記過 另外，app入面啲超連結都set錯\",[1767600445,129000000],0,[\"Standard Chartered Bank PLC\",\"你好 Andy Chung，抱歉未能為你帶來滿意的使用體驗，明白你正在面對指紋認證問題，你可以先將SC Mobile app更新至最新7.11.0版本，如更新後情況仍持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1768558779,615000000]],null,[\"117478748695813277095\",\"Andy Chung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJvN7J7-0J8kcIrjscMcj5F8JK8arsP6T5bN9cL76Kwyvm8ng\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"07804251-abc3-45c8-b934-999195f6bda0\",[\"Kevin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK986C5HP6O4KRSGjfn3BgeuJcyz1aWrJr_MLm5YuOrxTh9Cw\\u003dmo\"]]],1,null,\"keeps on having problems with the app. worse banking app in the universe\",[1767560053,698000000],0,[\"Standard Chartered Bank PLC\",\"Hi Kevin, we apologize for the inconvenience caused. As we need more information to understand and follow up on your case, please login to the latest version of SC Mobile App and tap “Contact \\u0026 Support” at the top right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Carl\",[1768543218,809000000]],null,[\"103448221438965797826\",\"Kevin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK986C5HP6O4KRSGjfn3BgeuJcyz1aWrJr_MLm5YuOrxTh9Cw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_ads_experience\",null,[3]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"b7eff450-058a-492d-955a-05020e372590\",[\"whiz presentations\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUxMQ5fXcQrIVs0tLTw1nOXVqKaZlN1lKXmJqkTAqqWa4tEBHM\"]]],2,null,\"can't open the app most of the time...\",[1766968249,652000000],0,[\"Standard Chartered Bank PLC\",\"Hi whiz presentations, we apologize for the inconvenience caused. As we need more information to follow up on your case, please visit our website: sc.com/hk/ and tap the icon of Stacy at the bottom right corner to connect with our live agent for further investigation. We will try our best to assist you to solve the issue. Thank you. ~ Danny\",[1767956352,732000000]],null,[\"108733269784366156337\",\"whiz presentations\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUxMQ5fXcQrIVs0tLTw1nOXVqKaZlN1lKXmJqkTAqqWa4tEBHM\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"2e0e742b-cffa-4e49-92a4-05f0c316bca8\",[\"Ashish Gupta\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU3yewOxl0Dbm21wPAxY1Djj9pFs8OrH6cSv-WHLr_vtu5GTYja\"]]],1,null,\"I want to increase my already approved credit limit but it's been rejected and I am traveling. This is freaking flaws in the system. If the customer lowers the approved limit as per his choice and later wants to increase the very same approved limit,the application is getting rejected. what's freaking logic :(\",[1766679739,114000000],3,[\"Standard Chartered Bank PLC\",\"Hello Ashish Gupta, credit card limit increase depends on overall review result. You may deposit money to the credit card to resume the credit limit for further usage. If you need further assistance, please log in to the SC Mobile and tap “Contact \\u0026 Support” to connect with live agent. We will try our best to assist you. Thank you. ~ Wes\",[1767955741,536000000]],null,[\"106729664412103609466\",\"Ashish Gupta\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU3yewOxl0Dbm21wPAxY1Djj9pFs8OrH6cSv-WHLr_vtu5GTYja\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"885c50ac-5ab2-40ca-ad27-2954ab915f58\",[\"Mei Ling Fung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJeu3EQTQNAY0ZEKWHfjMb29UKjxpcB0j9XX3q-FL_RPwgSOlxZ\\u003dmo\"]]],5,null,\"多謝！\",[1766061079,389000000],0,[\"Standard Chartered Bank PLC\",\"你好Mei Ling Fung，感謝你的反饋。 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。 ~ Danny\",[1766372130,699000000]],null,[\"118222130753798516694\",\"Mei Ling Fung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJeu3EQTQNAY0ZEKWHfjMb29UKjxpcB0j9XX3q-FL_RPwgSOlxZ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"87195969-99a2-41f3-8c81-9ee8d01f6050\",[\"CF K\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIdNjA2-joVoKFpOn3sxwF9v2iPanPwLP1hIfd6sMn5pBV95g\\u003dmo\"]]],3,null,\"with samsung s24ultra, when I try to switch to live agent chat, the input box at the bottom part is covered by the icon bar of the phone thus cant be used.\",[1765518926,349000000],1,[\"Standard Chartered Bank PLC\",\"Hello CF K, thank you for your feedback, if you are unable to type in the message bar, you could go to your phone [setting] \\u003e [Display] \\u003e [Navigation bar] to update the navigation bar setting. You can also visit our website at https://www.sc.com/hk/ . Tap the Stacy icon at the bottom right corner to connect with our live agent. ~ Danny\",[1765851546,199000000]],null,[\"101486468918918526226\",\"CF K\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIdNjA2-joVoKFpOn3sxwF9v2iPanPwLP1hIfd6sMn5pBV95g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,null,null,null,null,1],[\"262ef40a-69d6-48cd-9a90-de15367ad03c\",[\"w w\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIWcfF9skhdBpkZseDfvp5j3OustN_egnNGYgQUlKOAzCbQYA\\u003dmo\"]]],2,null,\"I am using Samsung cell phone. After updating the app, when I tried to have live chat with agent, I could not type in the message bar cause the message bar was covered at the bottom. Please fix it.\",[1764829327,102000000],1,[\"Standard Chartered Bank PLC\",\"Hello w w, sorry for any inconvenience caused, if you are unable to type in the message bar, you could go to your phone [setting] \\u003e [Display] \\u003e [Navigation bar] to update the navigation bar setting. You can also visit our website at https://www.sc.com/hk/ . Tap the Stacy icon at the bottom right corner to connect with our live agent. ~ Danny\",[1765352606,987000000]],null,[\"101699500418362706906\",\"w w\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIWcfF9skhdBpkZseDfvp5j3OustN_egnNGYgQUlKOAzCbQYA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,null,null,null,null,1],[\"a4d6df56-9d7c-44b3-b8d8-761c709427a0\",[\"Louis van Wyk\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU48ySEKHsIwy72aL10X8nVeb-OI56Ar8evFCB7sMT7SdomKDK5FQ\"]]],5,null,\"Excellent\",[1763899924,309000000],0,[\"Standard Chartered Bank PLC\",\"Hi Louis van Wyk, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future and your continuous support. ~ Carl\",[1764654456,673000000]],null,[\"108727701618969990659\",\"Louis van Wyk\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU48ySEKHsIwy72aL10X8nVeb-OI56Ar8evFCB7sMT7SdomKDK5FQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,[[[\"vaf_never_display_ads_experience\",null,[5]],[\"vaf_never_display_ease_of_use\",null,[5]]]],null,null,null,1],[\"01c048b0-8558-417e-8add-fc086a2fa1d9\",[\"Samson Tang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUQky9E-P1CsjNT123IB6iDNbYzsCk7SgyRqEMkSLjFzfDgQzLL\"]]],1,null,\"垃圾 慢到傻\",[1763025253,768000000],0,[\"Standard Chartered Bank PLC\",\"你好 Samson Tang，抱歉未能為你帶來滿意的流動理財用戶體驗，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。~ Danny\",[1764144025,756000000]],null,[\"105459637739235014213\",\"Samson Tang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUQky9E-P1CsjNT123IB6iDNbYzsCk7SgyRqEMkSLjFzfDgQzLL\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"28f8c93e-e462-4b04-850d-f0368c90a9a5\",[\"Kwong Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIMlU_cx-TAt4UmdQomjE-RCmyQB0apYjK00JhBnesa0dG8XA\\u003dmo\"]]],1,null,\"unable to log in because somehow the \\\"I Agree\\\" button to agree to the terms and conditions of use cannot function.\",[1762512346,897000000],0,[\"Standard Chartered Bank PLC\",\"Hi Kwong Chan, sorry for the inconvenience caused. Please update SC Mobile app to our latest version 7.8.0. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. Thank you. ~ Sara\",[1763357446,265000000]],null,[\"103528218922215403470\",\"Kwong Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIMlU_cx-TAt4UmdQomjE-RCmyQB0apYjK00JhBnesa0dG8XA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"3ab70617-393f-4dc7-9aa3-9f418d4a0e18\",[\"Lok Yan Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI_q-4rRMCgUekaYfx6FwP7v7h3E4d1pMfmyKh9W-AWW5UvGQ8\\u003dmo\"]]],1,null,\"Updated Nov '25: Recently I have to send a push twice and approve them in this mobile app before I can login to their banking website. Clearly a bug. Login with the app requires my password every time, which is an inconvenience. The fingerprint option has never worked, as my print is too thin to be scanned. Please allow login with a pin number just like many other banking apps. Until these features are improved, the 1 star rating stays.\",[1762495734,399000000],8,[\"Standard Chartered Bank PLC\",\"Hello Lok Yan Wong, sorry for the inconvenience caused. Please update the SC Mobile app to the latest version 7.8.0. If the issue persists, please contact our live agent in SC Mobile app for assistance. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Danny\",[1763364042,727000000]],null,[\"116079466181836991546\",\"Lok Yan Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI_q-4rRMCgUekaYfx6FwP7v7h3E4d1pMfmyKh9W-AWW5UvGQ8\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,[true,false],null,1],[\"dabdac15-b2ab-4b2a-9a32-4f2dba451a6b\",[\"Stephen Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU2MlCzCyIObB65Jzn7ALbiY-cu7Nt3RERIwBplxX47biw3KT8\"]]],1,null,\"when ask for rate limit increase and upload file, it crashes\",[1762311151,919000000],0,[\"Standard Chartered Bank PLC\",\"Hi Stephen Cheung, we are sorry for the unpleasant experience. As we need more information to understand and follow up on your case, please login to SC Mobile App and tap “Contact \\u0026 Support” at the top right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Carl\",[1763444314,30000000]],null,[\"117669678741948231729\",\"Stephen Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU2MlCzCyIObB65Jzn7ALbiY-cu7Nt3RERIwBplxX47biw3KT8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"cc532152-cb8a-4684-a9dd-db6e971bb341\",[\"Norman Chow\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpmKaAHG-exjwFiOuh_1ybpmcWZ0MtlaImUJlYWZ9fER0HAEx0\"]]],2,null,\"The OTPs (email, sms) take so long to receive that by the time I get them my login session has expired\",[1762222921,447000000],0,[\"Standard Chartered Bank PLC\",\"Hello Norman Chow, sorry for the inconvenience caused. You can update SC Mobile app to our latest version 7.8.0. If the login issue persists, please visit : sc.com/hk, tap the icon of Stacy, to connect with our live agent. We’re here to assist you promptly. ~ Sara\",[1762504862,269000000]],null,[\"101406099357744702329\",\"Norman Chow\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpmKaAHG-exjwFiOuh_1ybpmcWZ0MtlaImUJlYWZ9fER0HAEx0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[2]]]],null,null,null,1],[\"f8fa607b-172b-41a7-9a26-89a14d52a203\",[\"Kenny Lim\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLwIBQdEtjkxPxomTkpeOsA73zlKqEPi4q__f1GGuweyUuaeg\\u003dmo\"]]],4,null,\"easy and convenient to use\",[1761981846,874000000],0,[\"Standard Chartered Bank PLC\",\"Hi Kenny Lim, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Carl\",[1762305820,669000000]],null,[\"113495453976500249700\",\"Kenny Lim\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLwIBQdEtjkxPxomTkpeOsA73zlKqEPi4q__f1GGuweyUuaeg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"e31c60e3-32e6-46b6-8ed7-c83f85b50557\",[\"Arif Islam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVemlCAJHD4RhZO-Ljb_PWfYP4CtjxUGSf9DGNpWh1W5kuK4Xoi\"]]],1,null,\"App keeps disabling my biometric login.\",[1761750550,387000000],0,[\"Standard Chartered Bank PLC\",\"Hello Arif Islam, sorry for the inconvenience caused. You can update SC Mobile app to our latest version 7.8.0. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. Thank you. ~ Carl\",[1761883836]],null,[\"103839247136393375438\",\"Arif Islam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVemlCAJHD4RhZO-Ljb_PWfYP4CtjxUGSf9DGNpWh1W5kuK4Xoi\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"6042b3e9-5268-4a89-829f-8c0080d26563\",[\"A Y\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOxfSCLirwK2vNcwNXWApMIpWfuUHOqBGJlMMXVNETIF0PqA\\u003dmo\"]]],1,null,\"手田3\",[1761568431],0,[\"Standard Chartered Bank PLC\",\"你好A Y，抱歉未能為你帶來滿意的SC Mobile用戶體驗。如有需要進一步協助，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗，並期待獲得你的持續支持，謝謝。 ~ Sara\",[1761640258,375000000]],null,[\"104762643518808915672\",\"A Y\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOxfSCLirwK2vNcwNXWApMIpWfuUHOqBGJlMMXVNETIF0PqA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"5436b44a-f7c0-4dfb-a9eb-09733762f1fd\",[\"Tobias Ng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL2e0EhlTILYxaOA2s9pFFRl43Cac0X7NyhFDZNzYYwitSr\\u003dmo\"]]],1,null,\"After the recent update, I've lost most of the useful shortcuts. I believe QR cash is much more useful than referring to friends!\",[1761278679,926000000],0,[\"Standard Chartered Bank PLC\",\"Hi Tobias Ng, thank you for your feedback. We are sorry to hear that the current setting does not meet your needs. After login SC Mobile. You can click \\\"Pay and Transfer\\\"\\u003e \\\"QR Cash\\\" to cash withdrawal. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Sara\",[1761639912,702000000]],null,[\"117716948286211503283\",\"Tobias Ng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL2e0EhlTILYxaOA2s9pFFRl43Cac0X7NyhFDZNzYYwitSr\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"7471cdd5-fc39-46e7-8b18-ce143de9ea4f\",[\"janet ng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJob_kS3OlD1Tydn3KLYoV74gDUFMaFoEcotI6ak_xxCslkbQ\\u003dmo\"]]],1,null,\"terrible app, non responsive many times\",[1761231845,790000000],0,[\"Standard Chartered Bank PLC\",\"Hi janet ng , sorry for the inconvenience caused. You can update the SC Mobile app to our latest version 7.8.0. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. Thank you. ~ Sara\",[1761810180,634000000]],null,[\"110524294435457554084\",\"janet ng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJob_kS3OlD1Tydn3KLYoV74gDUFMaFoEcotI6ak_xxCslkbQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,[[[\"vaf_never_display_easy_to_use\",[2]],[\"vaf_never_display_content_language\",[1]],[\"vaf_never_display_visually_bad\",[3]]]],null,null,null,1],[\"56c4ef88-2413-4b2d-a46b-8e31b4cb0872\",[\"yat-kwai Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVXccyVJIbd4SAj9Y6aRD7hJcVet9LjdIkI1hypSruJTC9uaibl\"]]],1,null,\"I have installed the preious version but, unluckily, broken my smartphone so I could not use the app. I tried to installed it on an older phone but the play store would not let me. Since then I have lost connection with the bank even on the bank website. The problem is that I must have this app instlled for verification purposes. I just wonder why the website cannot use the sms or email verfification.\",[1761156833,645000000],0,[\"Standard Chartered Bank PLC\",\"Hi yat-kwai Lee, sorry for the inconvenience caused. To ensure safety and phishing prevention, we have set the minimum OS requirement of Android 10 and SC Mobile Key replaces SMS One Time Password. If your login issue persists, please visit : sc.com/hk, tap the icon of Stacy, to connect with our live agent. We’re here to assist you promptly. ~ Wes\",[1762227319,684000000]],null,[\"108900774470995825809\",\"yat-kwai Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVXccyVJIbd4SAj9Y6aRD7hJcVet9LjdIkI1hypSruJTC9uaibl\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,[true,false],null,1],[\"97cf38bb-359d-4df3-9f87-88f05af73a69\",[\"Mischa Weston\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWqAlcLnBIyAQJtjpm_uQLOSovN6YI2wg4oLfz8eNWq86Wn9Eph\"]]],1,null,\"Unable to use biometrics using android. Reported it to them around 2 weeks around, no app update. Poor at best.\",[1761010019,803000000],0,[\"Standard Chartered Bank PLC\",\"Hello Mischa Weston, sorry for the inconvenience caused. You can update the SC Mobile app to our latest version 7.8.0. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon after logged in. We will try our best to assist you to solve the issue. Thank you. ~ Sara\",[1761785697,471000000]],null,[\"112363303108378898189\",\"Mischa Weston\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWqAlcLnBIyAQJtjpm_uQLOSovN6YI2wg4oLfz8eNWq86Wn9Eph\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"0bcc630d-4f4f-42dd-876e-ebeb33b578c5\",[\"Chan Angus\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVJ7P3B6YcB4BDPeUbwKJwT25DI4YIkY4pecLIuKvk6xpLGEpVPUQ\"]]],2,null,\"QR Cash cannot focus on qrcode while scanning.\",[1760965253,603000000],0,[\"Standard Chartered Bank PLC\",\"Hello Chan Angus, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. ~ Danny\",[1760524688,103000000]],null,[\"106399991563522325829\",\"Chan Angus\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVJ7P3B6YcB4BDPeUbwKJwT25DI4YIkY4pecLIuKvk6xpLGEpVPUQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,[true,false],null,1],[\"fc00151d-4076-4789-b86f-6033131f10ce\",[\"Charles Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUlCWWQeUmLAmIOu-emfVTsotCHl23GLB38Jj0a7e5WKlTeh58z\"]]],1,null,\"Need to redo the activation of fingerprint evey time...\",[1760926822,569000000],0,[\"Standard Chartered Bank PLC\",\"Hello Charles Chan, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Danny\",[1761127201,254000000]],null,[\"109816160776895469434\",\"Charles Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUlCWWQeUmLAmIOu-emfVTsotCHl23GLB38Jj0a7e5WKlTeh58z\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"b048f3bc-e71f-4257-ba93-2db766fd96d7\",[\"Paul Huang Kam Lung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUX8_VAG32tSVuZpwmG1QNfcTQoWcHToMdkRwvW9_grHxAJLeIJHw\"]]],1,null,\"Every time I enable biometric login it disable it again immediately\",[1760746768,459000000],1,[\"Standard Chartered Bank PLC\",\"Hello Paul Huang Kam Lung, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Wes\",[1761106603,673000000]],null,[\"108123406192014157544\",\"Paul Huang Kam Lung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUX8_VAG32tSVuZpwmG1QNfcTQoWcHToMdkRwvW9_grHxAJLeIJHw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"559a98af-ecb6-43d1-ac8e-64ecb6c1d293\",[\"Jimmy Chong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUJMOIoNTuSS4Tzm-9fsCFaLrVuqpuVkjSumLQGSVLZWCAIxWXE\"]]],2,null,\"I was required to enable the biometric function every time I log in, even though I have done that. The problem persists recently.\",[1760611719,244000000],1,[\"Standard Chartered Bank PLC\",\"Hello Jimmy Chong, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Danny\",[1761031913,101000000]],null,[\"109633180993736036189\",\"Jimmy Chong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUJMOIoNTuSS4Tzm-9fsCFaLrVuqpuVkjSumLQGSVLZWCAIxWXE\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"2ab138d9-b0fa-4ec1-a746-89847d245b60\",[\"eric tang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJJ1LdkmdJ_trR0JYLHh-2hDgIE-LCa6E4H_IS6rvhP_A8wEQ\\u003dmo\"]]],1,null,\"My mobile no longer able to run latest version of this apps. However, even I use another device to install this apps, it still require to used old mobile to pass the security check. So it become a deadlock loop. Did the designer use brain to think when design?\",[1760610238,149000000],2,[\"Standard Chartered Bank PLC\",\"Hi eric tang, we apologize for the inconvenience caused. You can delete the SC Mobile App from the previous device first, then reinstall the App on the new phone. If your mentioned issue still persists, please visit: sc.com/hk , tap the icon of Stacy, to connect with our live agent to further assist you. Thank you. ~ Sara\",[1761127572,460000000]],null,[\"115678837709548376839\",\"eric tang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJJ1LdkmdJ_trR0JYLHh-2hDgIE-LCa6E4H_IS6rvhP_A8wEQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"4cb4940d-964b-4e0b-9bcd-562ef21cc3ef\",[\"Philip Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL79X4KPt03nKN5PUy8nQAaGsjawDkeihqf6dBQylllGpex9w\\u003dmo\"]]],1,null,\"worst update, lost biometric login\",[1760540085,55000000],0,[\"Standard Chartered Bank PLC\",\"Hello Philip Wong, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Danny\",[1761040890,165000000]],null,[\"105936161889370179484\",\"Philip Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL79X4KPt03nKN5PUy8nQAaGsjawDkeihqf6dBQylllGpex9w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,[[[\"vaf_never_display_disruptive_ads\",[2]],[\"vaf_never_display_spend_more_time\",[1]],[\"vaf_phase1_payday_loans\",[3]]]],null,[true,false],null,1],[\"bf543585-a854-41ab-95d5-1d7ddfe95366\",[\"Lee Jack\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLg_EFxUL2tj4K3ecMNp2UH5pM1O5qvCIaQvebi1ICS3pKIUj8\\u003dmo\"]]],1,null,\"In the latest update, every time I open the app, The biometric verification will be reset, causing me to be unable to log in with fingerprints for the past month.\",[1760405576,857000000],0,[\"Standard Chartered Bank PLC\",\"Hello Lee Jack, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Danny\",[1760693907,212000000]],null,[\"113535161431881359381\",\"Lee Jack\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLg_EFxUL2tj4K3ecMNp2UH5pM1O5qvCIaQvebi1ICS3pKIUj8\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"68d19339-e9a7-4ed6-93b6-aa377b205b37\",[\"Russell Li\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLvM2vnkE80PdHm02K-hFfCbTqxVUpsP1PHj8es6SDtOY2iHQ\\u003dmo\"]]],1,null,\"So I have to buy a new mobile phone to access my banking....\",[1760385532,53000000],0,[\"Standard Chartered Bank PLC\",\"Hi Russell Li, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Danny\",[1760693979,776000000]],null,[\"116652230119044527231\",\"Russell Li\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLvM2vnkE80PdHm02K-hFfCbTqxVUpsP1PHj8es6SDtOY2iHQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.3\",null,null,null,null,null,1],[\"44edebc8-4f5f-4987-b668-edc5e7541780\",[\"Jackson Li\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJVZMwMQjRe_zSqKBi8CQYTlkm3J129KL2qravM8_8lrZoQfQ\\u003dmo\"]]],1,null,\"why do I need to enable biometric every time I log in?\",[1760192971,4000000],0,[\"Standard Chartered Bank PLC\",\"Hello Jackson Li, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Wes\",[1760609977,121000000]],null,[\"102563842280402770755\",\"Jackson Li\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJVZMwMQjRe_zSqKBi8CQYTlkm3J129KL2qravM8_8lrZoQfQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"71268b54-370a-4028-9637-585379cc8ed7\",[\"Erin Tse\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX5RaiAMDAW7z_Vl1dm0SF1iSmfyMUW0ZQN1HtHeaKhWFp8Y39DKw\"]]],2,null,\"Used to be easy to login with biometric but after updating the app, it keeps disabling this function. The app itself is not as user friendly as other banking apps. Please fix this biometric login issue\",[1760142523,515000000],1,[\"Standard Chartered Bank PLC\",\"Hello Erin Tse, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. Thank you. ~ Wes\",[1760609283,209000000]],null,[\"116454744237370397854\",\"Erin Tse\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX5RaiAMDAW7z_Vl1dm0SF1iSmfyMUW0ZQN1HtHeaKhWFp8Y39DKw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,[[[\"vaf_never_display_positive_impact\",[2]],[\"vaf_never_display_content_language\",[1]],[\"vaf_never_display_disruptive_ads\",[1]]]],null,null,null,1],[\"7b315a11-a65c-4fb0-93c1-885f6ee3fa96\",[\"L\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLEpQq_2Gsj76ObMXjilhO45IZxN8htTAMG6Ey6GyrmqeZzfA\\u003dmo\"]]],1,null,\"You said Android 9 is no longer supported for security issue. Is it Android 9 that is insecure? Or is it your IT team that failed to make it secure on Android 9 ?\",[1760066114,827000000],0,[\"Standard Chartered Bank PLC\",\"Hi L, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Danny\",[1760525681,320000000]],null,[\"117819237829585949338\",\"L\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLEpQq_2Gsj76ObMXjilhO45IZxN8htTAMG6Ey6GyrmqeZzfA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.8\",null,null,null,[true,false],null,1],[\"c5da4ece-c993-44c7-92f9-c350f2ed2641\",[\"Enkoo Poon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJFAtIQeFhO6UDzuvwcABbuO9lXcV3EkZ5fv3tmVJ8coowskiw\\u003dmo\"]]],1,null,\"The saved login information is somehow gone (i.e., cannot log in using biometric authentication). Cannot even log in with username and password. I don't recall that I have ever changed the password. Tried to clean install in secure folder, but it keeps prompting the app is not updated.\",[1760062276,731000000],1,[\"Standard Chartered Bank PLC\",\"Hello Enkoo Poon, we apologize for the inconvenience caused. You can try reinstalling the SC Mobile app. If the issue persists, please contact our live agent by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. ~ Sara\",[1760602610,678000000]],null,[\"115196302262400427204\",\"Enkoo Poon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJFAtIQeFhO6UDzuvwcABbuO9lXcV3EkZ5fv3tmVJ8coowskiw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"19963b7b-ea12-425f-bf4b-acc96966794d\",[\"- Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVTThj8iFfY5B90q8uds7L8LF6gJBmtORlseS-KvPy77Q4Rb0Ye\"]]],2,null,\"when you click on the messages icon , it forces closed\",[1760023206,618000000],0,[\"Standard Chartered Bank PLC\",\"Hello - Lee, sorry for the unpleasant experience, as this is a third party platform and we need more information to understand and follow up on your case, please tap the icon of Stacy, at the bottom right corner of our website : https://www.sc.com/hk/ to connect with our live agent. We will try our best to assist you to solve the issue. ~ Wes\",[1760597016,959000000]],null,[\"105026078703981444226\",\"- Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVTThj8iFfY5B90q8uds7L8LF6gJBmtORlseS-KvPy77Q4Rb0Ye\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"3afd6538-3683-4492-9fb2-a80b5bf6deb5\",[\"Henry Henda\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL6qxdoeg3B2exxo3EWKBqvcVNDUHfv9WrVyW6pL9Quk1TFUw\\u003dmo\"]]],1,null,\"After running this app, my screen shows \\\"your device isn't compatible with this app\\\". Full stop. It does not tell me any alternatives to get it done. Nor does it tell me what devices are compatible. No help. Very hostile to me.\",[1759973654,140000000],0,[\"Standard Chartered Bank PLC\",\"Hello Henry Henda, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Wes\",[1760580653,46000000]],null,[\"114332876720432061155\",\"Henry Henda\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL6qxdoeg3B2exxo3EWKBqvcVNDUHfv9WrVyW6pL9Quk1TFUw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"fc864958-794b-4f38-9691-dada3feecf0f\",[\"Mickael R\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWhGLs1FtVOUQqGCWYmdse_yISQP-WfqcVBxgkgumIMOhNC0gk\"]]],1,null,\"Wth is wrong again with this app? Asking to enable fingerprint log in every time I try to open it even though it's already been done. There is only SC to push garbage like this to prod...\",[1759808229,837000000],0,[\"Standard Chartered Bank PLC\",\"Hello Mickael R, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. ~ Danny\",[1760525071,48000000]],null,[\"115959898997994832077\",\"Mickael R\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWhGLs1FtVOUQqGCWYmdse_yISQP-WfqcVBxgkgumIMOhNC0gk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"f2ddb98e-12c3-46fa-9634-db8248c1a185\",[\"Chester YAN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJELDq2Zp6N3bK-4pR0-rX2YnbvfabEYufDdgJ1YR9OjTLHhCkT\\u003dmo\"]]],1,null,\"Finger print login does work after update , need to enable every time .\",[1759807108,901000000],0,[\"Standard Chartered Bank PLC\",\"Hello Chester YAN, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. ~ Danny\",[1760525002,691000000]],null,[\"109548607990827977887\",\"Chester YAN\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJELDq2Zp6N3bK-4pR0-rX2YnbvfabEYufDdgJ1YR9OjTLHhCkT\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"bee38c55-e0a4-4d30-854d-ceb99ec01758\",[\"Tom Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVwnwhnaa2iRqJmUkc6zT8mHDCK6hIqKhV7L_F6EmLNW5EHFF5-\"]]],1,null,\"Security Warning If you see this page, then your current SC Mobile App is not the latest version or your device is not secured. Please download the latest version of SC Mobile or update your device. L Error! Code: #1002 It just keep asking to re-enter my password. everytime start the app even though I have already enabled biometric login.\",[1759761498,546000000],1,[\"Standard Chartered Bank PLC\",\"Hi Tom Chan, we apologize for the inconvenience caused. For security enhancement, we have updated SC Mobile's security settings. Currently, SC Mobile app does not support being opened indirectly through other applications. Please move SC Mobile from the secure folder to the device's desktop to ensure optimal user experience. Thank you. ~ Danny\",[1760526083,755000000]],null,[\"100192505805680087456\",\"Tom Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVwnwhnaa2iRqJmUkc6zT8mHDCK6hIqKhV7L_F6EmLNW5EHFF5-\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,[true,false],null,1],[\"98882839-4254-4d59-9824-e1e75e827ce8\",[\"kwok wallace\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKcIawYRTdw2ec9pJxaq2u4WfxvO2jqDP5WBdb63XkZTBmHuA\\u003dmo\"]]],3,null,\"when logging in, the app shows biometric login not activated. After I enable the biometric login in the setting page and I re-login the second time it shows again biometric login not activated.\",[1759670807,889000000],3,[\"Standard Chartered Bank PLC\",\"Hello kwok wallace, you can try reinstalling the SC Mobile app. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. We look forward to your continuous support. ~ Danny\",[1760524552,148000000]],null,[\"118071172387969581300\",\"kwok wallace\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKcIawYRTdw2ec9pJxaq2u4WfxvO2jqDP5WBdb63XkZTBmHuA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,[[[\"vaf_never_display_ease_of_use\",null,[3]],[\"vaf_never_display_ads_experience\",null,[3]]]],null,[true,false],null,1],[\"2f8c979c-3b6e-47b0-8400-69f0ae035679\",[\"Cheung Wilson\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXE5LwT0m-CpSQNpNqyTBAQWF7PKPzkkfR7Q92ay0JwFmwLZ1Pq\"]]],1,null,\"The mobile app didn't support old android version and did not provide other options for the online banking security check (such as the one time password with SMS previously used) cause me unable to operate my account now. I am considering to close my bank account.\",[1759578699,111000000],1,[\"Standard Chartered Bank PLC\",\"Hi Cheung Wilson, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Danny\",[1759917947,293000000]],null,[\"110902648119664569719\",\"Cheung Wilson\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXE5LwT0m-CpSQNpNqyTBAQWF7PKPzkkfR7Q92ay0JwFmwLZ1Pq\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"94d6efb9-c66d-4608-9390-1c1fe78c43c1\",[\"A Y\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJALkCB0v7nn74S-8jCwGmN9sUyVJLHbhjRdB948KVUmDmrwA\\u003dmo\"]]],1,null,\"forced to buy a new phone or no access to internet banking. the new updates make the app no longer support old andriod OS, useless now.\",[1759390201,850000000],1,[\"Standard Chartered Bank PLC\",\"Hi A Y, sorry for the inconvenience caused. Android 9 has vulnerability issues based on internal testing report. To ensure safety and phishing prevention, we have set the minimum OS requirement of SC Mobile to Android 10 and SC Mobile Key replaces SMS One Time Password. We will continue to optimize SC Mobile to improve user experience. ~ Wes\",[1759919572,707000000]],null,[\"116910459361157327471\",\"A Y\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJALkCB0v7nn74S-8jCwGmN9sUyVJLHbhjRdB948KVUmDmrwA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"19aec0fb-a356-4718-bc67-b2063a357a4a\",[\"Clifford Levy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL2E4QnjuV524miiAUrkWA3KyZytbjIDD3ACaGq1RAAcusNWg\\u003dmo\"]]],1,null,\"Recent update means that if you are running an older Android version you can no longer open the app. This means that you cannot log in because all forms of login require you to approve or generate an off-line pin through the app. You will be cut off from your ability to use internet banking and there was no warning. For those that cannot afford to regularly change their phones or for older people who do not change their phones because they do not want to learn new things this is an issue.\",[1758959688,411000000],31,[\"Standard Chartered Bank PLC\",\"Hi Clifford Levy, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Carl\",[1759400455,48000000]],null,[\"117840895996013234337\",\"Clifford Levy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL2E4QnjuV524miiAUrkWA3KyZytbjIDD3ACaGq1RAAcusNWg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]],[\"vaf_never_display_ads_experience\",null,[1]]]],null,null,null,1],[\"10de075f-32d0-4513-93a0-0334145b8492\",[\"Sam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK1raLlT3Hpf_M0OmZOKomThATqRE4FYm2G15SYTKo-HPPsGg\\u003dmo\"]]],1,null,\"250925: really rubbish app, suddenly logged me out, cannot login with correct id n pw(i marked down), and it said no internet connection(even i re-install, tried wifi/mobile,same,ofcoz im online) 垃圾! 240129: Nonsense disabled screen cap function. But can you ge a proper receipt for sending out? stickers really stupid P.S. thanks for the prompt reply, i got the sms, but the best way must be the screen cap(other bank can share it out), or a formal receipt picture, rather than the SCB funny emoji\",[1758739387,732000000],2,[\"Standard Chartered Bank PLC\",\"Hi Sam, upon the completion of SC Pay(FPS), Scan \\u0026 Pay, International \\u0026 Cross Border Transfer, the bank will send email/SMS or Push Notification to update the payment status. You could refer to the notification for reference. ~ Alice\",[1706505745,944000000]],null,[\"114427280527063075965\",\"Sam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK1raLlT3Hpf_M0OmZOKomThATqRE4FYm2G15SYTKo-HPPsGg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,[true,false],null,1],[\"09608a15-4477-475c-b87d-154acb8d47d0\",[\"Karl Cho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIiL_8yVarU69GP_ZuVsEhXUiLsTbGjtTYnGmNRUzTXIePKdQ\\u003dmo\"]]],3,null,\"It doesnt work to let me login!\",[1758566392,225000000],0,[\"Standard Chartered Bank PLC\",\"Hi Karl Cho, we apologize for the inconvenience caused. As we need more information to follow up on your case, please tap the icon of Stacy, our virtual assistance at the bottom right corner of SCB website, and select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to connect with our live agent. Thank you. ~ Carl\",[1759207367,495000000]],null,[\"101283373170704281312\",\"Karl Cho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIiL_8yVarU69GP_ZuVsEhXUiLsTbGjtTYnGmNRUzTXIePKdQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,[[[\"vaf_never_display_ease_of_use\",null,[3]],[\"vaf_never_display_ads_experience\",null,[3]]]],null,null,null,1],[\"f1fc8788-57df-40b5-ad7d-6ffa9189bc05\",[\"Fei\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKcDoHslnPPpyUFCX2290JteHmLTtmaKsKPnBsGVxsCsXxaVg\\u003dmo\"]]],1,null,\"this app isn't compatible with your device anymore. this was working before you force an update. are you expecting me to buy a new phone because of bank updated app???\",[1758279498,154000000],1,[\"Standard Chartered Bank PLC\",\"Hi Fei, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Carl\",[1759208295,602000000]],null,[\"111065220833469071420\",\"Fei\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKcDoHslnPPpyUFCX2290JteHmLTtmaKsKPnBsGVxsCsXxaVg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"c6cfee84-09d0-4df5-91f6-01231f276436\",[\"飄夢\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVHc5neQYkJOMbiQym9wuGqwjylpOBnpF5gta75mqmFz7ggvGVA\"]]],1,null,\"unable to even start, while enforced to use to login web bank\",[1757693458,392000000],0,[\"Standard Chartered Bank PLC\",\"Hi 飄夢. we apologize for the inconvenience caused. Please check if your SC Mobile is already the latest version 7.7.7. If the issue persists , please visit: sc.com/hk, tap the icon of Stacy, select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to connect with our live agent to further assist your case. Thank you. ~ Sara\",[1757926062,997000000]],null,[\"111028802354891611398\",\"飄夢\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVHc5neQYkJOMbiQym9wuGqwjylpOBnpF5gta75mqmFz7ggvGVA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,[true,false],null,1],[\"9d3cce42-d45c-47ef-90de-da2623222a8d\",[\"Eve White\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ0xf9BmLKHEr2uJ4_3BbjIYpJ26bXZpulumWi6D374zAVmYg\\u003dmo\"]]],1,null,\"I will not bank with SC because their app does not support custom ROMs, containerization, sandboxing, and virtualization. Instead of enabling app to run in these environments, they have banned it. To SC management: your competitors support all of the above environments, and I will choose their services instead. The person responsible for setting security standards is clearly avoiding responsibility. I will close my account today and withdraw all my funds.\",[1757650215,830000000],1,[\"Standard Chartered Bank PLC\",\"Hello Eve White, thank you for your valuable feedback. We sincerely apologize for the inconvenience you have experienced with our app. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Danny\",[1758006587,616000000]],null,[\"106556124029515864229\",\"Eve White\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ0xf9BmLKHEr2uJ4_3BbjIYpJ26bXZpulumWi6D374zAVmYg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"1f65becc-062b-4553-8846-c78da4293299\",[\"Niall Rigby\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV_UXVlAIBOI_GLzuSw7921N7VAGEIesSNFzj53VoW-BRZtP9hSeA\"]]],1,null,\"I have been using this app for one year and now it tells me I need to buy a new phone because mine is not compatible with the latest app! That is outrageous! Galaxy Note 8 may not be new but it's in perfect working order. If it was good enough to run this app over the past 12 months why can't I continue? Others with new models can upgrade to an improved experience. I would be very happy to forego any 'improvements' until I decide to upgrade my phone. This sucks! Goodbye Standard Chartered!\",[1757561488,207000000],6,[\"Standard Chartered Bank PLC\",\"Hi Niall Rigby, we apologize for the inconvenience caused. According to internal testing report, Android 9.0 has vulnerability issues. To ensure safety and security of your accounts, we have set the minimum OS requirement of SC Mobile App to Android 10.0. We will continue to optimize SC Mobile and look forward to your continuous support. ~ Carl\",[1757668617,586000000]],null,[\"111023000024837042657\",\"Niall Rigby\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV_UXVlAIBOI_GLzuSw7921N7VAGEIesSNFzj53VoW-BRZtP9hSeA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,[[[\"vaf_never_display_make_you_happy\",[2]],[\"vaf_never_display_content_language\",[1]],[\"vaf_never_display_app_description\",[3]]]],null,null,null,1],[\"8a51740b-4e75-4dc0-a70d-1988737ce9d7\",[\"TrainerHEZ\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUppXZhlttT0LvC45EUACLFzoomCwwEepA6CH6P5eVXK5Rd0og\"]]],1,null,\"Took me so many attempts to even get an account set up without the app messing up in some way. Does not fill me with trust and reconsidering if I trust this bank to handle my money.\",[1757474274,200000000],0,[\"Standard Chartered Bank PLC\",\"Hi TrainerHEZ, we apologize for the inconvenience caused. As we need more information to follow up on your case, please visit: sc.com/hk, tap the icon of Stacy, select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to connect with our live agent to further assist your case. Thank you. ~ Danny\",[1757577802,315000000]],null,[\"116862815673440101959\",\"TrainerHEZ\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUppXZhlttT0LvC45EUACLFzoomCwwEepA6CH6P5eVXK5Rd0og\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"9a8301cb-8f78-493c-9810-89d1d12b254a\",[\"M Lui\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXPloQmRhREoyHX4GLEzYzdL1Cz9ANRUsokVYeSFuUywBu4q3HJ-g\"]]],5,null,\"Excellent!\",[1756886365,14000000],0,[\"Standard Chartered Bank PLC\",\"Hi M Lui, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future and your continuous support. ~ Sara\",[1756893514,324000000]],null,[\"104838875215649096741\",\"M Lui\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXPloQmRhREoyHX4GLEzYzdL1Cz9ANRUsokVYeSFuUywBu4q3HJ-g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"2f3488f9-b51f-4dc5-853e-4b59db126b7f\",[\"Stephen Chong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJTiXJsH5l3ImJyfeIEeYnE0Kz-R2ZePvqEzwt24E3kG4lGbQ\\u003dmo\"]]],5,null,\"User Friendly app\",[1756784226,809000000],0,[\"Standard Chartered Bank PLC\",\"Hi Stephen Chong, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future and your continuous support. ~ Sara\",[1756804475,745000000]],null,[\"101114426137142415499\",\"Stephen Chong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJTiXJsH5l3ImJyfeIEeYnE0Kz-R2ZePvqEzwt24E3kG4lGbQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"cef1ee1e-c7dd-4901-b014-161cc3033d74\",[\"Sandeep T\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocImNcQTgL_8nSpZfTumVOTIEOpID_HBjFxOfNMEAzMrpIEC1_nj\\u003dmo\"]]],1,null,\"I'm confused is this a banking app or a marketing app I get more promotion then actual bill notifications\",[1756278539,628000000],0,[\"Standard Chartered Bank PLC\",\"Hi Sandeep Hathiramani, sorry for the unpleasant user experience. To turn off marketing offers notifications, please login to SC Mobile \\u003e Service \\u003e Communication Preferences \\u003e Marketing Offers \\u0026 Product Updates to disable the marketing notification. We will continue to optimize the SC Mobile App and look forward to your continuous support. ~ Danny\",[1756371143,505000000]],null,[\"112330514137471963213\",\"Sandeep T\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocImNcQTgL_8nSpZfTumVOTIEOpID_HBjFxOfNMEAzMrpIEC1_nj\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"131af3c5-9394-44e9-b58c-acabf791b98b\",[\"Martin Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLE9L-CW3hlbIRDEyeOGQqZ9xIAhoiW8VJfNTZodjLY1s-o0g\\u003dmo\"]]],1,null,\"could not use it to authorise my online purchase\",[1756195264,969000000],0,[\"Standard Chartered Bank PLC\",\"Hi Martin Chan, sorry for the unpleasant user experience. We will need more information to understand and follow up on your mentioned issue, please login your SC Mobile and go to “Contact \\u0026 Support” on the top right corner, tap “Chat” to connect with our Live Agent for further investigation and follow up. Thank you. ~ Danny\",[1756268118,20000000]],null,[\"102511770696639102399\",\"Martin Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLE9L-CW3hlbIRDEyeOGQqZ9xIAhoiW8VJfNTZodjLY1s-o0g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,null,null,1],[\"7d7de07a-a222-43fd-b244-aa10261a278d\",[\"M Y\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV2jZ88uNsezqtXfCKfH8U4b-0CoFwByAgOwptONVsZraO_j6rr\"]]],1,null,\"maintenance time unstable and keep extending. very annoying!\",[1755977345,245000000],0,null,null,[\"107117462791448411231\",\"M Y\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV2jZ88uNsezqtXfCKfH8U4b-0CoFwByAgOwptONVsZraO_j6rr\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]],[\"vaf_never_display_ads_experience\",null,[1]]]],null,null,null,1],[\"29330769-435a-435d-8863-48b479e8e4e9\",[\"K\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMKSDqKdegtTGWD5uxm0RRDYUhEh4mhXNXSo8dSL2t9cS4XRJT\"]]],1,null,\"信用卡交易紀錄不實時更新\",[1754942115,130000000],1,[\"Standard Chartered Bank PLC\",\"你好K，信用卡的商戶消費交易紀錄是可以實時於信用卡戶口查看，如果你的信用卡交易紀錄未能實時更新，請登入SC Mobile後點擊右上角的對話標誌選擇「聯絡及支援」圖示聯繫線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Carl\",[1755223510,441000000]],null,[\"108840597820871603073\",\"K\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMKSDqKdegtTGWD5uxm0RRDYUhEh4mhXNXSo8dSL2t9cS4XRJT\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"3dc1ea78-3dda-4698-ad7c-d534ea4fe2fd\",[\"Jeras Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIOrMhfRH7czOUIzR6bChJYlIcjpHmObnzLWWgWRa4YrcBwiA\\u003dmo\"]]],1,null,\"it is now compulsory to use this app to login, but I cannot login same as many other users who gave their review.\",[1754398744,512000000],0,[\"Standard Chartered Bank PLC\",\"Hi Jeras Leung, to ensure the security of online banking, logging into the web version of online banking now requires verification using SC Mobile Key. If your login issue persists, please visit : sc.com/hk, tap the icon of Stacy, to connect with our live agent. We’re here to assist you promptly. Thank you. ~ Sara\",[1754475186,632000000]],null,[\"101873134481229882045\",\"Jeras Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIOrMhfRH7czOUIzR6bChJYlIcjpHmObnzLWWgWRa4YrcBwiA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"34ce7653-dda0-4467-9c13-c8ab5d5e5f74\",[\"Louis Poon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUHxiWqT15TEZn8om-02W_XjEgdietEV3Kcz7E9qxMJre_hO5sB\"]]],1,null,\"After new updates, the application can no longer be opened and used in Samsung Secure Folder which I use it for all finance applications for extra safety. I don't understand why the new update forced me to use it outside of Secure Folder. This is not acceptable.\",[1754193907,570000000],3,[\"Standard Chartered Bank PLC\",\"Hi Louis Poon, we apologize for the inconvenience caused. For security enhancement, we have updated SC Mobile's security settings. Currently, SC Mobile app does not support being opened indirectly through other applications. Please move SC Mobile from the secure folder to the device's desktop to ensure optimal user experience. Thank you. ~ Sara\",[1754474818,651000000]],null,[\"117052111900278289314\",\"Louis Poon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUHxiWqT15TEZn8om-02W_XjEgdietEV3Kcz7E9qxMJre_hO5sB\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,null,null,1],[\"ae61af05-7849-4735-a93d-8c7bf67fceb0\",[\"Conor M\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJt_Z6anEwusMoocNvRdl-udqQqXWw6WCTdiR6S_Qv5Q9ifPw\\u003dmo\"]]],1,null,\"1 star is generous.\",[1753084572,716000000],2,[\"Standard Chartered Bank PLC\",\"Hi Conor McKenna, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Danny\",[1753178956,526000000]],null,[\"108437976856503991051\",\"Conor M\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJt_Z6anEwusMoocNvRdl-udqQqXWw6WCTdiR6S_Qv5Q9ifPw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"99d26bf9-421b-4bca-877a-5d7a15647799\",[\"Felix Liu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKbUhsusXp56wALE-S0ccEtBUOmOJI6OL8ZIpjDYdPtlA0LDw\\u003dmo\"]]],1,null,\"卡在terms \\u0026 conditions, 睇完每個tab 所有terms, 都不能夠繼續,卡住不能按accept, 垃圾app 答你個回應：你個app有bug 呀！睇完5個條款,全綠剔都無出現“接受”選項, 點繼續呀？！ 無左短訊密碼,app 又裝唔到,咁攪法即係鎖我網上理財, 怕左渣打, 我已經將所有錢轉左去匯豐了\",[1752742184,825000000],0,[\"Standard Chartered Bank PLC\",\"你好 Felix Liu，很抱歉未能為你帶來流暢的用戶體驗，為保障客戶安全，重設密碼期間一共有5項條款及細則需要查看，完成後上方會有綠色的剔表示已完成，同意後就可以按「接受」進入下一頁輸入用戶資料確認重設密碼，與此同時系統就會自動關閉SC MOBILE KEY 的設定。如你未能成功更改您的登入資料，你可以檢查及更新你嘅SC Mobile至最新版本7.6.11再嘗試。如果問題持續需要進一步的協助，你可以於渣打銀行網頁 sc.com/hk/zh 透過頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1752739618,639000000]],null,[\"100710318263661913105\",\"Felix Liu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKbUhsusXp56wALE-S0ccEtBUOmOJI6OL8ZIpjDYdPtlA0LDw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,[true,false],null,1],[\"91846713-e820-4da5-8895-337b9acd583e\",[\"Abdul Majad\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIEUruU7qPqHELYahzHGw41_eVzxJB1cZlNukEpwk9R35U27A\\u003dmo\"]]],5,null,\"ok\",[1752706156,149000000],0,[\"Standard Chartered Bank PLC\",\"Hello Abdul Majad, thank you for your feedback and support. We will continue to optimize the SC Mobile App to provide our customers with the best experience. ~ Danny\",[1752726878,201000000]],null,[\"104126250211500077857\",\"Abdul Majad\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIEUruU7qPqHELYahzHGw41_eVzxJB1cZlNukEpwk9R35U27A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"6ad361af-bbdc-4c46-993e-ac40dd7f80f6\",[\"Ice Cow\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXW8jnXWhmqrOGrUKoiL-n3CEIBke0Nd79S87A21eNIufc26B4v\"]]],1,null,\"Samsung security folder isn't third party features. SC banking is a rubbish app don't support security folder. If you don't fix it, I will close all SC bank accounts and credit cards. Don't copy and paste the rubbish answer to reply me.\",[1751875561,655000000],4,[\"Standard Chartered Bank PLC\",\"Hi Ice Cow, we apologize for the inconvenience caused. For security enhancement, we have updated SC Mobile's security settings. Currently, SC Mobile app does not support being opened indirectly through other applications. Please move SC Mobile from the secure folder to the device's desktop to ensure optimal user experience. Thank you. ~ Wes\",[1752215834,817000000]],null,[\"104314792191968487653\",\"Ice Cow\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXW8jnXWhmqrOGrUKoiL-n3CEIBke0Nd79S87A21eNIufc26B4v\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,[true,false],null,1],[\"c47230bf-7607-4849-a2cc-7ca4433369ec\",[\"YEUNG Lily\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIskgdMYMXZmsENG12ashY-FC_UJ5tEo5BFLp7M5qX9jjdnmA\\u003dmo\"]]],2,null,\"It is quite convenient to use.\",[1751849212,926000000],0,[\"Standard Chartered Bank PLC\",\"Hi YEUNG Lily, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Carl\",[1751882532,566000000]],null,[\"102781136717396744053\",\"YEUNG Lily\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIskgdMYMXZmsENG12ashY-FC_UJ5tEo5BFLp7M5qX9jjdnmA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"b28d5a74-045c-48dc-917d-cc3b0d018721\",[\"Yog\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIhaHUXkGGoIINffClJqvyHUCPsj5GxZFfjL-0-QJxswGt7YCg\\u003dmo\"]]],5,null,\"So Fast So Easy\",[1751704370,797000000],0,[\"Standard Chartered Bank PLC\",\"Hi Yog, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Carl\",[1751883362,821000000]],null,[\"101240701053496361806\",\"Yog\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIhaHUXkGGoIINffClJqvyHUCPsj5GxZFfjL-0-QJxswGt7YCg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"7c1cbf94-aad2-4927-bf82-454e863a526d\",[\"Olssen Yukie FIELIEN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJIjVavnPPfQDniFTk7yRCU1alqeGWRlw5Gshyqe_CMrlJJRyxU\\u003dmo\"]]],1,null,\"I have downloaded this apps and then created an accountant password because I wanted to open a bank account and after received the email it says that I should lock in to confirm it but I could not log in and it keeps transfer me to a page saying that I need to create a Bank ATM pin. I've been waiting for a call for 7 days and no any of their staff call me\",[1751604568,194000000],0,[\"Standard Chartered Bank PLC\",\"Hi Olssen Yukie FIELIEN, we apologize for the inconvenience caused. As we need more information to follow up on your case, please visit : sc.com/hk, tap the icon of Stacy, select \\\"Digital Banking\\\" \\u003e \\\"Login Related\\\" \\u003e \\\"I can't login to SC online banking\\\" to connect with our live agent to further assist your case. Thank you. ~ Sara\",[1752211724,417000000]],null,[\"113073450571331923409\",\"Olssen Yukie FIELIEN\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJIjVavnPPfQDniFTk7yRCU1alqeGWRlw5Gshyqe_CMrlJJRyxU\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"249a7f3f-1eca-4dea-a72b-fff772ab5459\",[\"Carmen Chayil Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_hA3iAP7QydoVLXW3SM-q-AQruaxiNqgFL-smhUJMfEhwjw\\u003dmo\"]]],2,null,\"Cannot login sometimes, cannot use FPS sometimes... 😔\",[1750740881,103000000],0,[\"Standard Chartered Bank PLC\",\"Hi Carmen Chayil Chan, sorry for any inconvenience caused. Please check if your SC Mobile is the latest 7.6.9 version. If the issue persists, Please visit our website sc.com/hk, and tap the icon of Stacy in the bottom right corner of the page to connect with our live agent. We will try our best to assist you to solve the issue. Thank you. ~ Wes\",[1750844471,62000000]],null,[\"110755998349154177721\",\"Carmen Chayil Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL_hA3iAP7QydoVLXW3SM-q-AQruaxiNqgFL-smhUJMfEhwjw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"e094930e-1b69-4ef5-b822-a5662e5f3f95\",[\"Sun C.\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVM5kRI9ixido_WsG-po1tRQfF7zChzjvKMOewN-EQh9p67Dowbyw\"]]],1,null,\"忘記密碼個條款碌極都㩒唔到\",[1749706504,95000000],0,[\"Standard Chartered Bank PLC\",\"你好 H.S. C.，很抱歉未能為你帶來流暢的用戶體驗，為保障客戶安全，重設密碼期間一共有5項條款及細則需要查看，完成後上方會有綠色的剔表示已完成，全部同意後就可以按「接受」進入下一頁輸入用戶資料確認重設密碼。如你未能成功更改您的登入資料，你可以檢查及更新你嘅SC Mobile至最新版本7.6.9再嘗試。如果問題持續需要進一步的協助，你可以於渣打銀行網頁 sc.com/hk/zh 透過頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Sara\",[1749785964,823000000]],null,[\"109264435570902658853\",\"Sun C.\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVM5kRI9ixido_WsG-po1tRQfF7zChzjvKMOewN-EQh9p67Dowbyw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"15bf316a-e09e-4771-aaea-3160b86c1c01\",[\"LIMBU PADAM SING\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK2jeTE1Cjz_rdEuNWKFHcKz_DJ0DM7hV-4tNoQHon0QEbwTmjy\\u003dmo\"]]],5,null,\"good\",[1749601565,477000000],0,[\"Standard Chartered Bank PLC\",\"Hi LIMBU PADAM SING, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Danny\",[1749622373,856000000]],null,[\"110076874056151620649\",\"LIMBU PADAM SING\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK2jeTE1Cjz_rdEuNWKFHcKz_DJ0DM7hV-4tNoQHon0QEbwTmjy\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"fe6bc98a-9e32-4422-a989-634d11f8cefe\",[\"Money Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLpPTuQ4uld0Lz3fyJ493AreGEIdtWKTfutTcxd5_xjBh8WGw\\u003dmo\"]]],5,null,\"is good 😊\",[1749084487,304000000],0,[\"Standard Chartered Bank PLC\",\"Hi Money Lee, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Danny\",[1749097057,502000000]],null,[\"106033506195795135419\",\"Money Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLpPTuQ4uld0Lz3fyJ493AreGEIdtWKTfutTcxd5_xjBh8WGw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.8\",null,null,null,null,null,1],[\"f5988527-9b25-41db-83c0-bf9025b87c1d\",[\"Kam Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW3Y1aolqDJJJFcVrpYhUGY5PLOs_aTlxvl-ei-lxQvexxAJ1Ql\"]]],1,null,\"user unfriendly. how do u open a mobile account if u have neither an ATM nor credit card?\",[1748444383,988000000],0,[\"Standard Chartered Bank PLC\",\"Hello Kam Leung, we are sorry for any inconvenience caused. If you do not have an ATM card right now, you can contact our customer service hotline (852) 2886 8888 to apply for an ATM card for online banking registration. Thank you. ~ Danny\",[1748586394,588000000]],null,[\"117681064782371166143\",\"Kam Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW3Y1aolqDJJJFcVrpYhUGY5PLOs_aTlxvl-ei-lxQvexxAJ1Ql\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.8\",null,null,null,null,null,1],[\"ab4289f3-bde0-42d7-8bf7-04e41bd1d6e5\",[\"Katherine Crawford\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLopnTV8PgvltNyZCcZFgcWbeQs89OXrSFGhP75m7SqAgOFOQ\\u003dmo\"]]],1,null,\"A terrible app that requires you to enable every single thing it wants and doesn't play nicely with anything else. After all this, it simply stops working without any indication why.\",[1748259275,900000000],2,[\"Standard Chartered Bank PLC\",\"Hi Katherine Crawford, sorry for any inconvenience caused. Please ensure your SC Mobile is the latest 7.6.8 version and connect with stable network. If the issue persists, please login and tap “Contact \\u0026 Support” at the top right corner to connect with our live agent for assist. We will also continuously update to improve user experience. ~ Danny\",[1748252069,607000000]],null,[\"112014732974321631685\",\"Katherine Crawford\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLopnTV8PgvltNyZCcZFgcWbeQs89OXrSFGhP75m7SqAgOFOQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.8\",null,null,null,[true,false],null,1],[\"f5ccf8ca-f307-4853-9c25-a7b879378d41\",[\"Sunce Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVSsxdpmHwX9SY42itYDdyiFRv6gWd1i3Dnw_4_nuOJTC4awEUF\"]]],1,null,\"This app used to be a good app. The old version is much better than the new version: 1. Every time I open the chat, it hangs and fails to connect. 2. The UI is worse than before; it's cluttered, and I can't find what I want to do. 3. The most basic function: I want to change the app language, but I still can't find where to set it after looking several times. 4. the screen capture function is really important for transportation.\",[1747612551,351000000],3,[\"Standard Chartered Bank PLC\",\"Hi Sunce Leung, sorry for the inconvenience caused. Please update to version 7.6.8 to enjoy better user experience. You can click “Help \\u0026 About Us” on the pre-login page and select “Language” for setting. Moreover, the screencap control enhancement is to protect customer e-banking from malware-related incidents. Thank you for understanding. ~ Wes\",[1748254288,967000000]],null,[\"103493637551066310044\",\"Sunce Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVSsxdpmHwX9SY42itYDdyiFRv6gWd1i3Dnw_4_nuOJTC4awEUF\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,[true,false],null,1],[\"c09272bb-0c0b-42bb-b3b0-f8fa0b378f4b\",[\"Kai Hei Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJBfRnz0kT5Kh4tD9BC0Oud4ObNnnZov9WmiZmpXY86O6Az-A\\u003dmo\"]]],1,null,\"(edited on 13 May)Unable to login to the mobile app in samsung secure folder, constantly said security warning with Code #1011. Please fix it Only Standard Chartered Bank app has an issue, and other bank app are still functioning. It is extremely unreasonable to ask user to adjust, when all financial app are in the secure folder. all are functional except for standard Chartered Bank.\",[1747116017,948000000],7,[\"Standard Chartered Bank PLC\",\"Hi Kai Hei Chan, for security enhancement, we have recently updated SC Mobile's security settings. Please move SC Mobile from the third-party secure folder to the device's desktop to ensure optimal user experience. If the issue still persists, please visit sc.com/hk/ and tap Stacy to connect with live agent for further follow-up. Thank you. ~ Sara\",[1747108337,174000000]],null,[\"104570132563981061206\",\"Kai Hei Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJBfRnz0kT5Kh4tD9BC0Oud4ObNnnZov9WmiZmpXY86O6Az-A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,[true,false],null,1],[\"30e5f72e-68d3-4617-b87a-8be2a56d3980\",[\"Leo Ye\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLdkbKR6kLRAMfeDrUiNOR92kbtGR1-RYUZ6wh7nBtJSaFgrA\\u003dmo\"]]],1,null,\"unable to continue last customer service chat, unable to check message received from last chat\",[1747065349,949000000],0,[\"Standard Chartered Bank PLC\",\"Hi Leo Ye, sorry for the inconvenience caused. Understand that your Live Chat services is unstable in SC Mobile currently, please log in online banking to view unread messages and continue enquiry with live agent as an alternative first. We will continue update SC Mobile to optimize user experience. We appreciate for your understanding. ~ Danny\",[1747276364,250000000]],null,[\"113322739671887804392\",\"Leo Ye\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLdkbKR6kLRAMfeDrUiNOR92kbtGR1-RYUZ6wh7nBtJSaFgrA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"63c4f289-710c-43e0-9463-565aa694c0cf\",[\"SaM Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUQ6UNxOm25VSD3fyWXvLqaKiwZ_wBsfcLRkjEppsH_KOqYjiI02g\"]]],3,null,\"was good, now freezes when trying to chat with help\",[1746892171,318000000],0,[\"Standard Chartered Bank PLC\",\"Hi SaM Wong, thank you for your valuable feedback. Understand that your Live Chat services is unstable in SC Mobile currently, please log in online banking to view unread messages and continue enquiry with live agent as an alternative first. We will continue update SC Mobile to improve user experience. We appreciate for your understanding. ~ Danny\",[1747275308,97000000]],null,[\"109856284997364462597\",\"SaM Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUQ6UNxOm25VSD3fyWXvLqaKiwZ_wBsfcLRkjEppsH_KOqYjiI02g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"842ed4d2-50d8-4add-92d0-2afcd8c6ebed\",[\"Clarence Ho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWgsIaoAU-DDVLqFbefAS_OyjC_yLxCFyjSb3RKQ_5N1kH90E2e\"]]],1,null,\"stopped working even after reinstalling\",[1746493069,658000000],2,[\"Standard Chartered Bank PLC\",\"Hello Clarence Ho, we apologize for your unpleasant experience. SC Mobile works normally now. If the issue still persists, please visit website: sc.com/hk/ and tap the icon of Stacy, in the bottom right corner to connect with live agent. We will try our best to understand and follow up your case. Thank you. ~ Wes\",[1746613357,523000000]],null,[\"109990432376417438714\",\"Clarence Ho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWgsIaoAU-DDVLqFbefAS_OyjC_yLxCFyjSb3RKQ_5N1kH90E2e\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"c0d1873a-1036-4da3-af28-a719a7fdef89\",[\"Sean MacKinnon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLNBKjmnmCE78eWvP0eMlZ0UpWurd7lXKvrNXOqQJjiGeTuQg\\u003dmo\"]]],2,null,\"I also have the issue it just hangs on the support page and there's no way out. been this way for a month or more, even though it says I have messages from an agent. I loved the app and the hk service which is why I continued banking there- but now I have zero access to service! is this a known issue\",[1746376866,73000000],1,[\"Standard Chartered Bank PLC\",\"Hello Sean MacKinnon, We are sorry for any inconvenience caused. Understand your Live Chat services is unstable in SC Mobile now, please log in online banking to view unread messages and continue enquiry with live agent as an alternative first. We will continue update SC Mobile to improve user experience. Thank you for your understanding. ~ Wes\",[1746613306,200000000]],null,[\"108241194853692166581\",\"Sean MacKinnon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLNBKjmnmCE78eWvP0eMlZ0UpWurd7lXKvrNXOqQJjiGeTuQg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"e2d69d47-d59a-4cac-b61e-0cb30177d253\",[\"CHRISTOPHER VAN DER LINDE\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWS-wop59B3TlH5s1_IszoHIzyxqK3pJt6RzAqZL29KMXZ-60-U\"]]],1,null,\"Terrible experience. I was assured for months by SCB staff that my account was safe—then it was suddenly closed without warning or explanation. Emails were ignored, hotline gave conflicting info, and I was forced to sell investments at a loss. Zero accountability or transparency. Avoid this bank.\",[1746190767,779000000],0,[\"Standard Chartered Bank PLC\",\"Hello CHRISTOPHER VAN DER LINDE, we apologized for the unpleasant experience. We need more information to understand and follow up on your case, please visit our official website : sc.com/hk, tap the icon of Stacy, in the bottom right corner of the page to connect with our live agent to further assist and follow up your case. Thank you. ~ Wes\",[1746613146,620000000]],null,[\"107312131455145736945\",\"CHRISTOPHER VAN DER LINDE\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWS-wop59B3TlH5s1_IszoHIzyxqK3pJt6RzAqZL29KMXZ-60-U\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"b589e6eb-c988-4bb5-a84e-e5635a23c346\",[\"Eric Tsang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW6LRArOSBVrA78Timp_q0Qabuj85EgG3sm-xULv14-S1_ORU85hw\"]]],1,null,\"Uninstalled due to the ugly rainbow logo.\",[1745382043,428000000],0,null,null,[\"115457687508855314265\",\"Eric Tsang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW6LRArOSBVrA78Timp_q0Qabuj85EgG3sm-xULv14-S1_ORU85hw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.6\",null,null,null,[true,false],null,1],[\"1e9d1ae4-3cd8-4098-aea5-e50c7897c8b6\",[\"dennis Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJeoL2zWdGzDJ9JL-5iVqEAlMLaOomQkA_g54SCObkpP1ZkiQ\\u003dmo\"]]],1,null,\"I have all my banking apps installed in the secure folder on my Galaxy phone included SC Mobile Singapore and SC Equities, but after updating to the latest version, I keep getting error only for SC Mobile Hongkong.\",[1745215825,147000000],2,[\"Standard Chartered Bank PLC\",\"Hi dennis Chan, we apologize for the unpleasant experience. We have released the latest version 7.6.5 of SC Mobile to enhancing user experience. If the issue persists, please login to online banking, tap the icon of Stacy in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1745312717,137000000]],null,[\"105405210248557391313\",\"dennis Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJeoL2zWdGzDJ9JL-5iVqEAlMLaOomQkA_g54SCObkpP1ZkiQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"049fb3c7-4d76-4aa6-bb68-588ff5030938\",[\"Herbert Kwong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIvuf_2TWNJOHwPYhHUNF9OKp61px4QJnJUvXe0ZKWtjO3aHQ\\u003dmo\"]]],1,null,\"unnecessarily tight security check on whatever apps are installed on my phone. used to work if i installed in another profile, this version stopped working entirely.\",[1744992419,84000000],1,null,null,[\"102582007579533814002\",\"Herbert Kwong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIvuf_2TWNJOHwPYhHUNF9OKp61px4QJnJUvXe0ZKWtjO3aHQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"78709f3b-c298-4d97-a17a-8d6fa83d04b5\",[\"HOMERSHK\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKhUsoK8q8tsBb5ssJ4eBz1PEcR5WrVt6xaSJV8_IwK6c1hfg\\u003dmo\"]]],5,null,\"beats most digital banking platforms\",[1744884447,9000000],0,[\"Standard Chartered Bank PLC\",\"Hi HOMERSHK, thank you for your valuable feedback. We are delighted to know that you are having a great experience, and we look forward to your continuous support. ~ Sara\",[1745312771,891000000]],null,[\"104775877036978052050\",\"HOMERSHK\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKhUsoK8q8tsBb5ssJ4eBz1PEcR5WrVt6xaSJV8_IwK6c1hfg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"1242ca57-ce25-443c-aa8b-f34f140b1fc1\",[\"George Tsang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL32CGlR7LVBKkpUohkgkiAWp27HrepoUEQJgXTSVeEoYtg-A\\u003dmo\"]]],1,null,\"I’ve been using the app without any issues until recently. I have all my banking apps installed in the secure folder on my Galaxy phone, but after updating to the latest version, I keep getting error #1101. I was informed that this update has broken support for the secure folder. Please address this issue as soon as possible.\",[1744873895,259000000],7,[\"Standard Chartered Bank PLC\",\"Hi George Tsang, for security enhancement, we have recently updated SC Mobile's security settings. Please move SC Mobile from the third-party secure folder to the device's desktop to ensure optimal user experience. If the issue still persists, please visit sc.com/hk/ and tap Stacy to connect with live agent for further follow-up. Thank you. ~ Sara\",[1746785996,347000000]],null,[\"103211811881189718653\",\"George Tsang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL32CGlR7LVBKkpUohkgkiAWp27HrepoUEQJgXTSVeEoYtg-A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"f692487c-33cd-42f7-9767-71aa59520b3e\",[\"Terry Lam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKGCYmU88NsNG2__EUtke0diX67WZr7Leo-TxtNQ1H0bprG8Q\\u003dmo\"]]],1,null,\"After updated the app on 2025-APR-12, I cannot login again. I got error cod #1011. cannot do FPS, cannot do scan payments Reply to developer: The app redirect to your error web page showing error #1011 whenever I tap to open the app. How can I login?\",[1744864156,690000000],2,[\"Standard Chartered Bank PLC\",\"Hello Terry Lam, we apologize for the inconvenience caused. As we need more information to understand and follow up on your case, please login to online banking, tap the icon of Stacy, our virtual assistance at the bottom right corner of the page to connect with our live agent. We will try our best to assist you to solve the issue. ~ Carl\",[1744862232,128000000]],null,[\"102062900547967267115\",\"Terry Lam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKGCYmU88NsNG2__EUtke0diX67WZr7Leo-TxtNQ1H0bprG8Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"da50595e-bd70-42cb-bf7a-e0769d48101b\",[\"Ian Lor\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBbOT34Rlybng6tYzuafWVz4hqj7vI2OKNEkNZzqdEfQCZH1I\"]]],1,null,\"This app used to be simple to use. Now bugs keep coming up. Double prompt of biometric login, if i scanned twice error ensues and i get logged out after just logging in. I have the app in my secure folder for many years, and it just works. Now when I open the app, it redirects to some security warning page. Why??? presumably it assumes my secure folder is a rooted device, which is the dumbest thing ever. So now I can't use the app at all, thanks.\",[1744703630,811000000],13,[\"Standard Chartered Bank PLC\",\"Hi Ian Lor, sorry for the inconvenience caused. We need more information to follow up and address the system issues you are facing. Please login to online banking, tap the icon of Stacy, our virtual assistance at the bottom right corner of the page to connect with our live agent. We will try our best to assist you. Thank you. ~ Wes\",[1745490250,889000000]],null,[\"116030435801840243553\",\"Ian Lor\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBbOT34Rlybng6tYzuafWVz4hqj7vI2OKNEkNZzqdEfQCZH1I\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"4f5d2b53-cd7a-4e19-81e1-2e8a994c1fde\",[\"Nur Huda Ismail\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKlHpXGAc9teb6wrIg0JnH1Q1qz6uIZyKJPMc8UYUeb2m9Pciq_\\u003dmo\"]]],1,null,\"the worst banking app. down due to maintenance during day time. having register biometric everytime. this app is just terribly bad!\",[1743511261,805000000],0,[\"Standard Chartered Bank PLC\",\"Hi Nur Huda Ismail, sorry for any inconvenience caused. Please check if your SC Mobile is the latest 7.6.4 version. We need more information to follow up on your case, please login to online banking, tap the icon of Stacy in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1743569599,482000000]],null,[\"101803383137601288785\",\"Nur Huda Ismail\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKlHpXGAc9teb6wrIg0JnH1Q1qz6uIZyKJPMc8UYUeb2m9Pciq_\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.4\",null,null,null,null,null,1],[\"a0299389-2f25-4ab5-9f25-71784f5966d7\",[\"CS Cheong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIPXV4AiLYJNAhVd1OREV2R2ryKOXiNkK0OAS9IAIGyOHKI8g\\u003dmo\"]]],1,null,\"Failed 3 4 times in a row for no obvious reason at all\",[1743348883,687000000],0,[\"Standard Chartered Bank PLC\",\"Hello CS Cheong, sorry for any inconvenience caused. Please check if your SC Mobile is the latest 7.6.4 version. We need more information to follow up on your case, please login to online banking, tap the icon of Stacy in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1743567266,242000000]],null,[\"110036872284440466243\",\"CS Cheong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIPXV4AiLYJNAhVd1OREV2R2ryKOXiNkK0OAS9IAIGyOHKI8g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.4\",null,null,null,null,null,1],[\"e539a1d3-cd82-440d-8ca8-9843837296f7\",[\"Andrea Mossetti\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLBM0woTJmF11dru8iH1jV2d3B2FhvFaAINXNVvr24DPnzBeA\\u003dmo\"]]],1,null,\"poor experience. setup fingerprint ID and app sometime makes you repeat login multiple times or deactivates the fingerprint making you have the reregister. sometimes take 4-5 attempt to log on\",[1743046743,369000000],0,[\"Standard Chartered Bank PLC\",\"Hi Andrea Mossetti., sorry for any inconvenience caused. Our latest version is 7.6.4 and currently operating normally. Please install the latest version and try again. If you encounter issues, please visit : sc.com/hk/ tap Stacy in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1743136413,898000000]],null,[\"100488429285879362131\",\"Andrea Mossetti\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLBM0woTJmF11dru8iH1jV2d3B2FhvFaAINXNVvr24DPnzBeA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.4\",null,null,null,null,null,1],[\"61f37548-6a55-4145-8164-8eb14398e12d\",[\"Sarath Nair\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJVR41xPzGlzEMget0cdMDehvWvvG-wHgY8h8znr1yYGacz0Q\\u003dmo\"]]],1,null,\"App doesn't work. Biometric login is broken. Scans fringer print, then asks for it gain, validates it and says someone is already logged in. Then proceeds log you off and disables biometric login. you need log on again using password and enable the thing again. how is this app even in production????\",[1742995817,194000000],0,[\"Standard Chartered Bank PLC\",\"Hi Sarath Nair, we apologize for the inconvenienced caused. As we need more information to understand and follow up on your case, you can visit our website : https://www.sc.com/hk/ and tap the icon of Stacy, in the bottom right corner of the page, to connect with our live agent. We will try our best to assist you. Thank you. ~ Danny\",[1741076429,973000000]],null,[\"100816542598498843146\",\"Sarath Nair\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJVR41xPzGlzEMget0cdMDehvWvvG-wHgY8h8znr1yYGacz0Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.4\",null,null,null,[true,false],null,1],[\"ad11d6c5-ec6d-43d6-8fbe-8d7087984a6a\",[\"KT Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIBsR_VjpoMqBo00y9JKWGZA0wsR33E0vMA1fM8iVAVxYT0_w\\u003dmo\"]]],1,null,\"Used to be good, but after recent update, cannot login in (keep asking to set mobile key and fail, even with correct email \\u0026 phone otp, ridiculous!! ), pls fix bugs or revert to previous version.\",[1742992192,751000000],0,[\"Standard Chartered Bank PLC\",\"Hi KT Chan, sorry for any inconvenience caused. Our latest version is 7.6.4 and currently operating normally. We need more information to follow up on your case, please login to online banking, tap the icon of Stacy in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1743136571,632000000]],null,[\"100182858879106715980\",\"KT Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIBsR_VjpoMqBo00y9JKWGZA0wsR33E0vMA1fM8iVAVxYT0_w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"935e3a7b-a89a-47e2-82b5-96c2dfe76f15\",[\"Brendan M\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJY0j7j5gZkckFdqCuhXpL8l9OLIMAK6sIV_603FCiRuV7PA3s\\u003dmo\"]]],1,null,\"Current version just hangs on support chat page and cannot exit or take any action, I've needed to enroll in biometrics 3 times this week and just gets wiped, and cannot paste in password from password manager.\",[1742911824,99000000],1,[\"Standard Chartered Bank PLC\",\"Hello Brendan M, we apologize for the inconvenienced caused. Due to security reason, we do not support password manager. For the login issue, you can try reinstalling the app, if the issue still persist, please visit our website: sc.com/hk/ and tap the icon of Stacy to connect with our live agent. We will try our best to assist you. ~ Danny\",[1742983298,72000000]],null,[\"100784358284680908201\",\"Brendan M\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJY0j7j5gZkckFdqCuhXpL8l9OLIMAK6sIV_603FCiRuV7PA3s\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.4\",null,null,null,null,null,1],[\"c87eca37-20a9-4d14-a8a6-91486ef493bc\",[\"Brian Lo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKQNg_Gcnc9K7GgAOzyHmGCBeXVywKy8IF5EYiMYRRb8yhg9A\\u003dmo\"]]],1,null,\"poor responsiveness, stuck at SC Mobile Key Verification,\",[1742271193,185000000],0,[\"Standard Chartered Bank PLC\",\"Hi Brian Lo, sorry for any inconvenience caused. Email and SMS OTP would be sent to registered email and mobile during SC Mobile Key set up. If you don’t receive OTP, you can visit our website : sc.com/hk and tap Stacy, in the bottom right corner, to connect with our live agent. Our Live agent will try our best to assist you. Thank you. ~ Wes\",[1742361551,471000000]],null,[\"110895414808692020612\",\"Brian Lo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKQNg_Gcnc9K7GgAOzyHmGCBeXVywKy8IF5EYiMYRRb8yhg9A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"ee95d003-57d4-44c6-b756-5466e4a2e07f\",[\"Honor At\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK5ajx1l7UK20pS_ZhMYlTGysL7B-BmrADYUKnO4NbeHeGG1A\\u003dmo\"]]],1,null,\"Recent update keeps hanging, and have issues with the Biometric login. Please fix.\",[1741621828,221000000],0,[\"Standard Chartered Bank PLC\",\"Hi Honor At, we are sorry for your unpleasant experience. SC Mobile is currently operating normally. Please check whether your SC Mobile is the latest version and connected to a stable network. You can download the latest APK file on our website: sc.com/hk/zh/bank-with-us/app-sc-mobile/apk-download/. Please try to log in again. Thank you. ~ Sara\",[1741938424,861000000]],null,[\"108613072506392355115\",\"Honor At\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK5ajx1l7UK20pS_ZhMYlTGysL7B-BmrADYUKnO4NbeHeGG1A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"487e6845-3d60-4c04-a1fc-006e088fe7c8\",[\"CY L\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJQgHr2CrLFFdoaWy8lY7LudKyzwXsyRpGLqP2-n99eCQeXXIuZ\\u003dmo\"]]],1,null,\"Stuck on the login page. the latest app update seems to have killed the app.\",[1741593264,391000000],1,null,null,[\"103066859811279527271\",\"CY L\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJQgHr2CrLFFdoaWy8lY7LudKyzwXsyRpGLqP2-n99eCQeXXIuZ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.3\",null,null,null,null,null,1],[\"6f13652e-7b5e-46b3-b929-14cd18b1a24e\",[\"Kabilan Poongundran\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXarfDlF-Md6Wu7679hfX_Cux_lbnnF3RSed4T92xAIXEe22Xow\"]]],5,null,\"\\\"This app is great for checking balances, but it needs further improvements. Specifically, the account opening feature has issues. Every time I try to open an account and take a picture of my HKID, the app crashes. Fixing this would make the app much more reliable.\\\" Edit : After following the instructions from the comment below, it worked well. Thank you\",[1741319376,706000000],2,[\"Standard Chartered Bank PLC\",\"Hi Kabilan Poongundran, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. You might consider reinstalling the app and try to register again to apply bank account opening. ~ Danny\",[1740018637,252000000]],null,[\"112606959023032445776\",\"Kabilan Poongundran\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXarfDlF-Md6Wu7679hfX_Cux_lbnnF3RSed4T92xAIXEe22Xow\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"b97f9cdd-9608-4fe1-b7b4-76f92a017f8e\",[\"Aaron Hobday\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWJIBOBd4PFgQJpfBGldKZ3BMWBHREJ3b888urail_I93YWrtbg\"]]],1,null,\"Absolute rubbish. You have to constantly keep registering for biometric ID, and the app forgets your username and password. Even when you uninstall and reinstall the app, the problems still persist. The SC mobile key keeps logging you out, and you have to keep re-registering, and agreeing to let the app spam you with adverts. I'll be moving my HK bank account as a result of this and banking elsewhere.\",[1740664547,768000000],3,[\"Standard Chartered Bank PLC\",\"Hello Aaron Hobday, we apologize for the inconvenienced caused. You can try reinstalling the app, if the same issue still persist, please visit our website: sc.com/hk/ and tap the icon of Stacy, in the bottom right corner of the page to connect with our live agent. We will try our best to assist you. Thank you. ~ Danny\",[1740647789,895000000]],null,[\"114039228484787972869\",\"Aaron Hobday\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWJIBOBd4PFgQJpfBGldKZ3BMWBHREJ3b888urail_I93YWrtbg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.3\",null,null,null,[true,false],null,1],[\"03e3262a-8cdb-435d-81b1-6846bab09cb7\",[\"khuenhin hoo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIsqLr91Q-5tGh_8YEEOnXNwvsSZzp2A4IP6fx5jhNmwIke4g\\u003dmo\"]]],1,null,\"keeps on crashing on my galazy z fold 6. log in page keeps crashing\",[1740444011,856000000],0,[\"Standard Chartered Bank PLC\",\"Hello khuenhin hoo, we apologize for the inconvenienced caused. You can try reinstalling the app, if the same issue persist, please visit our website: sc.com/hk/ and tap the icon of Stacy, in the bottom right corner of the page to connect with our live agent. We will try our best to assist you. Thank you. ~ Sara\",[1740561468,441000000]],null,[\"110722899137732620349\",\"khuenhin hoo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIsqLr91Q-5tGh_8YEEOnXNwvsSZzp2A4IP6fx5jhNmwIke4g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.3\",null,null,null,null,null,1],[\"41287ee0-8625-4fe8-b716-efaf843c405b\",[\"Roy McCoy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLtCTCW6ZcUQa1f0pYg2K9wnsYdIytFKBXZafiYgZPVZrPWBQ\\u003dmo\"]]],1,null,\"Keep logging me out with the biometric log in, like 3 times in 4 weeks, need to register repeatedly\",[1740370155,156000000],0,[\"Standard Chartered Bank PLC\",\"Hello Roy McCoy, we apologize for the inconvenience caused. As we need more information to follow up, you can visit: sc.com/hk and tap the icon of Stacy, or login to the latest version of SC Mobile App and tap “Contact \\u0026 Support” in the top right corner to connect with our live agent. We will try our best to assist you. Thank you. ~ Danny\",[1740618910,492000000]],null,[\"112498023219107492954\",\"Roy McCoy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLtCTCW6ZcUQa1f0pYg2K9wnsYdIytFKBXZafiYgZPVZrPWBQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.3\",null,null,null,[true,false],null,1],[\"7ac72525-6329-4313-b749-77e81d2bc38d\",[\"Robin Janssens\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIw9tnY4phcX8kW-SOCD34RNN_TI8nPYu3SgwFA7NMoV3Aj4BWx\\u003dmo\"]]],1,null,\"Mobile Security Key gets wiped every time the app updates\",[1739803112,950000000],0,[\"Standard Chartered Bank PLC\",\"Hi Robin Janssens, we apologize for the inconvenienced caused. As we need more detail to follow up on your case, you can visit: sc.com/hk/ and tap the Stacy icon, or login to the latest version of SC Mobile App and tap “Contact \\u0026 Support” in the top right corner to connect with our live agent. We will try our best to assist you. Thank you. ~ Danny\",[1740018843,362000000]],null,[\"117579496633740650876\",\"Robin Janssens\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIw9tnY4phcX8kW-SOCD34RNN_TI8nPYu3SgwFA7NMoV3Aj4BWx\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,[true,false],null,1],[\"669cada7-3f84-4276-8ffc-582bd1afc8c0\",[\"Daniel Pieter\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUygPJjQ95g0ngCFCCu1lQZKL-RD3CmLD_VJcH3FlAWcEpwJOrT\"]]],1,null,\"The app keeps asking me to register for biometric verification every, single, time. This is unacceptable. Just how many times do I need to register before you stop asking me to register? FYI, this only became a problem in the past 1 mth, prolly a bug or something when the app was upgraded. Very disappointing.\",[1739763235,80000000],2,[\"Standard Chartered Bank PLC\",\"Hi Daniel Pieter, we apologize for the inconvenienced caused and this is not our expected flow. As we need more information to understand and follow up, please log in to the latest version of SC Mobile App and tap “Contact \\u0026 Support” in the top right corner to connect with our live agent. We will try our best to assist you. Thank you. ~ Danny\",[1740019123,562000000]],null,[\"103383426765470761637\",\"Daniel Pieter\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUygPJjQ95g0ngCFCCu1lQZKL-RD3CmLD_VJcH3FlAWcEpwJOrT\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"b9a28cd6-0ece-4160-961a-c5ea68d0190c\",[\"Solutions Pointer\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtkcJqsyA2l2tLNljoSwMGD20uD9co09RVgKyRJT4UPks3_w\\u003dmo\"]]],5,null,\"Good\",[1739586782,384000000],0,[\"Standard Chartered Bank PLC\",\"Hello Solutions Pointer, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future and your continuous support. ~ Danny\",[1740018946,169000000]],null,[\"112068669245858360906\",\"Solutions Pointer\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtkcJqsyA2l2tLNljoSwMGD20uD9co09RVgKyRJT4UPks3_w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"777b3c61-b1a0-4e2e-aff8-22d54404262b\",[\"Stephen Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU2HdXu3qwrONgAuDuZk-1nfZGsd1Wva8d4cp9lA2Bn7wd9qNPI\"]]],1,null,\"Got stuck even on the first page and won't proceed.\",[1738831690,329000000],0,[\"Standard Chartered Bank PLC\",\"Hi Stephen Chan, we apologize for the inconvenienced caused. SC Mobile is currently operating normally. Please try to login again. In case you encounter issues, please visit website : sc.com/hk/ tap Stacy, our virtual assistance in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1738923465,446000000]],null,[\"108155304660250069400\",\"Stephen Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU2HdXu3qwrONgAuDuZk-1nfZGsd1Wva8d4cp9lA2Bn7wd9qNPI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"5b13fd09-9202-4901-830a-f17fa8d03e4e\",[\"Kommal S Balani\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWDYrBzmR6he12H55x2x2n8L30ltA18LJiPE0SaUA20H1VJLm0tuw\"]]],2,null,\"Login problem it's stuck\",[1738824503,743000000],0,[\"Standard Chartered Bank PLC\",\"Hello Kommal S Balani, we apologize for the inconvenienced caused. SC Mobile is currently operating normally. Please log in again. In case you encounter issues, please visit website : sc.com/hk/ tap Stacy, our virtual assistance in the bottom right corner to connect with our live agent. We will try our best to assist you to solve the issue. ~ Sara\",[1738923434,660000000]],null,[\"108537435894073750035\",\"Kommal S Balani\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWDYrBzmR6he12H55x2x2n8L30ltA18LJiPE0SaUA20H1VJLm0tuw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"94f99799-ac83-4f88-986c-4cb8529b87c4\",[\"buddhajesuschrist\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXzpjUgAQLheIuWZwwEM_Y1aTTlFsWMkm_mYHGRKkOwYp0XpvU\"]]],4,null,\"介面改善了，沒有hang 機\",[1738475529,720000000],0,[\"Standard Chartered Bank PLC\",\"你好 buddhajesuschrist，多謝你的支持，我們會繼續改進並致力為客戶提供更佳的服務，並期待獲得你的持續支持和鼓勵。 ~ Sara\\n\\n\",[1738923331,598000000]],null,[\"104695208116709334727\",\"buddhajesuschrist\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXzpjUgAQLheIuWZwwEM_Y1aTTlFsWMkm_mYHGRKkOwYp0XpvU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"e688d5d0-16b3-4bb4-bbc8-29f5730be0a3\",[\"Hello SUN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJno26--rJvJbMXcEQlziNyg_bMSg8vvpvq-nYyTMpUNzaEPQ\\u003dmo\"]]],5,null,\"good mobile bank\",[1738384957,893000000],0,[\"Standard Chartered Bank PLC\",\"Hello Hello SUN, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future. Your support means a lot to us! ~ Sara\",[1738923292,960000000]],null,[\"100407934300450290993\",\"Hello SUN\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJno26--rJvJbMXcEQlziNyg_bMSg8vvpvq-nYyTMpUNzaEPQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"bcf0cc7a-26e3-4ae1-b900-56e716e56853\",[\"Horne FAMILY\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVmTQXEvRkvj8YMSTUEqSXhv1N03xw-jeUgb63WGP8C99v439F7gA\"]]],5,null,\"easy to use\",[1738368995,962000000],0,[\"Standard Chartered Bank PLC\",\"Hello Horne FAMILY., thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future. Your support means a lot to us! ~ Sara\",[1738923199,962000000]],null,[\"100750997003777083563\",\"Horne FAMILY\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVmTQXEvRkvj8YMSTUEqSXhv1N03xw-jeUgb63WGP8C99v439F7gA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.2\",null,null,null,null,null,1],[\"88b7dd46-f509-4894-bf49-d347c1e3775e\",[\"西涼太守\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWSHCg-7_6X1Fb524wFhy5E5yPXEHAn9r9iDq0qGU-RwsxXeoi5eaBuBQ\"]]],1,null,\"彈App 或 freeze，or both。。銀行app中最圾垃\",[1737974479,646000000],0,[\"Standard Chartered Bank PLC\",\"你好西涼太守，抱歉為你帶來不便，SC Mobile 目前操作正常，暫時未有異常情況。如你嘅SC Mobile持續有不穩定情況，請確保已連接穩定網絡及已安裝最新版本嘅SC Mobile。若有需要進一步協助，你可於渣打銀行網頁sc.com/hk/zh 右下角，透過智能助理Stacy與我哋線上客戶服務顧問聯絡跟進，謝謝。 ~ Carl\",[1738057001,690000000]],null,[\"106534079985686055181\",\"西涼太守\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWSHCg-7_6X1Fb524wFhy5E5yPXEHAn9r9iDq0qGU-RwsxXeoi5eaBuBQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"18416873-8925-4d65-9f10-414e1aa69408\",[\"Spare Reg\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIQoDTCf0vz6ErUdO9RQeKzEOANxtvbNRnSrv9qGcQ3AlFX1Q\\u003dmo\"]]],1,null,\"The chat can't be used for months. Got notification bubble. When I click that open, I either get redirected to agents that keep telling me they can't retrieve my login info, or get put on hold on the loading screen, ending up shown a connection issue. The suggestion from SC was to use only e-banking. I don't need to talk to any agent but want to check the unread messages. How do I get logged out if I can only open the chat feature via my logged in mobile app... Frustrating\",[1737864054,161000000],12,[\"Standard Chartered Bank PLC\",\"Hello Spare Reg. We are sorry for any inconvenience caused. Understand your Live Chat services is unstable in SC Mobile currently, please log in online banking to view unread messages and continue enquiry with live agent as an alternative first. We will continue update SC Mobile to improve user experience. Thank you for your understanding. ~ Wes\",[1738556098,172000000]],null,[\"113106281408968908451\",\"Spare Reg\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIQoDTCf0vz6ErUdO9RQeKzEOANxtvbNRnSrv9qGcQ3AlFX1Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"50a3ac36-e95f-44f0-b509-22607256da3a\",[\"RAJ SAXENA\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXq7RomCM5zYe-DjCiXdV1Lm76xSdop0hucxdkWEJsX4rxZMYOh4A\"]]],3,null,\"Can someone help me with changing the app notifications from traditional Chinese to English ? After an update was pushed , I'm not able to change the language of notifications. Please help :)\",[1737548502,44000000],0,[\"Standard Chartered Bank PLC\",\"Hello RAJ SAXENA, as this is a third-party platform, if you need to change promotion notification language, please visit our website: https://www.sc.com/hk/ and login your online banking, tap the icon of Stacy, our virtual assistance in the bottom right corner of the page to connect with our live agent to apply changing default language. ~ Carl\",[1738057362,506000000]],null,[\"113216455979612294683\",\"RAJ SAXENA\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXq7RomCM5zYe-DjCiXdV1Lm76xSdop0hucxdkWEJsX4rxZMYOh4A\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.1\",null,null,null,[true,false],null,1],[\"e97ea1e0-3811-4d2f-b84e-6274077599fc\",[\"Kim Lun WONG\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKn1xGlbIBBiKt8JC2I7XbEL4237lXumYqVWrS51Ra8I066NU4\\u003dmo\"]]],4,null,\"Normal\",[1736980723,104000000],0,[\"Standard Chartered Bank PLC\",\"Hi Kim Lun WONG, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience. ~ Danny\",[1737021660,426000000]],null,[\"110938585093761662231\",\"Kim Lun WONG\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKn1xGlbIBBiKt8JC2I7XbEL4237lXumYqVWrS51Ra8I066NU4\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"8a9d6d97-d8c3-49ea-bcfc-0d0430bbfed7\",[\"JY L\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVG2WNJNDN-ysUl72i5B3zNEDeJ_VKAVzU5e_Cd4HiJ7u64s9I\"]]],1,null,\"terrible interface\",[1736731082,855000000],0,[\"Standard Chartered Bank PLC\",\"Hi JY L, we are sorry for your unpleasant experience recently. We will also continue to optimize the SC Mobile App to improve the user experience. We look forward to your continued support. Thank you. ~ Sara\",[1736819847,643000000]],null,[\"101632451515021101643\",\"JY L\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVG2WNJNDN-ysUl72i5B3zNEDeJ_VKAVzU5e_Cd4HiJ7u64s9I\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"89d21370-9996-4048-96ca-343e1c78bafb\",[\"Lester\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWsto8ZWF-IpesNNb0iJZ0xDq2N9eDWNY7MW2VC2PtiwRbZa3TPNQ\"]]],5,null,\"Good\",[1736316406,907000000],0,[\"Standard Chartered Bank PLC\",\"Hi Lester, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience. ~ Danny\",[1736318545,150000000]],null,[\"109867299156495630647\",\"Lester\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWsto8ZWF-IpesNNb0iJZ0xDq2N9eDWNY7MW2VC2PtiwRbZa3TPNQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.1\",null,null,null,null,null,1],[\"2d125ce8-c5e3-40a1-b747-13ef62c5c2b2\",[\"Marco Lau\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU_dWQqxCu6gd7M_u4vMNntzsxKBtUKZ-luFJEBZVw5hn7W7q_b\"]]],2,null,\"A facade. All looks but not functional. I was told to stop using phone support and use the chat function. Stacy doesn't give me the answer I want and whenever I try to connect to a live agent the app just crashes. It's hard to get help from this app.\",[1735804444,347000000],1,[\"Standard Chartered Bank PLC\",\"Hi Marco Lau, sorry for the inconvenience caused. Please try to update your SC Mobile to the latest version 7.6.1 and chat with our Live Agent via Contact \\u0026 Support. If the issue still persists, please visit our website sc.com/hk/ tap the icon of Stacy to connect with our live agent. We will try our best to assist you to solve the issue. ~ Wes\",[1735899160,583000000]],null,[\"105689699393409235158\",\"Marco Lau\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU_dWQqxCu6gd7M_u4vMNntzsxKBtUKZ-luFJEBZVw5hn7W7q_b\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.1\",null,null,null,null,null,1],[\"4e4fff0d-cf7d-4194-bdcd-964e623e8310\",[\"David Hunter\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIo667laP7FAFLHPnQ5L9IzBqErp2xt9tHtMBlD8fuWDyFFqw\\u003dmo\"]]],5,null,\"Very good app\",[1735452672,591000000],0,[\"Standard Chartered Bank PLC\",\"Hello David Hunter, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future. Your support means a lot to us! ~ Danny\",[1735548864,253000000]],null,[\"103121450970145458561\",\"David Hunter\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIo667laP7FAFLHPnQ5L9IzBqErp2xt9tHtMBlD8fuWDyFFqw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.0\",null,null,null,null,null,1],[\"4f3843f3-373e-4e94-b3be-8464aeba9472\",[\"TK HO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-SvmwLyEtjB4WNgdGdXjoo8nauos8oRn19_5xl2h4Mm5tTw\\u003dmo\"]]],1,null,\"Rubbish app, always failed to login via 2fa, waste my time every time\",[1734893456,838000000],0,null,null,[\"116761880517571211720\",\"TK HO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-SvmwLyEtjB4WNgdGdXjoo8nauos8oRn19_5xl2h4Mm5tTw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"9309bcea-7cae-4013-82e1-5f60b8d93d90\",[\"Jack Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIb7dctmNCY3_NNNwYW-8LtjzEWqcsVwJGfJefbyb2JYdEuIg\\u003dmo\"]]],1,null,\"What we need is Jesus Christ to help me remove the inevitable glare on my hkid. And you made me realize my valid hkid is invalid\",[1734785632,322000000],0,[\"Standard Chartered Bank PLC\",\"Hi Jack Yeung, sorry for the inconvenience caused. Please ensure your HKID is in focus, not reflecting a light source or blocked by shadows, and indoor environment is not too dark. If an invalid HKID is detected, you can visit our website\\u003e Service \\u003e branch service to schedule an appointment and visit to our branch for account opening. ~ Danny\",[1734932800,319000000]],null,[\"111508788890031571631\",\"Jack Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIb7dctmNCY3_NNNwYW-8LtjzEWqcsVwJGfJefbyb2JYdEuIg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,null,null,[true,false],null,1],[\"27597888-e844-4822-a36c-6fdf31c06a16\",[\"petelee hk\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVXhf0Q6Sl5CIwYieJnahRhpIfn3kAGX1jbcKp9wnVzOIMqCPoh\"]]],1,null,\"Freezes on log in page. Update 13.12.2024 I have uninstalled the app and reinstalled it on my Android phone. It now freezes on the \\\"Choose your language\\\" screen, and I can go no further. This means I am unable to log in to internet banking as I have to 'approve' such activity via the SC Mobile app.\",[1734106057,552000000],0,[\"Standard Chartered Bank PLC\",\"Hi petelee hk, we apologize for the inconvenience caused. As we need more information to understand and follow up on your case, please login to online banking, tap the icon of Stacy, our virtual assistance at the bottom right corner of the page and connect with our live agent. We will try our best to assist you to solve the issue. ~ Carl\",[1729489682,311000000]],null,[\"110867918101769074871\",\"petelee hk\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVXhf0Q6Sl5CIwYieJnahRhpIfn3kAGX1jbcKp9wnVzOIMqCPoh\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.0\",null,null,null,[true,false],null,1],[\"6b2c8601-0e04-4a65-876c-88816abfa068\",[\"Holger Freyther\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKrAnM5CVFWYLBcoKijietk3haItfzsJ0vERuQMDb47-q78Eg\\u003dmo\"]]],1,null,\"It is a decent app and can be used to do the daily banking. The annoyances leading to one star are: * Logging in on mobile logs the desktop session out * A past transaction can not be repeated * No payment slip with the reference number can be shared. The application forbids screenshots and doesn't have a substitute. Resp: Merchants request payment slips in HK. If taking a screenshot is too \\\"insecure\\\", then provide an alternative like creating a pdf from a transaction.\",[1733272029,27000000],1,[\"Standard Chartered Bank PLC\",\"Hi Holger Freythern, sorry for any inconvenience caused. With the rise of malware related incidents, our bank has increased its security controls to protect customers. To further assist you, please log in to the app, go to “Contact \\u0026 Support” in the top right corner, tap “Chat” to connect with our online customer service representative. ～Sara\",[1733212124,5000000]],null,[\"115466686864478290618\",\"Holger Freyther\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKrAnM5CVFWYLBcoKijietk3haItfzsJ0vERuQMDb47-q78Eg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,null,null,[true,false],null,1],[\"eb699fee-914a-4efc-ad79-2d9be6a385da\",[\"Manqoba Xulu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJEo05oT31-pvKhYChUb7B3rC7Q5PD7K0oAUo-nIEvwXY8kOQ\\u003dmo\"]]],5,null,\"🌟🌟🌟🌟🌟\",[1733267528,61000000],0,[\"Standard Chartered Bank PLC\",\"Hello Manqoba Xulu, thank you for your 5 stars comment. We are delighted to know that you are having a great experience. We anticipate to deliver quality services in the future and your continuous support. ~ Wes\",[1733385801,980000000]],null,[\"111744535365359422595\",\"Manqoba Xulu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJEo05oT31-pvKhYChUb7B3rC7Q5PD7K0oAUo-nIEvwXY8kOQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"13b6e60e-0ff0-4cd5-a855-43a2bf7b4375\",[\"Rupen Shah\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUY-WrSvz1ePWJkDU6UGe3PB9U-E_dvY_WcvzBq0CYE0uUm9zPyQ\"]]],3,null,\"Please provide a proper way to share payment confirmation with receipt information rather the pointless GIFs which are useless.\",[1732865978,570000000],12,[\"Standard Chartered Bank PLC\",\"Hi Rupen Shah, this is not the experience we would like you to have. Due to further protect you and as a measure to enhance security, there is no longer be able to bind your Standard Chartered credit card to Google Pay wallet until further notice. Sorry for any inconvenience cause. ~ Alice\",[1701410452,85000000]],null,[\"116262878414155790541\",\"Rupen Shah\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVUY-WrSvz1ePWJkDU6UGe3PB9U-E_dvY_WcvzBq0CYE0uUm9zPyQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.5.6\",null,[[[\"vaf_phase1_investing\",[2]],[\"vaf_phase1_see_multiple_accounts\",[1]],[\"vaf_phase1_managing_credit_cards\",[2]]]],null,null,null,1],[\"b714c081-47e3-4425-9b1c-bb2b25dde04c\",[\"WY Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWUM4ZJP1Hldl9k0uEta_YdVwk3VrPY9KtpMuCJWWe30PyrxECb\"]]],2,null,\"Can't register for SC Mobile Key\",[1732441403,29000000],0,[\"Standard Chartered Bank PLC\",\"Hello WY Yeung, we apologize for any inconvenience caused. We need more information to understand and follow up on your case, please visit www.sc.com/hk tap the icon of Stacy, our virtual assistance in the bottom right corner of the page and connect with our live agent. We will try our best to assist you to solve the issue. ~ Wes\",[1732673469,785000000]],null,[\"111747867309651919890\",\"WY Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWUM4ZJP1Hldl9k0uEta_YdVwk3VrPY9KtpMuCJWWe30PyrxECb\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"6f2b92e7-67cc-4