n Fong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIIp7L63D66YeUVMmfixWJGSsoW6H6aoC0Zw_9207f64lUUTQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.10\",null,null,null,[true,false],null,1],[\"cae1fd7b-31fa-45b9-b80a-1645f3e0b250\",[\"Koko Mueller\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIua-ZIpTTDUKj0DUzAAm5gD2i3kQKi3XCLgCZ7S4LeO1dF4w\\u003dmo\"]]],1,null,\"BRING BACK SCREENSHOTS! Absolutely ridiculous that this is now blocked. I screenshot all my payments for record and sharing. What a pain now! Lousy lousy lousy.\",[1700573091,485000000],1,null,null,[\"103198551147350062663\",\"Koko Mueller\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIua-ZIpTTDUKj0DUzAAm5gD2i3kQKi3XCLgCZ7S4LeO1dF4w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.10\",null,null,null,null,null,1],[\"4755a349-b5f4-4649-b9a6-6f1cb7236869\",[\"Melchior Fung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJUfBHm_WBOMzzKoT7tsxW4BSNz2SibHWdY5SHRZ35gKiwsIA\\u003dmo\"]]],1,null,\"The latest updates of app no longer support cap screen upon transaction complete is disappointing. Where more frustrating is, there were no options at all to share transaction details on the completed transaction page as well. The whole point of the ebanking app was to serve clients with convenience but not compromising security. This update totally reversed the whole concept, and clients have to annihilate our own convenience and more privacy to serve the bank inconsiderate security settings.\",[1700568815,650000000],28,null,null,[\"100854683476000038496\",\"Melchior Fung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/AC