9fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"41ad8a88-c607-4411-a9d3-d705b1cc9003\",[\"Alex Yuen\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKMEWNYfFjB2OBWi04ze3XAANb4pBENeESpt3uUW50JtGS6cw\\u003dmo\"]]],1,null,\"You can't screenshot in this app. And you don't get receipt for payment either. Really poor app design.\",[1700120784,750000000],0,null,null,[\"113888247937069071989\",\"Alex Yuen\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKMEWNYfFjB2OBWi04ze3XAANb4pBENeESpt3uUW50JtGS6cw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"2f0c1c16-d79e-4645-8330-82fa98aa6883\",[\"Baris\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLGuFvRj1-EiKcGEze6uEf4A42SUdqjt_d2FrtGCxMMWuDxiA\\u003dmo\"]]],1,null,\"It was a good app until they blocked the screenshot function with the new update. Pretty useless now when you do FPS and need the screenshot.\",[1700120734,924000000],5,null,null,[\"114773726410957059341\",\"Baris\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLGuFvRj1-EiKcGEze6uEf4A42SUdqjt_d2FrtGCxMMWuDxiA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,[true,false],null,1],[\"a106919e-7ac9-4fc7-a90e-9042187b0680\",[\"Andy Ng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJwgK9DA0nL1BXqMJAhbvTDhcvGoboOiUcls_SVq6SGRa_saQ\\u003dmo\"]]],1,null,\"希望大家一人一信， 吊7匯豐。 我信都幫你作埋， 你照抄就可以。 ************************************************************** 致 匯豐銀行 貴公司最近更新網上銀行應用程式後， 用戶因”保安理由“，被禁止熒幕載圖（screen capture）。 本人對此深感不便， 認為此舉對正常使用程式用戶弊多於利。 香港現時普遍詐騙案是電騙， 一般是用戶洩漏私人密碼， 甚少騙徒/黑客強行登入個人銀行戶口， 更未聞有用戶因”熒幕載圖“引起損失。 現在普遍網上私人（C2C) 交易， 均以熒幕載圖作為交易憑證。 現在貴行禁止此行為， 令到交易雙方需要花大量時間證明已經付款， 反而令私人（C2C) 交易風險大增。 本人希望匯豐慎重考慮撤銷此項擾民”保安措施“。\",[1700116391,93000000],0,null,null,[\"115442160208310129614\",\"Andy Ng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJwgK9DA0nL1BXqMJAhbvTDhcvGoboOiUcls_SVq6SGRa_saQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"3327b9a4-4053-46db-941b-0ef42857c645\",[\"Mathee van Tonder\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKZxweLcSIVnKUJapfj8NU__-qUmiCYucNSt5WEA9foV59JQg\\u003dmo\"]]],5,null,\"Easy and straightforward to use. Trusted\",[1700102723,213000000],0,null,null,[\"117392881167870759248\",\"Mathee van Tonder\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKZxweLcSIVnKUJapfj8NU__-qUmiCYucNSt5WEA9foV59JQg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"4c02886a-985f-4a9d-9e08-6fb2aac100a3\",[\"Lyle Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXg_CmTqPfEdLsqm97pCgmli7YOeAEJh3pjgLy4opCZ6xlYy_3VWQ\"]]],1,null,\"Block screenshot\",[1700099819,199000000],0,null,null,[\"107715338111209257032\",\"Lyle Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXg_CmTqPfEdLsqm97pCgmli7YOeAEJh3pjgLy4opCZ6xlYy_3VWQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,[true,false],null,1],[\"9e5ee697-ea52-4a3b-b7b8-24ecea77cfc2\",[\"Kayan Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUSF9NgawgFbtQMPP-bLemxVhcVTA4ko-afJCtS0ua7MmQv0fIyeg\"]]],1,null,\"Crazy, how can you limit the screencap function, how am I supposed to share the payment record? Be grounded. Very disappointing\",[1700098680,711000000],0,null,null,[\"100910292209968463074\",\"Kayan Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUSF9NgawgFbtQMPP-bLemxVhcVTA4ko-afJCtS0ua7MmQv0fIyeg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"e3e1f845-c403-4805-999a-64cd71421092\",[\"James Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIxyQw03rDf3HYrmljtEttlwFja6E7UmhcDx9lrStM0Xw1B6kdb\\u003dmo\"]]],1,null,\"It is extremely not convenient to capture payment proof when screenshots is not allowed.\",[1700098284,606000000],1,null,null,[\"109087371123966043248\",\"James Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIxyQw03rDf3HYrmljtEttlwFja6E7UmhcDx9lrStM0Xw1B6kdb\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"0fd96f86-a456-4cca-8d89-f06061372333\",[\"Tin Ho Yung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIEq83Xpq6JdaiXDOW8vVN5E9DmGvROqM73Yo4Q6ICCCqqM3A\\u003dmo\"]]],1,null,\"Please provide option to enable screenshot\",[1700094850,630000000],0,null,null,[\"108912255394238515899\",\"Tin Ho Yung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIEq83Xpq6JdaiXDOW8vVN5E9DmGvROqM73Yo4Q6ICCCqqM3A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"acf0cc65-c484-498c-9117-72634f9b9dd9\",[\"Michelle\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLVou-eGRG7DrAhTzafPMwQ0DPtmKgYgZxaGxSTMmHStEnjWQ\\u003dmo\"]]],1,null,\"Blocks all screenshots which I mean is fine to protect bank info, but if I can't even screenshot a simple transaction for online purchases this just becomes a huge stupid hassle.\",[1700094398,241000000],1,null,null,[\"105026296799890353444\",\"Michelle\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLVou-eGRG7DrAhTzafPMwQ0DPtmKgYgZxaGxSTMmHStEnjWQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"ed4372f3-6313-4fbf-8dcb-86a5087ec691\",[\"Stephen Lau\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUOS2wVTz3AjXcGmX1IrXFNoPuhZHNL0dZXc7i9vhIn_IgEVWWq\"]]],1,null,\"Worst banking app., bad user experience. How come it prohibited screen cap for users, as I transferred an amount to my friends... Did they use their app.? It just telling ppl not to use their bank to do any payment or transfer. I wondered which \\\"genius\\\" approve such non-sense feature. And I can't find any button to file a complaint about it\",[1700051340,973000000],14,null,null,[\"102185208524066124705\",\"Stephen Lau\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUOS2wVTz3AjXcGmX1IrXFNoPuhZHNL0dZXc7i9vhIn_IgEVWWq\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,[true,false],null,1],[\"e7336057-7b42-4f6b-a503-f7b1484803b0\",[\"Frederick Weng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLIRW_T_jH5jJHh4eI4c1MfNhuXxkp7u__0dsf41RGPxDxuOQ\\u003dmo\"]]],1,null,\"No screenshot allowed is so stupid. especially when we do transfer, we need to take screenshot as evidence.\",[1700046410,677000000],4,null,null,[\"110820603117425067717\",\"Frederick Weng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLIRW_T_jH5jJHh4eI4c1MfNhuXxkp7u__0dsf41RGPxDxuOQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,2],[\"816e3c4d-5f0a-490c-b09d-1488c88f273c\",[\"Dennis Lo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU8xOIqwhn-p5MBaO93gf1cCFA82A3XAi7zO29G52nJUu6sZZbd\"]]],2,null,\"The screen capture function is removed. We all rely on the screen capture as proofs on transferring fees or payments. How are we supposed to do without this function? There should be at least a download button for saving records of all transaction into the phone, not only limited to transferring to self-named HSBC accounts. If this issue won't get fixed, I have to try with other banks.\",[1700043754,59000000],149,null,null,[\"117117686724590985138\",\"Dennis Lo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU8xOIqwhn-p5MBaO93gf1cCFA82A3XAi7zO29G52nJUu6sZZbd\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,[true,false],null,1],[\"081d616b-9e37-4703-b780-4a4ea2321a5e\",[\"TK Choi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLsE1MEBHfPbZMGfZEUZhewA2vJ5Vh5cWq_swGQC2KNG0ZAzQ\\u003dmo\"]]],1,null,\"Cant screenshot payment or transfer receipts\",[1700043166,725000000],0,null,null,[\"108991521413464057777\",\"TK Choi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLsE1MEBHfPbZMGfZEUZhewA2vJ5Vh5cWq_swGQC2KNG0ZAzQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"f92c23e1-d18d-4720-8e51-cddff66e937c\",[\"Ivan Ho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIXIYhF8qEVzbjD1XCbTlYARDc6lVtMcuo2d38lAowUD4arJg\\u003dmo\"]]],1,null,\"Can't capture screen after app upgrade. How to prove the money transferring without this proof？Stupid!\",[1700029346,526000000],1,null,null,[\"107388826518446578924\",\"Ivan Ho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIXIYhF8qEVzbjD1XCbTlYARDc6lVtMcuo2d38lAowUD4arJg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"f90e324f-31f2-4662-86b7-ba937683a1bf\",[\"Joe Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWcaeV7dwK2j2BzGdqxFTCMQ_ukV9Lb5JvZqoxoEgG1bpWVHeM\"]]],1,null,\"Latest update now doesn't allow people to take screenshot. I can no longer screenshot my transfer acknowledgement screen to notify my counterpart. Great, I will use other apps for all my payment from now on.\",[1700012857,243000000],11,null,null,[\"106320326147619446339\",\"Joe Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWcaeV7dwK2j2BzGdqxFTCMQ_ukV9Lb5JvZqoxoEgG1bpWVHeM\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,[true,false],null,1],[\"a2127237-314f-4bd7-8130-f01dedf96a52\",[\"Kaizer King\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX6kbK1PLGJddcQDcT3JO_5O7c1qeQB-lna1xsL98mXGiCzycFg\"]]],1,null,\"Just found out the hard way it blocked the screen capture function. I think HSBC does not understand their customer and their way they do online ordering, screen capturing the transaction confirmation screen is the basic. I know it's for security but if you don't understand customer's behavior then don't roll out new features. We might just use other banks then.\",[1699960269,344000000],80,null,null,[\"104244631048906617306\",\"Kaizer King\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX6kbK1PLGJddcQDcT3JO_5O7c1qeQB-lna1xsL98mXGiCzycFg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.6\",null,null,null,null,null,1],[\"25961384-39f4-44a8-9108-ae4c802556e3\",[\"G C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKJjkiBwhqtJtBaUIQZAbqZN3lxd3pAgYrLzLQJFw0u6wuXsA\\u003dmo\"]]],1,null,\"We need the screenshot feature for creating proof of payment after a transaction, otherwise create a button to do so.\",[1699960247,405000000],2,null,null,[\"108126512609061714075\",\"G C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKJjkiBwhqtJtBaUIQZAbqZN3lxd3pAgYrLzLQJFw0u6wuXsA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1]],[null,\"CtkBItABAV8d1P1KzZtrEwoN2wYuidkkjO51w1Qc1a2xkhbXiOGlcBJDvp1UAgE8SkKNvw7FNxooYwjIiprdiOdjgByb-UtMAwnfegsORsMfOyeY9AHoOhwYf1BBxa9Sp03V8z_4tRHr2lVzPGpE0UOadhBL0VVkWY1MO5GUUButaOShf3TeoDNMNV4CHDFU0BCkX63oBDfjXl42una8zPRxFXLo3LQitzz9eFhDznnCfDMGmrr8_l0aeUxsY_K5ZIP-X65BDfaiRHEB8_6cnFSbIXBQfSiyl9fWBg\"],[[null,[[1800],null,[72000]]]]]",null,null,null,"generic"],["di",171],["af.httprm",170,"4541213222401442823",1]]