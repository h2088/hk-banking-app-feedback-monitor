,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.10\",null,null,null,null,null,1],[\"4f225d2a-1a9a-4e3b-9bcb-ee5701196877\",[\"Kenneth Choi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLzOz0BwIA4g4_yyzSBiL9Af2glu6kptfSq9XYrRFiTmW9n6g\\u003dmo\"]]],1,null,\"After update, the app closes itself. What is a HSBC app? Why blocked access from rooted phones? A user with rooted phone is not ordinary use. They know what they doing. This is very annoying to the customer.\",[1700540482,119000000],8,null,null,[\"107008702724743035665\",\"Kenneth Choi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLzOz0BwIA4g4_yyzSBiL9Af2glu6kptfSq9XYrRFiTmW9n6g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.10\",null,null,null,[true,false],null,1],[\"56fb5438-6a72-4922-9e14-7d7572436e30\",[\"Jeff\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjioU1dnp1UOqe_JB9Yx2EYN7MkRNoYl1UMvDmGWOjHvTcig\\u003dmo\"]]],2,null,\"This is so stupid to remove the screenshot function but not adding any function to save a copy of transaction notice. This just show how ignorance HSBC is. Very disappointed.\",[1700540310,329000000],3,null,null,[\"113101120254073821860\",\"Jeff\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjioU1dnp1UOqe_JB9Yx2EYN7MkRNoYl1UMvDmGWOjHvTcig\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"3.40.10\",null,null,null,null,null,1],[\"f70f3357-493e-49c7-88b2-11ea5e4f986c\",[\"Marc-Olivier DUGA\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUgAAy7DD2XXU2eORTOa8zck6JA3AMkj89LxKapYPM05r38Xrl0\"]]],1,null,\"Sp