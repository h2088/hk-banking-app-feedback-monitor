e207d-f950-4589-a4f4-1c46c8dbd4f2\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"Removal of the finger print log in is bad. Program to have face rec or better security. Galaxy S10 is the latest device so how can you not support biometric logon.\",[1571882551,647000000],4,[\"The Hongkong and Shanghai Banking Corporation Ltd\",\"Hi Neal, thank you for your patient. HSBC Mobile apps has resumed support of Fingerprint ID on the Samsung Galaxy S10 and Note 10 series. Please update your app to begin using it.\",[1578627054,877000000]],null,[\"108104739073650384183\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"2.28.1\",null,null,null,null,null,1],[\"dccdd7c1-70ac-422b-8b30-c631d4cc62be\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"Unable to complete Mobile Key activation because SMS verification code is not working properly. Called customer services and they were successfully able to send me another code some other way (so nothing wrong with my number receiving SMS codes), but when they tried to send activation code, that also was not received. Essentially, HSBC HK has two ways to send SMS messages, one works, the other doesn't. So I cannot activate the key, which means the app is useless because of a technical issue. I tried with two different numbers (one from Bulgaria, the other India) but same problem. Is it a problem with using international numbers?\",[1571833100,300000000],11,null,null,[\"106968081202281531307\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"45ea198e-45d8-4db0-b2c2-6bf76b80f43f\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],2,null,\"The screen is offset towards to the top of the screen on my Samsung Galaxy S10, please fix this bug, it's annoying.\",[1571635173,789000000],4,null,null,[\"107200485500760017245\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"2.28.1\",null,[[[\"vaf_phase1_making_payments\",[1]],[\"vaf_phase1_homescreen_widgets\",[2]],[\"vaf_never_display_disruptive_ads\",[2]]]],null,null,null,1],[\"bdd68f2c-a537-4ad6-902e-7180659e831b\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],5,null,\"Verygood apps easy banking and transfer money\",[1571351199,499000000],1,null,null,[\"106461044541891968429\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"2.28.0\",null,[[[\"vaf_phase1_international_transfers\",[1]],[\"vaf_phase1_backing_up_yo