alaxy Note 10. Simply update your HSBC HK Mobile Banking app, log on, and register Fingerprint ID in Settings on your device. And thank you for your patience as we continue to improve and add more features to the app.\",[1570000021,595000000]],null,[\"110996253521449162890\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"2.28.0\",null,null,null,[true,false],null,1],[\"0ff8491a-571a-4d7a-881c-c7c63921d276\",[\"A Google user\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],5,null,\"Thx did adding OnePlus 7 pro fingerprint support. 5 star response.\",[1570004009,336000000],1,[\"The Hongkong and Shanghai Banking Corporation Ltd\",\"Hi Mark, thank you for your feedback. We’ve now enabled more Android devices to work with Fingerprint ID, including OnePlus 7 Pro. Simply update your HSBC HK Mobile Banking app, log on, and register Fingerprint ID in Settings on your device. And thank you for your patience as we continue to improve and add more features to the app.\",[1570002103,66000000]],null,[\"105398049770322781038\",\"A Google user\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"2.28.0\",null,[[[\"vaf_phase1_auto_insurance\",[3]],[\"vaf_never_display_make_you_happy\",[3]],[\"vaf_never_display_deceptive_ads\",[2]]]],null,[true,false],null,1],[\"27617cc3-c437-40ad-bf5e-830dd85667bb\",[\"A Google user\",[null,2,null,[null,null,\"htt