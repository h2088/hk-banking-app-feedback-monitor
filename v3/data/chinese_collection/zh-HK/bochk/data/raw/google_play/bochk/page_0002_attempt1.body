dP1srxaHVrNPzOYcfaEQ\"]]],\"7.4.7\",null,null,null,null,null,1],[\"667ac667-1677-4c8d-808a-38038453b820\",[\"KENNETH NG\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXhqU6OyfM2b33vbrhCSLgCXJwSIxE1Ef6BE0wzvPgDPxQJRJaO\"]]],2,null,\"怎也進入不到自己的戶口，我是愛囯同胞，聽從指示，努力了一個下午也使再不到，入了一次理財網後，立即記錄抄寫，之後又入不到了，非人性化設計，放棄了，去排隊吧，不方便，還是用回特區有百多年歷史的銀行吧！\",[1778050427,860000000],10,null,null,[\"117255368217695932107\",\"KENNETH NG\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXhqU6OyfM2b33vbrhCSLgCXJwSIxE1Ef6BE0wzvPgDPxQJRJaO\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.4.7\",null,null,null,[true,false],null,1],[\"b35d7d3b-65cd-4393-aeea-2c8797c4a401\",[\"Hung Lo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJPoFob3F-tvHsH1WkyPhLJ4O-JqZjq0OvJsvnltIiLxHcPHw\\u003dmo\"]]],5,null,\"方便\",[1778002518,535000000],0,null,null,[\"106063559825329843651\",\"Hung Lo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJPoFob3F-tvHsH1WkyPhLJ4O-JqZjq0OvJsvnltIiLxHcPHw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.4.7\",null,null,null,null,null,1],[\"07d46e3d-9b5a-4235-bcbc-927ef5ca4bfd\",[\"Ko Go\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV6NIpu3F-LQzpzAKeo-j5ykhJ5vBPcW40wOpWoZ0gTceIx7iI\"]]],1,null,\"話說轉了新手機,然後安裝了新指模認證, 本來用得都可以。後來我更新了指摸, 再登入又要全部認證過,要影身份證….。最後等了六小時終於話指模認證成功。 之後登出, 再即時登入, 又話我編碼密碼錯…, 總之過程很不暢順。 其他銀行完全冇這個問, 只需登記返指摸一次就ok。 我先生才說,就是因為怕中銀這個指模認證很麻煩, 又成日登入唔到, 所以佢想cut咗中銀戶口。其實明白中銀在認證方面很嚴謹, 但係這個apps又係唔係有一啲存在問題未解決。 只係加一個指紋都要顧客搞 咁耐, 每次又要全部入過晒資料, 實在很煩人！ 註：我係收到指紋認證成功的訊息, 但到現在都仍然用不到, 一登入又要打過晒d 登入名密碼等…係咪又要等六個鐘先用得\",[1777996812,564000000],1,null,null,[\"103623480194592661941\",\"Ko Go\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV6NIpu3F-LQzpzAKeo-j5ykhJ5vBPcW40wOpWoZ0gTceIx7iI\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"c583dd07-e358-4872-b533-5974e76d5e2d\",[\"周鎮山\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIu3oZqwyPORUgOSy_9cIAaX9jzEw_qZVev7aHCV6_fxNZm\\u003dmo\"]]],5,null,\"安全\",[1777942684,629000000],0,null,null,[\"104833178846567079612\",\"周鎮山\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIu3oZqwyPORUgOSy_9cIAaX9jzEw_qZVev7aHCV6_fxNZm\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.4.7\",null,null,null,null,null,1],[\"27ec3b95-5e1e-4a40-8851-f38171bc74cb\",[\"娟\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL7VCKudwEPSTIksi09rF88-btKak9zLvw9l8IIMz8RusP14w\\u003dmo\"]]],1,null,\"完全登入唔到，好差\",[1777803906,615000000],0,null,null,[\"114331749851739027981\",\"娟\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL7VCKudwEPSTIksi09rF88-btKak9zLvw9l8IIMz8RusP14w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.4.7\",null,null,null,null,null,1],[\"4ae2c5b1-6821-49aa-bd50-ed7fba9365cf\",[\"黃豆-PINKY TANG\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUlVOU3tBQIUzur2F8jSoFKNe8LZlBsou2Sfve4-h2smL7qhL9JLQ\"]]],1,null,\"人面識別自從多了一個前後移動根本就detect唔到 唔知想點\",[1777745253,58000000],0,null,null,[\"105633765311507381212\",\"黃豆-PINKY TANG\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUlVOU3tBQIUzur2F8jSoFKNe8LZlBsou2Sfve4-h2smL7qhL9JLQ\"]],true],[null,2,null,[null,null,\"https