)]}'

[["wrb.fr","oCPfdb","[[[\"617d78da-04b0-4cb6-948c-7bc585023056\",[\"Kenneth Li\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZ-vyR_znBLOsE6dyhD4OGLC0lrWYKroKVE1X940K5dy4riw\\u003dmo\"]]],2,null,\"Not easy to use\",[1767842992,991000000],0,[\"Standard Chartered Bank PLC\",\"Hi Kenneth Li, sorry for the inconvenience caused. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. If you encounter issue in app, please visit our website sc.com/hk and tap the icon of Stacy to connect with our live agent for further investigation. ~ Danny\",[1768794071,251000000]],null,[\"108623371225005285765\",\"Kenneth Li\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZ-vyR_znBLOsE6dyhD4OGLC0lrWYKroKVE1X940K5dy4riw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"736b255d-84b9-4709-abed-548ea7da782f\",[\"周泰延\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWu4XqtEvU6WH7TzT5k5jXMB7jsWePrIM-wAe2T7JN4IDBvSZY\"]]],2,null,\"睇下啲銀行資料，無啦啦就斷咗入AC方法……又要重新登記過啲生物認證，密碼果啲……點解唔解決下更新之後唔洗再做呢啲嘅程序？ 只係update個版面嘅意義係邊？\",[1767759681,601000000],2,[\"Standard Chartered Bank PLC\",\"你好周泰延，抱歉未能為你帶來滿意的使用體驗，明白你遇到生物認證登記問題，你可以先將SC Mobile更新至最新7.11.0版本。如更新後提及的情況仍持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Carl\",[1768878631,553000000]],null,[\"109716368829933517527\",\"周泰延\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWu4XqtEvU6WH7TzT5k5jXMB7jsWePrIM-wAe2T7JN4IDBvSZY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"2fc5fe87-43a7-4360-8f15-2b18ff49a236\",[\"Chi Ming Joseph Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUbKdHKzv197xZxB4dnU2CggGKScNO9x3fKWfy_NkzhDJkobZDDXw\"]]],1,null,\"terrible and user unfriendly,\",[1767666425,951000000],0,[\"Standard Chartered Bank PLC\",\"Hi Chi Ming Joseph Lee, thank you for your feedback. We are sorry to hear that the current setting does not meet your needs. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Sara\",[1768558639,253000000]],null,[\"116800557768863249439\",\"Chi Ming Joseph Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUbKdHKzv197xZxB4dnU2CggGKScNO9x3fKWfy_NkzhDJkobZDDXw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"584c049d-c9e2-4ca6-8024-2ed893ce38cb\",[\"kuenkwok fung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV2p8OV_Lld-3uYiPyxFn2URyVoDLusChTqsxhfxDyMJgjRqEZ_\"]]],4,null,\"字太细\",[1767228713,954000000],0,[\"Standard Chartered Bank PLC\",\"你好 kuenkwok fung，多謝你的反饋，現時SC Mobile 未支援更改字體大小，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。 ~ Danny\",[1767956980,811000000]],null,[\"105947802015313365004\",\"kuenkwok fung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV2p8OV_Lld-3uYiPyxFn2URyVoDLusChTqsxhfxDyMJgjRqEZ_\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"4947123e-f5f9-4d9b-966c-357ef535c950\",[\"Kevia Tang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUGtr7ZbKMrdbtrBgFwSx7NQ6Zhhf1weQsK26Tdb5lWfa3ZWIQ\"]]],4,null,\"時不時會出現系統故障\",[1767173647,965000000],0,[\"Standard Chartered Bank PLC\",\"你好Kevia Tang，抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Danny\",[1767956777,684000000]],null,[\"113603822545239119281\",\"Kevia Tang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUGtr7ZbKMrdbtrBgFwSx7NQ6Zhhf1weQsK26Tdb5lWfa3ZWIQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"250b170c-3b6e-4e11-b2bc-17d3be16f790\",[\"billy ycw\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVqKjQcKdGUX-ngCoijSk7IoFPbl9bcp4Eaqsk_nRV41FQM6lJFGQ\"]]],5,null,\"都唔知班IT搞乜，宜家登入唔到，想買股票要我走去中銀。真係服咗你間銀行管理層\",[1767084509,518000000],0,[\"Standard Chartered Bank PLC\",\"你好billy ycw，SC Mobile及網上理財目前正常運作，如你現時仍未能登入SC Mobile或網上理財，我哋需要更多資料了解並跟進你嘅個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我哋線上客戶顧問會爲你提供協助，謝謝。 ~ Danny\",[1767956675,61000000]],null,[\"111387640558055393441\",\"billy ycw\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVqKjQcKdGUX-ngCoijSk7IoFPbl9bcp4Eaqsk_nRV41FQM6lJFGQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"3f80b394-fa21-4652-a089-1ac92bf3e1e2\",[\"Zoe Lai\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLe7YDMC1yWA-vCfB5TRhLWaUThiq0bKluBdPchVXzHHe6eng\\u003dmo\"]]],1,null,\"最鬼憎呢個app，成日要人用推送功能，才收到信用卡交易訊息及 銀行信息。 如果你不是每天都登入，就收唔到訊息 ， 我的信用卡就被人海外盜用，三個星期後才知道， 又要打去銀行度搞一大餐，煩死了。顶！！！🙁🙁🙁 大佬呀！銀行app點可能24小時成日開住收讯息㗎！ 好唔安全啦！低B！！！\",[1766832092,707000000],25,[\"Standard Chartered Bank PLC\",\"你好Zoe Lai，抱歉未能為你帶來滿意的使用體驗，信用卡無卡交易及銀行收款交易除了推送通知外，亦會有短訊/電郵通知。SC Mobile 推送通知可以在登入SC Mobile 後查閱，亦會顯示於手機裝置通知中心，你可以檢查你手機裝置的設定是否已啟用及允許SC Mobile的推送通知。關於推送通知及信用卡盜用交易，如需要進一步協助，請於登入SC Mobile後點擊右上角的「聯絡及支援」圖示透過智能助理Stacy聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Wes\",[1767957332,190000000]],null,[\"113863267857023640571\",\"Zoe Lai\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLe7YDMC1yWA-vCfB5TRhLWaUThiq0bKluBdPchVXzHHe6eng\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_spend_more_time\",[1]],[\"vaf_never_display_content_language\",[1]],[\"vaf_never_display_visually_good\",[1]]]],null,[true,false],null,1],[\"b0e61284-7018-4024-a8e0-144d99f54b35\",[\"Rex Ho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUY0aHgdc6OMVUVfN2fFYP4rjVnDe5KclnjPyfga8vKkmD1aC_0\"]]],1,null,\"不能用，廢了？\",[1766823357,415000000],0,[\"Standard Chartered Bank PLC\",\"你好Rex Ho，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角的智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助及跟進，我們也會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持，謝謝。 ~ Danny\",[1767855475,270000000]],null,[\"109728484587439433000\",\"Rex Ho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUY0aHgdc6OMVUVfN2fFYP4rjVnDe5KclnjPyfga8vKkmD1aC_0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"6b93bebc-b8e3-44a3-9221-c67d269781f0\",[\"WK LAM\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJYE65QBPCIJOIMHm9JXRc4GUQIW4iT-99MpLiIjaFXXu1fcA\\u003dmo\"]]],3,null,\"指示不清，我寧願用舊App。唔該指示簡單啲，比其他投資比台煩好多！\",[1766631299,32000000],1,[\"Standard Chartered Bank PLC\",\"你好WK LAM，感謝你的反饋，如你需要進行股票交易，請將SC Mobile手機應用程式更新至最新版本，登入SC Mobile後，你可以在頁面最下方選擇「投資及保險」，然後選擇「股票」，即可進行股票交易買賣，所有SC Equities原有的網上股票投資功能、服務及操作界面等，不會在合併至SC Mobile App後有任何改變。合併後的分別主要在於，登入所用的應用程式由現有的SC Equities改爲透過SC Mobile App登入網上股票交易，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持，謝謝。 ~ Carl\",[1767607212,70000000]],null,[\"115472078243437185539\",\"WK LAM\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJYE65QBPCIJOIMHm9JXRc4GUQIW4iT-99MpLiIjaFXXu1fcA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_app_description\",[2]],[\"vaf_never_display_content_language\",[1]]]],null,null,null,1],[\"a40bcba0-88ed-4505-a520-c6213c0627a0\",[\"KEN HO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtGrMimzh4QFGwiUAz33x3gqTTe-cGXgqilR95kCRCedtI_Q\\u003dmo\"]]],1,null,\"近排登入唔到個App\",[1766472053,903000000],0,[\"Standard Chartered Bank PLC\",\"你好KEN HO，很抱歉為你帶來不便，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。如閣下的SC Mobile 已經更新到最新版本7.11.0，但登入問題仍然持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1767688447,863000000]],null,[\"103805559684961878613\",\"KEN HO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtGrMimzh4QFGwiUAz33x3gqTTe-cGXgqilR95kCRCedtI_Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"e98fa94d-307e-4e28-8328-3fc1d228500f\",[\"CINDY YUEN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyuno8-291_xg4RU--p0HmeSUlt-5znqCPfwVS8f6atrNxw7o-\"]]],1,null,\"我是用三星S25edge,更新後，app入面好多function 按了都没有反應\",[1766461538,226000000],0,[\"Standard Chartered Bank PLC\",\"你好CINDY YUEN，抱歉為你帶來不便，SC Mobile現時正常運作，如你現時使用SC Mobile仍然遇到問題，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Danny\",[1767955751,803000000]],null,[\"101860901072235078769\",\"CINDY YUEN\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyuno8-291_xg4RU--p0HmeSUlt-5znqCPfwVS8f6atrNxw7o-\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_meet_expectations\",[2]],[\"vaf_never_display_content_language\",[1]],[\"vaf_never_display_visually_bad\",[1]]]],null,[true,false],null,1],[\"b3689cac-089f-4086-8b36-faa6d6a95126\",[\"Ben Kwok\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJZnzJONFulrwcTJEKtFO_PpyDWZhnETK9CvJ5s3Oza7imYXg\\u003dmo\"]]],1,null,\"麻煩，提示好差，登不入，。。。。。。11\",[1766459464,743000000],0,[\"Standard Chartered Bank PLC\",\"你好Ben Kwok，抱歉為你帶來不便，SC Mobile及網上理財現時正常運作，如你現時仍未能登入SC Mobile或網上理財，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Danny\",[1767955913,499000000]],null,[\"107228157115415091322\",\"Ben Kwok\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJZnzJONFulrwcTJEKtFO_PpyDWZhnETK9CvJ5s3Oza7imYXg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"a6445334-b448-4501-94e9-bd0cdc99f8ca\",[\"William Chong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJUQemCxTvfozlL52vwvGOk8mfU90dmcmWjVT029yRM-0mDMQ\\u003dmo\"]]],2,null,\"客服聊天，三星 電話 在最底那行，全打不到字。\",[1766389145,635000000],0,[\"Standard Chartered Bank PLC\",\"你好 William Chong，很抱歉為你帶來不便，如閣下手機的導覽列在聯絡線上客服時有遮擋輸入文字的情況，你可以於手機「設定」内選擇「顯示」\\u003e「導覽列」内更改導覽列設定，或者登入網上理財【網頁版】於右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Wes\",[1767608235,77000000]],null,[\"114827875389644599469\",\"William Chong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJUQemCxTvfozlL52vwvGOk8mfU90dmcmWjVT029yRM-0mDMQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_ads_experience\",null,[2]],[\"vaf_never_display_ease_of_use\",null,[2]]]],null,[true,false],null,1],[\"d870f2dd-dcd8-4540-a030-623643fc0aa2\",[\"陳俊安\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUbTcZwv14u5qNO42gs5YfwdtbGTAZT7qPlRFIuy9ozHiSVF2RP\"]]],1,null,\"各種bug，不人性化設計，想改電子月結單又一直彈系統錯誤\",[1766332598,355000000],0,[\"Standard Chartered Bank PLC\",\"你好陳俊安，抱歉未能為你帶來滿意的使用體驗，關於登記收取電子結單/紙張月結單，你亦可以透過網上理財【網頁版】遞交指示。登入後，請點撃左邊清單的「電子結單/電子通知書」\\u003e 申請 \\u003e 選擇 綜合月結單 / 渣打信用卡 ，點撃右則「指示」\\u003e 選擇及遞交「收取電子結單」或者「收取紙張月結單」指示。我們會持續優化SC Mobile以帶來更佳的使用體驗。如你在使用SC Mobile時需要進一步協助，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Wes\",[1767834437,177000000]],null,[\"103581103566744703475\",\"陳俊安\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUbTcZwv14u5qNO42gs5YfwdtbGTAZT7qPlRFIuy9ozHiSVF2RP\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]],[\"vaf_never_display_ads_experience\",null,[1]]]],null,null,null,1],[\"ede62bad-90e2-42ae-84cd-0dad26d68913\",[\"Emma Harenz\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX_fReggG2jHgByECfevLZXcRF2gewAVEbn5H7KVyrOU55YvIwACg\"]]],1,null,\"在海外完全聯络不到客服，裡面打唔倒任何信息\",[1766219107,336000000],0,[\"Standard Chartered Bank PLC\",\"你好 Emma Harenz，很抱歉為你帶來不便，如閣下手機的導覽列在聯絡線上客服時有遮擋輸入文字的情況，你可以於手機「設定」内選擇「顯示」\\u003e「導覽列」内更改導覽列設定，或者登入網上理財【網頁版】於右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Wes\",[1767608184,37000000]],null,[\"114917741541517030875\",\"Emma Harenz\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX_fReggG2jHgByECfevLZXcRF2gewAVEbn5H7KVyrOU55YvIwACg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_easy_to_use\",[2]],[\"vaf_never_display_make_you_happy\",[2]],[\"vaf_never_display_app_description\",[2]]]],null,null,null,1],[\"4024ac2e-c577-4503-a834-ec1c7069cb29\",[\"陳平安\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItrIpVwA7ud6agDl8-WzIpR-orbWqn_Ma__gmf0ph0eh5ebQ\\u003dmo\"]]],1,null,\"探索頁面內容打開一片空白\",[1766210955,752000000],0,[\"Standard Chartered Bank PLC\",\"你好陳平安，很抱歉為你帶來不便。如問題仍持續，我們需要更多資料了解並跟進你的個案，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。~ Danny\",[1767161187,341000000]],null,[\"110898986801825605657\",\"陳平安\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItrIpVwA7ud6agDl8-WzIpR-orbWqn_Ma__gmf0ph0eh5ebQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"ba1fafee-ed6b-4ee2-bc4c-d91e39200ca8\",[\"Lo Ketty\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKqB02sZow4jmQC_3JQ0vz2l_fOuklLXslc2l3KjW9QDSwkwg\\u003dmo\"]]],2,null,\"成日要重複入密碼。\",[1766120214,619000000],0,[\"Standard Chartered Bank PLC\",\"你好Lo Ketty，抱歉未能為你帶來流暢的SC Mobile 使用體驗。我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Danny\",[1767161163,405000000]],null,[\"104025608869571035293\",\"Lo Ketty\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKqB02sZow4jmQC_3JQ0vz2l_fOuklLXslc2l3KjW9QDSwkwg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"4ea9e5ef-c8ff-4ce1-9197-2c6f3b316682\",[\"LAI CHIKIT\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXjTYn7qPU4tlZdqoNgUetH50qXQl_eapnuvuCARXXLGLPesOvD\"]]],3,null,\"good job\",[1766112347,518000000],0,[\"Standard Chartered Bank PLC\",\"Hello LAI CHIKIT, thank you for your feedback! We’re delighted to hear you’re having a great experience. We look forward to provide you with quality services in the future and your continuous support. ~ Danny\",[1766372160,986000000]],null,[\"113178441645115489569\",\"LAI CHIKIT\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXjTYn7qPU4tlZdqoNgUetH50qXQl_eapnuvuCARXXLGLPesOvD\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,null,null,null,null,1],[\"9cc14c70-360a-40bd-915f-7f7539305887\",[\"butter eggroll\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL3pTR9Z2NlR7nn0aVyWLChzroAh7ceGtMkbdFRnNE_pWV_yQ\\u003dmo\"]]],1,null,\"上網買野比錢按完個授權通知就卡住係登入畫面轉轉圈 想搵網上客服個打字位比最底返回鍵擋住 連問客服既機會都冇 真係多謝哂整個咁勁既app出黎\",[1765934150,424000000],0,[\"Standard Chartered Bank PLC\",\"你好butter eggroll，很抱歉為你帶來不便，如閣下手機的導覽列在聯絡線上客服時有遮擋輸入文字的情況，你可以於手機「設定」内選擇「顯示」\\u003e「導覽列」内更改導覽列設定，而如信用卡授權的問題仍持續，請透過渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Danny\",[1766372076,335000000]],null,[\"111423239284564767922\",\"butter eggroll\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL3pTR9Z2NlR7nn0aVyWLChzroAh7ceGtMkbdFRnNE_pWV_yQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"dc9c86b5-37a9-4c80-91ea-136f2e968bec\",[\"Ming Fai Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIgZRpX9y_gxXNJA_3uekgI5NYpMNLVfjjeAuLiUNxYvT-UDw\\u003dmo\"]]],1,null,\"不斷叫我更新，然後甚麼更新也沒有，不斷卡在登入畫面，浪費我時間。\",[1765769631,626000000],1,[\"Standard Chartered Bank PLC\",\"你好Ming Fai Wong，請在登入前點擊右上角的問號標誌後查閱你的SC Mobile 版本。如你的SC Mobile 版本已是最新版本7.10.0，但現時仍未能成功登入SC Mobile，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問，提供遇到問題的日期與時間、 手機型號、 作業系統版本。我們線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1766132395,878000000]],null,[\"102045247688562321527\",\"Ming Fai Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIgZRpX9y_gxXNJA_3uekgI5NYpMNLVfjjeAuLiUNxYvT-UDw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"c6eeacf8-ac7e-4a68-ac26-40fa71742c4a\",[\"Simon Lam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUu5-cqSy2scwg0TL1DQAxsHw_e0OihZbqUiejZisPBk5gaYO7_Ag\"]]],2,null,\"1. Android版本9都不支援，迫人換手機，我會換銀行。2. 我剛在新手機安裝app，我的手機是中文語言，為什麼app𥚃全是英文？好廢，好煩。\",[1765749442,617000000],3,[\"Standard Chartered Bank PLC\",\"你好Simon Lam，抱歉未能為你帶來滿意的體驗，根據內部測試報告，Android 9.0存在漏洞問題。為確保你的賬戶安全，本行已將SC Mobile Hong Kong的最低操作系統要求設置為Android 10.0。你可以嘗試在「設定」應用程式中，點選「關於手機」或「系統」選項，然後點選「檢查更新」，更新你的作業系統為Android 10.0或以上。\\n\\n另外，SC Mobile可以設定繁體中文顯示，語言設定可以在登入前點擊右上角的問號標誌後，選擇「Language/語言」更改為中文。我們會繼續優化SC Mobile 以令客戶獲得更佳體驗， 並期待獲得你的持續支持及理解。 ~ Wes\",[1765958561,237000000]],null,[\"113217853374288877265\",\"Simon Lam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUu5-cqSy2scwg0TL1DQAxsHw_e0OihZbqUiejZisPBk5gaYO7_Ag\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,[[[\"vaf_never_display_considerate_of_time\",[2]],[\"vaf_never_display_easy_to_use\",[2]],[\"vaf_never_display_negative_ads_impact\",[1]]]],null,[true,false],null,1],[\"41d9e30c-7c29-4806-a6dc-db8efaccac37\",[\"W Cheng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLYHGWBElWqqn6uZgIOslaHCbK5UFUBWiqdszWdwn9tgQxU3Q\\u003dmo\"]]],1,null,\"垃圾app\",[1765618094,384000000],0,[\"Standard Chartered Bank PLC\",\"你好W Cheng，感謝你的反饋， 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。如使用SC Mobile時進一步協助，請你於登入SC Mobile APP後點擊右上角的對話標誌，選擇「聯絡及支援」圖示，點撃「即時對話」聯繫線上客戶顧問，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Wes\",[1765958539,623000000]],null,[\"108294573814156838132\",\"W Cheng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLYHGWBElWqqn6uZgIOslaHCbK5UFUBWiqdszWdwn9tgQxU3Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,null,null,null,null,1],[\"b49ec250-674b-47bb-ba09-5310f072e9b3\",[\"Chi ming Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIdOZh-ybp4y6owH4HXqvYmCUPy-EQwxFUVtKKOFeGWS9M01w\\u003dmo\"]]],5,null,\"ok\",[1765371219,290000000],0,[\"Standard Chartered Bank PLC\",\"Hi Chi ming Leung, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to provide you with quality services in the future and your continuous support. ~ Danny\",[1765850176,244000000]],null,[\"117624799148060072046\",\"Chi ming Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIdOZh-ybp4y6owH4HXqvYmCUPy-EQwxFUVtKKOFeGWS9M01w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,[[[\"vaf_never_display_visually_good\",[1]],[\"vaf_never_display_deceptive_ads\",[2]],[\"vaf_never_display_meet_expectations\",[1]]]],null,null,null,1],[\"4ee9beb4-37f8-4db1-b266-d56b38b1598e\",[\"Abc Cde\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLE8gnp9_kdlOg9zD8_wZOgubt8cRoo6uNQ-AURA5lP2bw7JEQ\\u003dmo\"]]],1,null,\"sc equities 以前能截圖，現在不能，請修復。整合到 sc mobile，進入股票買賣慢了幾拍，要改善，放在首頁。中途更改價位時，會被限時登出，要重新登入才改到。應有過渡期, 讓sc mobile 可以試用一段時間，反應好才合併。\",[1765173010,849000000],20,[\"Standard Chartered Bank PLC\",\"你好Abc Cde，很抱歉為你帶來不便，隨著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。如果你需要提供交易紀錄，可以登入網上股票投資平台截圖或提供月結單，我們也會繼續優化SC Mobile App以令客戶獲得更佳體驗，並期待獲得你的持續支持，謝謝。 ~ Danny\",[1765792798,794000000]],null,[\"117249453507407787085\",\"Abc Cde\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLE8gnp9_kdlOg9zD8_wZOgubt8cRoo6uNQ-AURA5lP2bw7JEQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"27e086eb-9232-4bc0-a15d-856f5ce4f5da\",[\"Yi Nok Wnoch Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI62to-ec4ONnClWn0Wwd0xKGydh5lVVuZFGq5yLG65kIu5SQ\\u003dmo\"]]],1,null,\"增值不了ALIPAYHK\",[1765041433,431000000],0,[\"Standard Chartered Bank PLC\",\"你好Yi Nok Wnoch Wong，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，提供未能查閱到月結單月份，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1765359327,102000000]],null,[\"113859101563472151407\",\"Yi Nok Wnoch Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI62to-ec4ONnClWn0Wwd0xKGydh5lVVuZFGq5yLG65kIu5SQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_never_display_ads_experience\",null,[2]],[\"vaf_never_display_ease_of_use\",null,[2]]]],null,null,null,1],[\"368dd069-8ea1-49f3-ba9b-12616094db8a\",[\"Jenny Wang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIXt4GcLA0Am8e6YcQH_NeXDMOq__MT986IDQ_kmEnpHn8ULg\\u003dmo\"]]],1,null,\"搵線上客服，輸入文字個位，完全入唔到野，另外係線上搵RM，兩日都唔覆，可能放得唔夠多錢\",[1764848717,918000000],0,[\"Standard Chartered Bank PLC\",\"你好Jenny Wang，很抱歉為你帶來不便，如閣下手機的導覽列在聯絡線上客服時有遮擋輸入文字的情況，你可以於手機「設定」内選擇「顯示」\\u003e「導覽列」内更改導覽列設定，或者透過渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Danny\",[1765352622,178000000]],null,[\"103478594433801253475\",\"Jenny Wang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIXt4GcLA0Am8e6YcQH_NeXDMOq__MT986IDQ_kmEnpHn8ULg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.10.0\",null,null,null,null,null,1],[\"b7c1df16-80a4-4306-bc16-bd090c456308\",[\"Dicky Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIDoO_PWtw6N72FwB1ECptWBF3NSeHa5drYg0gEndzwDmEeuw\\u003dmo\"]]],1,null,\"已有信用卡和用緊mobile app，電話熱線叫人在mobile app開綜合帳戶，試了無數次，都出現「抱歉，我們暫時未能處理您的要求，請䄲後再試」，再打去熱線，叫你重裝，再試，再失敗。無言。\",[1764389508,998000000],4,[\"Standard Chartered Bank PLC\",\"你好Dicky Wong，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，輸入「線上客戶顧問」聯絡我們。我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗，並期待獲得你的持續支持，謝謝。 ~ Danny\",[1765329945,116000000]],null,[\"101828751580836657703\",\"Dicky Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIDoO_PWtw6N72FwB1ECptWBF3NSeHa5drYg0gEndzwDmEeuw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"b2dcadc6-ca22-4b98-87c2-f2897cde15f5\",[\"Garden Lotus\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWAprOeRUsJPsMFGRp96lg4LD_xnku1-_SzeTIELssltAzcBFmb\"]]],2,null,\"太多推广讯息\",[1764377408,33000000],0,[\"Standard Chartered Bank PLC\",\"你好Garden Lotus，SC Mobile 設有不同的推廣去切合客戶的需要及帶來最新的資訊，期望為客戶帶來更好的銀行體驗，如有需要，你可以登入SC Mobile 並點擊「 服務」 ，然後選擇「 通訊喜好」 及「 優惠及產品資訊」 去更新SC Mobile 的廣告通訊喜好設定，最多需時10個工作天處理，謝謝。 ~ Wes\",[1764756905,974000000]],null,[\"105141343401644977302\",\"Garden Lotus\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWAprOeRUsJPsMFGRp96lg4LD_xnku1-_SzeTIELssltAzcBFmb\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"6a1620a6-7f03-4bb5-84aa-00ae37aa9ab9\",[\"卓卓\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVwAWAUTPHBXpH_IwcLGLdMXIpsP09R5ht9mwHDihW-9EfC3M3l\"]]],4,null,\"我是用vivo手機x300 Pro，在已開啟渣打apps時，想cap低圖片證實過了數，但是應用程式拒絕了去設定看看沒有任何設定可以解決這個問題\",[1764294762,253000000],0,[\"Standard Chartered Bank PLC\",\"你好卓卓，著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。如果你需要向收款人/商戶證明付款紀錄，我們會於SC Pay「轉數快」、「掃描支付」、本地或海外及跨境轉賬完成付款指示後經電子郵件、推送通知或短訊通知你有關交易狀況，你亦可以於轉賬成功後點擊 「分享」，把轉賬的紀錄分享給收款人，謝謝。 ~ Danny\",[1764735058,168000000]],null,[\"104174130669224530295\",\"卓卓\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVwAWAUTPHBXpH_IwcLGLdMXIpsP09R5ht9mwHDihW-9EfC3M3l\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"b619ef52-b7dc-47f0-a307-eb4bac703403\",[\"Wong Roki\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV_Hi-7l-ASdyBuSfODjeHqPgHrxyBkUyMV77kJZKsFZN52xBUAjg\"]]],1,null,\"幾天都不能登入，一直顯示「抱歉，我們暫時未能處理你的要求，請稍後再試」。\",[1764125011,753000000],0,[\"Standard Chartered Bank PLC\",\"你好Wong Roki，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1764664294,362000000]],null,[\"109378684789320095670\",\"Wong Roki\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV_Hi-7l-ASdyBuSfODjeHqPgHrxyBkUyMV77kJZKsFZN52xBUAjg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"7462969a-b350-43e2-a48b-67f7bbf5b7b6\",[\"rlihorse Ronald\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLKMvD00UWkIBcRGVpenWRaP0Aan-Q5iMhZdnR6UFSdX-fZBg\\u003dmo\"]]],1,null,\"自從更新左要登記個咩SC Mobile key開始就一直登記唔到，都咁多人出聲有咁多問題，到底你地係想點，咁耐都冇人攪好d個app, 話晒咁大間銀行，呢d野好趕客wor。\",[1764082981,30000000],1,[\"Standard Chartered Bank PLC\",\"你好rlihorse Ronald，抱歉未能為你帶來滿意的使用體驗，明白你正在面對SC Mobile key 登記問題，你可以先將SC Mobile app更新至最新7.9.0 版本，如更新後情況仍持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Danny\",[1764735002,419000000]],null,[\"105775710712611271263\",\"rlihorse Ronald\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLKMvD00UWkIBcRGVpenWRaP0Aan-Q5iMhZdnR6UFSdX-fZBg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"c9c6200b-e158-4262-9c18-d1d425ad2968\",[\"wong alex\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtDp84YCuyzvQkRutDGk8ps11F3JrcntUKQrQiZwuyL-lvyQ\\u003dmo\"]]],1,null,\"不是合併了可以用此App買股票嗎，為何更新了都買不到\",[1764044344,811000000],0,[\"Standard Chartered Bank PLC\",\"你好wong alex，我們由2025年11月起，陸續分批為客戶的SC Equities應用程式自動進行合併至SC Mobile App，現時部份客戶的合併尚未完成。完成合併後，你的SC Equities應用程式將會停止服務。届時你將於SC Equities 界面收到指示訊息，通知你升級後的登入步驟。你到時可根據指示登入SC Mobile App，以進入網上股票投資服務，謝謝。 ~ Carl\",[1764654690,426000000]],null,[\"116058118905308126970\",\"wong alex\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtDp84YCuyzvQkRutDGk8ps11F3JrcntUKQrQiZwuyL-lvyQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"2c7f0458-de8c-45ff-b4c6-13ce6d413c72\",[\"yuki yuen\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLoZfL4AIclR-CvHm6fHSz97oo1SvpL5uu1WWTnhjjfmtl1fQ\\u003dmo\"]]],2,null,\"想在app 內申請加大信用卡額，一到上傳文件檔案，就會彈app。\",[1763873472,52000000],0,[\"Standard Chartered Bank PLC\",\"你好yuki yuen，很抱歉為你帶來不便。如需進一步協助或遞交相關文件，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。~ Carl\",[1764654442,638000000]],null,[\"100447941629105957446\",\"yuki yuen\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLoZfL4AIclR-CvHm6fHSz97oo1SvpL5uu1WWTnhjjfmtl1fQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,[true,false],null,1],[\"ee0f314f-412f-42f1-b372-ec8763da4aea\",[\"Lawrence Lai\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW6PF8MpS8cP5Wpf_H5zViQ0k4O-ki3KKfRwHfWWHKUstfG0O0\"]]],1,null,\"請問現在這個7.9版本是否巳解決指紋登入的問題？因之前 7.7.9有不能用指紋登入，每次也要重新登記，非常困擾。最終要重新下載7.7.7版本才解決問題。故現在不敢更新，除非確保無問題。\",[1763822963,559000000],7,[\"Standard Chartered Bank PLC\",\"你好Lawrence Lai，很抱歉為你帶來不便，有關指紋認證問題，你可以嘗試重新安裝SC Mobile app，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗，並期待獲得你的持續支持，謝謝。 ~ Danny\",[1760525151,957000000]],null,[\"105010323197080088286\",\"Lawrence Lai\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW6PF8MpS8cP5Wpf_H5zViQ0k4O-ki3KKfRwHfWWHKUstfG0O0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,[true,false],null,1],[\"bb103da1-8618-4905-93d4-180b97bca71d\",[\"HS Choi (星)\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-I4jfqlHCB-T3BVnOpqtsM2P104EGIzi-ICzvEheyKBQX\\u003dmo\"]]],1,null,\"想加信用卡個信用額，要求提供文件 然後揀檔案之後個app自己熄app\",[1763715627,576000000],0,[\"Standard Chartered Bank PLC\",\"你好HS Choi (星)，很抱歉為你帶來不便。如需進一步協助或遞交相關文件，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。~ Carl\",[1764654422,221000000]],null,[\"111393443452699940413\",\"HS Choi (星)\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-I4jfqlHCB-T3BVnOpqtsM2P104EGIzi-ICzvEheyKBQX\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"2d094c7e-b8b1-4296-b080-d1399b9aef63\",[\"Joanna Lai\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKltfcmjjwZqSt8Vgk6GnCx0UFS7bHt2-UCICb_MfWH1P_gVg\\u003dmo\"]]],1,null,\"無法更新程式，因不兼容我的手機\",[1763710802,857000000],1,[\"Standard Chartered Bank PLC\",\"你好Joanna Lai，根據內部測試報告，Android 9.0存在漏洞問題。為確保你的賬戶安全，本行已將SC Mobile Hong Kong的最低操作系統要求設置為Android 10.0。你可以嘗試在「設定」應用程式中，點選「關於手機」或「系統」選項，然後點選「檢查更新」，我們會繼續優化SC Mobile 以令客戶獲得更佳體驗， 並期待獲得你的持續支持及理解。 ~ Wes\",[1764653598,708000000]],null,[\"114796429174959425798\",\"Joanna Lai\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKltfcmjjwZqSt8Vgk6GnCx0UFS7bHt2-UCICb_MfWH1P_gVg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"dabde4dd-8925-4f9b-b2ac-a1f4f6bd5945\",[\"Herman Cheng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLC1vb_Vjur-HaZ0Dy6iX1RgLBaRBFnO0z74vDTWOK2dJnRCg\\u003dmo\"]]],1,null,\"咁多間銀行之中，呢間最垃圾，連安信都好過佢10倍，交卡數！沒有得掃qr code,沒有轉數快，不知所謂！\",[1763624340,194000000],0,[\"Standard Chartered Bank PLC\",\"你好Herman Cheng，抱歉未能為你帶來滿意使用體驗，現時本行信用卡支援以轉數快、繳款、繳費靈，或者本行戶口等網上轉賬方式繳付賬單，如你需要進一步協助，請你於登入SC Mobile 後點擊右上角的對話標誌，選擇「聯絡及支援」圖示，點撃「即時對話」聯繫線上客戶顧問，我們的線上客戶顧問會爲你提供協助及跟進，我們亦會繼續優化SC Mobile 以令客戶獲得更佳體驗，謝謝。 ~ Wes\",[1764665493,647000000]],null,[\"108970896064012320571\",\"Herman Cheng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLC1vb_Vjur-HaZ0Dy6iX1RgLBaRBFnO0z74vDTWOK2dJnRCg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"12c654a7-fa3f-4e9b-9f92-28b90caddea1\",[\"Raymond chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKj_-duQIniwNOBqGntRo0xSa5af7iUL0OnoM1HAl4n_3qC\\u003dmo\"]]],1,null,\"無法下载\",[1763457412,245000000],2,[\"Standard Chartered Bank PLC\",\"你好Raymond chan，如你未能夠於Google Play Store 安裝SC Mobile，請前往以下網站：sc.com/hk/zh/bank-with-us/app-sc-mobile/apk-download/ ，透過掃描二維碼下載APK檔案安裝。另外，本行已將SC Mobile 的最低操作系統要求設置為Android 10.0，如你現時的Android 版本是10.0以下，可以嘗試在「設定」應用程式中，點選「關於手機」或「系統」選項，然後點選「檢查更新」，即可下載並安裝最新的Android版本。如更新Android 版本後仍未能使用SC Mobile，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。~ Wes\",[1764656768,40000000]],null,[\"106738199702053616935\",\"Raymond chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKj_-duQIniwNOBqGntRo0xSa5af7iUL0OnoM1HAl4n_3qC\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"544cc28e-0f36-4ef3-86ad-81fc24810b72\",[\"Ho Yin Tong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOQpL_zrYp9BILPhLrCJ4kugVX5La23nxq3WK9TiG-vhnsMx3z\\u003dmo\"]]],1,null,\"我認為你們的網絡服務安全很有問題，因為我在這一年已經改了兩次密碼，我已經懷疑會不會有，有心人偷帳號\",[1763364288,558000000],1,[\"Standard Chartered Bank PLC\",\"你好Ho Yin Tong，感謝你的反饋，我們銀行重視客戶的網上銀行安全及使用體驗，為進一步加強安全性，我們會不定時更新銀行的安全設置。登入SC Mobile時除了輸入用戶名稱及密碼，也可以透過生物驗證登入。而登入網頁版網上理財需使用 SC Mobile Key進行驗證，SC Mobile Key已取代一次性短信密碼以加強網上理財認證的保安措施，以進一步保障客戶的流動理財賬戶安全，我們會繼續優化SC Mobile 以令客戶獲得更佳體驗，並期待獲得你的持續支持及信任，如果對網上銀行或SC Mobile使用上有任何疑慮，可以隨時登入SC Mobile 後點擊右上角的對話標誌，選擇「聯絡及支援」圖示，點撃「即時對話」聯繫線上客戶顧問，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Sara\",[1764144799,81000000]],null,[\"111354240362129950456\",\"Ho Yin Tong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJOQpL_zrYp9BILPhLrCJ4kugVX5La23nxq3WK9TiG-vhnsMx3z\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.9.0\",null,null,null,null,null,1],[\"96f9c16d-8411-4215-b14b-81739bf3f7e7\",[\"Hung Kwan Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLSVGfRzw2NO-OIwValelUU8r6o1WJRuZCEETBe8p84lr_m3A\\u003dmo\"]]],1,null,\"介面設計醜陋、反應慢、Hang機、彈App。總結使用體驗非常惡劣，可以的話想給予 0 星。\",[1763278337,327000000],1,[\"Standard Chartered Bank PLC\",\"你好Hung Kwan Leung，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。如閣下的SC Mobile App已經更新到最新版本，但閃退問題仍然持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。謝謝。 ~ Danny\",[1764140065,399000000]],null,[\"118140982840730002309\",\"Hung Kwan Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLSVGfRzw2NO-OIwValelUU8r6o1WJRuZCEETBe8p84lr_m3A\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"39e72128-770e-4054-a7b7-051e75f94949\",[\"Edmund Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL9-pzKt2xtsUhd71Lo8Zwda8qPUhxr0bLdOBmugQT4GV3D2g\\u003dmo\"]]],1,null,\"最近360 Rewards版面系統非常唔正常，一係經常load好耐入唔到跟住彈App，一係入到版面又話你無咗電話號碼，email等資料，一係confirm完後入OTP無反應或者話你入錯或者成功入到都係兌換失敗，結果浪費我半個鐘都係唔成功。請盡快跟進修正，再係咁我以後唔用渣打卡消費。\",[1763170355,274000000],11,[\"Standard Chartered Bank PLC\",\"你好Edmund Yeung，抱歉未能為你帶來流暢的SC Mobile 使用體驗。我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。謝謝。 ~ Danny\",[1764143988,26000000]],null,[\"116815507425827265549\",\"Edmund Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL9-pzKt2xtsUhd71Lo8Zwda8qPUhxr0bLdOBmugQT4GV3D2g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"04ca3895-8a38-4599-9d7b-fe2ec4dc310a\",[\"christine cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJxi2Z7O2F7Ee7jm0KI0bPVpILtre7f32Hq5U5rywbxf6HcfA\\u003dmo\"]]],1,null,\"2年冇乜改善（唔好同我講乜優化匪語）,越來越差,依家load去主menu都load唔到,指紋login每次都當新登記,係咪炒哂IT用垃圾AI寫app呀？\",[1763085683,569000000],3,[\"Standard Chartered Bank PLC\",\"你好 christine cheung，抱歉未能為你帶來滿意的使用體驗，明白你正在面對指紋認證問題，你可以先將SC Mobile app更新至最新7.9.0 版本，如更新後情況仍持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Danny\",[1764144243,244000000]],null,[\"115852449181976582120\",\"christine cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJxi2Z7O2F7Ee7jm0KI0bPVpILtre7f32Hq5U5rywbxf6HcfA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"19b6be86-2485-437e-b6ad-8f6d76dc4573\",[\"Terry Kong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJK5U9cn2t6jwPHT6XOI9uOiEFCNWG3UpsUAprwIz_UXTrufw\\u003dmo\"]]],2,null,\"渣打銀行的APP簡直是一場系統級的災難！我遭遇了和評論區裡無數受害者一模一樣的問題： 1. 憑空鎖門：突然提示登入密碼錯誤，確保百分百無誤，但就是無法登入。 2. 砸碎鑰匙：最絕望的是，「忘記密碼」功能完全形同虛設！收不到驗證碼、重設流程報錯，唯一的自救通道被徹底堵死。 這已經不是簡單的「Bug」了！一個銀行APP，連最核心的「登入」和「密碼重設」功能都能同時失效，這直接反映了其技術底層的脆弱和對用戶最基本權益的漠視。 當你的錢和帳戶被關在一扇打不開且沒有備用鑰匙的門裡時，你還能信任這家銀行的「安全」和「可靠」嗎？ 自救指南（給同樣被困的難友）： -別再跟APP死磕了！ 線上重設是壞的，純粹浪費時間。 -立刻撥打官方客服電話，要求從後台重設你的網銀登入密碼。 -如果電話解決不了，直接帶上證件去分行，這是最終極且最有效的解決方案。 希望渣打銀行能聽聽用戶的海量哭聲，不要再把責任推給用戶的網路或設備。投入資源，重修你們的APP，是你們對客戶最基本的責任！\",[1762913407,262000000],10,[\"Standard Chartered Bank PLC\",\"你好 Terry Kong，十分感謝閣下抽出寶貴時間與本行分享您的關注。本行會積極聽取多方意見，並不時對產品及客戶服務進行回顧。希望閣下繼續給予本行支持及信任。如果你仍然面對重設密碼問題或不能登入網上銀行的情況，請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我哋線上客戶顧問會爲你提供協助，謝謝。 ~ Sara\",[1764141534,352000000]],null,[\"113663463441755072434\",\"Terry Kong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJK5U9cn2t6jwPHT6XOI9uOiEFCNWG3UpsUAprwIz_UXTrufw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,[true,false],null,1],[\"263ea83c-bd8d-465b-b0ba-8f68323e2fb8\",[\"Allen Yip\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEa338sBMP7Fmnx_UxBTWC0nnIlt3XgAhVfAG2ux1v6-F1j-L7\"]]],1,null,\"每次以指紋登入都要重新登記。荒謬！\",[1762846437,420000000],1,[\"Standard Chartered Bank PLC\",\"你好 Allen Yip，抱歉未能為你帶來滿意的使用體驗，請你先嘗試更新SC Mobile app至最新7.8.0 版本，如情況持續，請你登入網上銀行，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1763363551,304000000]],null,[\"100936331885856542438\",\"Allen Yip\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXEa338sBMP7Fmnx_UxBTWC0nnIlt3XgAhVfAG2ux1v6-F1j-L7\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"f9e60eb3-049c-408c-b05e-d6dbdda7936d\",[\"Hippo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXNB5xswp1_thmuG9nNLsiSN-YSClDBByP8CTAybHOK25ov2Vfi\"]]],4,null,\"垃圾app，而家log in都log in唔到，迫我cut 曬貴行d野係咪？！\",[1762596059,63000000],2,[\"Standard Chartered Bank PLC\",\"你好Lam Yuen Hang，真的很抱歉為您造成了不便，現時請再次嘗試登入。由於登入SC Mobile / 網上理財涉及你的個人資料，如問題仍持續，你可以於渣打銀行網頁 sc.com/hk/zh 右下角，向智能助理Stacy查詢及與我們的線上客戶服務顧問聯絡，我們的線上客戶服務顧問會為你提供協助。謝謝。 ~ Wes\",[1732673653,888000000]],null,[\"106876201877508154118\",\"Hippo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXNB5xswp1_thmuG9nNLsiSN-YSClDBByP8CTAybHOK25ov2Vfi\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,[true,false],null,1],[\"8a249450-2443-4568-a5f6-4c81ca2f4527\",[\"AKI AKI\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVcbkgZjkD_XJq77BRTdZnMGp2VMpZbQKRg0EusigHa9TGpim8G\"]]],1,null,\"完全不行 經常自動重置手指紋登入 即使能重新登入 在下次再登入時又被重置 又無法指紋登入 已經很多次 這麼大的一間銀行做一個手機APP都做不好嗎 將整個IT部門全部炒魷\",[1762529263,755000000],3,[\"Standard Chartered Bank PLC\",\"你好 AKI AKI，抱歉未能為你帶來滿意的使用體驗，請你先嘗試更新SC Mobile app至最新7.8.0 版本，如情況持續，請你登入網上銀行，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1763363503,1000000]],null,[\"113147310346791246351\",\"AKI AKI\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVcbkgZjkD_XJq77BRTdZnMGp2VMpZbQKRg0EusigHa9TGpim8G\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"879b6613-6f0d-429f-b334-11fb2b68da61\",[\"Ho Lam Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX59NTmlHvHL89DvyWLhS3PXc_NxXY8arhTom3Osgo4UbUwTpOq\"]]],1,null,\"程式與裝置不相容, 麻煩與開發人員洽談 Sara, 我的手機已無法更新系統, 所以希望你公司可以考慮再推出下調版本, 讓低端系統的手機用家也能體驗流動程式\",[1762519601,589000000],2,[\"Standard Chartered Bank PLC\",\"你好 Ho Lam Cheung，根據內部測試報告，Android 9.0存在漏洞問題。為確保你的賬戶安全，本行已將SC Mobile APP的最低操作系統要求設置為Android 10.0。你可以嘗試在「設定」應用程式中，點選「關於手機」或「系統」選項，然後點選「檢查更新」，更新你的作業系統為Android 10.0或以上。我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持及理解。 ~ Sara\",[1762505289,156000000]],null,[\"100112725135974172457\",\"Ho Lam Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX59NTmlHvHL89DvyWLhS3PXc_NxXY8arhTom3Osgo4UbUwTpOq\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,null,null,[true,false],null,1],[\"1f6d7f76-7f7e-4838-a259-2adb31a1869c\",[\"maxx kalil\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWu2riB2pvfGySl3Xj5juBkIBgd1vMcvjVnG7RDCOiW96pi7g\"]]],1,null,\"更新後每次登入要重新登記指模 及更新SC key。每次登入也是，不斷重複\",[1762489924,81000000],1,[\"Standard Chartered Bank PLC\",\"你好 maxx kalil，抱歉未能為你帶來滿意的使用體驗，明白你正在面對指紋認證問題，你可以先將SC Mobile app更新至7.8.0 版本，如更新後情況仍持續，請登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Danny\",[1763363310,208000000]],null,[\"108613591125993390874\",\"maxx kalil\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWu2riB2pvfGySl3Xj5juBkIBgd1vMcvjVnG7RDCOiW96pi7g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"5c9a9b84-35c1-4dda-bdca-7a1db17b5ef7\",[\"Zoe Chi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjwEH0Y6PYYHX9kL8U-5P6v46OhZIJRCbwSLj4aFIfNiRpOg\\u003dmo\"]]],1,null,\"我用song H4233, 話手機支援唔到呢個apps,要搵開發人員？？\",[1762413333,275000000],1,[\"Standard Chartered Bank PLC\",\"你好 Zoe Chi，根據內部測試報告，Android 9.0存在漏洞問題。為確保你的賬戶安全，本行已將SC Mobile APP的最低操作系統要求設置為Android 10.0。你可以嘗試在「設定」應用程式中，點選「關於手機」或「系統」選項，然後點選「檢查更新」，更新你的作業系統為Android 10.0或以上。我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持及理解。 ~ Sara\",[1762505241,349000000]],null,[\"106098701018053194641\",\"Zoe Chi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLjwEH0Y6PYYHX9kL8U-5P6v46OhZIJRCbwSLj4aFIfNiRpOg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"7ba55276-33e0-400a-a414-2e3466b992d1\",[\"cp yau\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKEyMwvF0IKp8puuvRYuUC8WK9nDO9t5t4M5wfVNIcXgTUpsg\\u003dmo\"]]],1,null,\"非常擾民的更新版，首先一批舊手機已不能應用，咁唯有上網頁版登入，登入完都要經過App核實批淮。即係現時已成個Account被完全隔絕，什麼都做不上，逼人取消Account，趕客走。另外個App原來没有投訴途徑，要另上網頁版找尋意見回饋去反應，仲要等30日內才回覆。新版本未能帶給客户良好體驗，只剩下愈來愈差的感覺\",[1762164815,128000000],26,[\"Standard Chartered Bank PLC\",\"你好 cp yau，抱歉未能為你帶來滿意的使用體驗，SC Mobile Key現時全面取代一次性短訊密碼。你需透過SC Mobile 登入網上理財。認證程序將直接於你的裝置上進行，以提防騙徒攔截短訊或偽冒身份。而提升Android 版本最低要求旨在希望客戶可於更安全的環境下使用SC Mobile。根據內部測試報告，Android 9.0存在漏洞問題。為確保你的賬戶安全，本行已將SC Mobile APP的最低操作系統要求設置為Android 10.0。你可以嘗試在「設定」應用程式中，點選「關於手機」或「系統」選項，然後點選「檢查更新」，更新你的作業系統為Android 10.0或以上。我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持及理解。 ~ Sara\",[1762505187,526000000]],null,[\"106209591630350856113\",\"cp yau\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKE