,[\"andyyung andyyung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ0HqPl-vrsoJG2BvQvcREYRMZIVtaeV5WeBvXODxkGITN7Yw\\u003dmo\"]]],1,null,\"更新完最新版，APP打開時一值停留在白畫面，我是 Android 16\",[1761891025,844000000],2,[\"Standard Chartered Bank PLC\",\"你好andyyung andyyung，抱歉未能為你帶來流暢的SC Mobile 使用體驗。我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Sara\",[1762411376,148000000]],null,[\"108901484785694589796\",\"andyyung andyyung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ0HqPl-vrsoJG2BvQvcREYRMZIVtaeV5WeBvXODxkGITN7Yw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_app_description\",[2]],[\"vaf_never_display_positive_impact\",[2]],[\"vaf_never_display_difficult_to_use\",[2]]]],null,null,null,1],[\"a6300848-383e-4f2c-9e05-3bacf51daac1\",[\"Fatlun L\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLGyYYhSTfrzhdibcG2Q9Tv50kW66ces7DUcvm3e88J9gtcuQ\\u003dmo\"]]],1,null,\"在你們的app內做一個可以儲存轉數記錄的按鈕有幾難，細銀行app都有呢個功能而你地貴為香港四大銀行只有你們沒有這功能，你們銀行背後理念、思維簡直係反智！為什麼一定要用轉數快或類似功能，唔用一定有原因！你地不如係app內取消普通轉數功能喇！轉數比人又無得儲存圖像…我用緊超過5間銀行app只有你們的app係冇轉數比人後沒有儲存圖的功能！\",[1761617450,685000000],26,[\"Standard Chartered Bank PLC\",\"你好Fatlun L，抱歉為你帶來不便。隨著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。如果你需要向收款人/商戶證明付款紀錄，我哋會於SC Pay「轉數快」、「掃描支付」、本地或海外及跨境轉賬完成付款指示後經電子郵件、推送通知或短訊通知你有關交易狀況，除了使用 「分享」功能，你亦可以提供電子郵件或短訊通知的轉賬紀錄分享給收款人。謝謝。 ~ Carl\",[1747276021,989000000]],null,[\"104112615442881852211\",\"Fatlun L\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLGyYYhSTfrzhdibcG2Q9Tv50kW66ces7DUcvm3e88J9gtcuQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,[true,false],null,1],[\"2be557a9-d187-4802-9ac2-bccc2828c0e7\",[\"kelvin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKCa1Uf0P1nGxnX5OvjhNL2bmWTppNDdeWhxn-klNtrH4N4EQ\\u003dmo\"]]],2,null,\"不能指紋登入，每次要重新加入一次\",[1761562643,546000000],0,[\"Standard Chartered Bank PLC\",\"你好kelvin，抱歉為你帶來不便，明白你正在面對指紋認證問題，你可以先嘗試重新安裝SC Mobile app 至7.8.0 版本，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1761640087,523000000]],null,[\"111149484714065539524\",\"kelvin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKCa1Uf0P1nGxnX5OvjhNL2bmWTppNDdeWhxn-klNtrH4N4EQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"5e62e7aa-f98b-49d0-8528-20aa4ae750a7\",[\"Tyler Ho\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUXCYOYBXAKm_AAOixHgeO56AZmvXzNL4KEPLNZTLe7FpXfahPT\"]]],1,null,\"經常disconnect. 搵客服會斷線，無通知。\",[1761456355,765000000],1,[\"Standard Chartered Bank PLC\",\"你好William Cheng，抱歉未能為你帶來滿意的使用體驗，我們需要更多資料了解並跟進你的個案，你可以先嘗試更新SC Mobile app至最新7.8.0 版本，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1761640047,439000000]],null,[\"106301718543635106505\",\"Tyler Ho\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUXCYOYBXAKm_AAOixHgeO56AZmvXzNL4KEPLNZTLe7FpXfahPT\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]],[\"vaf_never_display_ads_experience\",null,[1]]]],null,null,null,1],[\"c8222044-40f5-4db5-b4b9-1d2dc80cf10e\",[\"Ng Alan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXDrF1TVeMCGLHuo2PeEaQlXaUo6t2dQfGYlL2OlPvTw-kRxMU\"]]],1,null,\"very frustrated about the app. I have to reset my password every time I try to login. it's been a few weeks and the problem's still there.\",[1761381691,462000000],0,[\"Standard Chartered Bank PLC\",\"Hi Ng Alan, sorry for the inconvenience caused. You can update the SC Mobile app to our latest version 7.8.0. If the issue persists, please contact live agent in SC Mobile app for assistance by clicking on the ‘Contact \\u0026 Support’ icon at the top right corner after logged in. We will try our best to assist you to solve the issue. Thank you. ~ Sara\",[1761640022,454000000]],null,[\"102835200075670795608\",\"Ng Alan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXDrF1TVeMCGLHuo2PeEaQlXaUo6t2dQfGYlL2OlPvTw-kRxMU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"584337eb-a241-432b-bc23-89d17bd1333c\",[\"Lam Owen\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-yY4KWTWNaK4zLIHemYgyfjTcPSEc7I39WRjJZ9Y8cGfIEg\\u003dmo\"]]],1,null,\"每次使用總是叫你重新登記指紋登入，根本就是有Bugs , 使用感覺很差。我用的是VIVO 手機，請馬上修正。\",[1761260923,195000000],0,[\"Standard Chartered Bank PLC\",\"你好Lam Owen，抱歉為你帶來不便，明白你正在面對指紋認證問題，你可以先嘗試重新安裝SC Mobile app 至7.8.0 版本，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1761639833,529000000]],null,[\"101664777927300600836\",\"Lam Owen\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ-yY4KWTWNaK4zLIHemYgyfjTcPSEc7I39WRjJZ9Y8cGfIEg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"e9b963b8-821e-4eac-920a-2df3a5dfc7e5\",[\"Ryan Lam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKAyopBCv0tvhOPksmEIymWYlv9TwXMSRK499IyrhRopx0u2Q\\u003dmo\"]]],5,null,\"終於更新番個指紋登入功能👍🏻\",[1761226072,786000000],0,[\"Standard Chartered Bank PLC\",\"你好Ryan Lam，感謝你的反饋。 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。 ~ Sara\",[1761639798,616000000]],null,[\"108830232494068842984\",\"Ryan Lam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKAyopBCv0tvhOPksmEIymWYlv9TwXMSRK499IyrhRopx0u2Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,null,null,null,null,1],[\"fcee17b7-5438-42be-b3bf-fc3e24e03f4f\",[\"William Cheng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVf0YVOx1UNtKbXJpkPaKicFnTvt8DAknd-U8gdyO8od_9N1da9LQ\"]]],3,null,\"為什麼不更新密碼就去不到下一個步驟？ (last updated on 31-Aug-2018)\",[1761224983,937000000],3,[\"Standard Chartered Bank PLC\",\"你好William Cheng，抱歉未能為你帶來滿意的使用體驗，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我哋線上客戶顧問會爲你提供協助。 ~ Sara\",[1761810136,922000000]],null,[\"110530263153034577806\",\"William Cheng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVf0YVOx1UNtKbXJpkPaKicFnTvt8DAknd-U8gdyO8od_9N1da9LQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_deceptive_ads\",[2]],[\"vaf_phase1_making_payments\",[2]],[\"vaf_phase1_budgeting\",[2]]]],null,null,null,1],[\"76b2ec12-7355-4e16-b667-383322c4765f\",[\"CHUN TONG SO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ110FFBBaMCo0gyD-NhJigwh10E4QkS1yG8Y56tNCYoYjhcg\\u003dmo\"]]],1,null,\"個app都唔知乜事，之前都好地地，而家次次登入都叫我啟動生物認證，之前不嬲都係用開指紋登入，而家次次都叫我啟動，前前後後啟動左成十次，再登入都係叫我啟動\",[1761215257,763000000],0,[\"Standard Chartered Bank PLC\",\"你好CHUN TONG SO，抱歉為你帶來不便，關於指紋認證問題，你可以先嘗試重新安裝SC Mobile app 至7.8.0 版本，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1761639495,367000000]],null,[\"107540682657718816294\",\"CHUN TONG SO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ110FFBBaMCo0gyD-NhJigwh10E4QkS1yG8Y56tNCYoYjhcg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"df372ada-33b8-441e-a9c0-0467217b0745\",[\"Chloe Chu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUxvpO0RuCrCb_H5CM2ZMoAPxn8c91X_WVyhoJnI0shlUCEeaTl\"]]],1,null,\"appt有問題,經常無故登入錯誤,最後鎖account,要自己不停重設,向客服職員查詢反映,,只說你自己錯誤,正垃圾.完全不負責任.\",[1761209977,620000000],3,[\"Standard Chartered Bank PLC\",\"你好Chloe Chu，抱歉未能帶來滿意的使用體驗，如情況持續及現時仍未能登入SC Mobile或網上理財，請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我哋線上客戶顧問會爲你提供協助，謝謝。 ~ Sara\",[1760603170,492000000]],null,[\"113778978126770054046\",\"Chloe Chu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUxvpO0RuCrCb_H5CM2ZMoAPxn8c91X_WVyhoJnI0shlUCEeaTl\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.8.0\",null,[[[\"vaf_never_display_negative_ads_impact\",[2]],[\"vaf_never_display_visually_bad\",[2]],[\"vaf_never_display_considerate_of_time\",[2]]]],null,[true,false],null,1],[\"4c9eb800-3b34-483e-afbd-7d666fd1cc75\",[\"Dolphin 123\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJtn3T9hE7kGCpB_QboumDprjaOGoXPElTLEY8ff4HUzDDEog\\u003dmo\