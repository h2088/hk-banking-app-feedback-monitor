,null,1],[\"407ed35b-81d1-40bb-84b2-55e0d6f23ba5\",[\"William Pang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUVd4NwxtVN9V6O9o8s7qYFUNPQeiDD6FD-yrZ1yNb2_nnJ93Ni\"]]],1,null,\"作為銀行app沒有定存選項\",[1760104654,47000000],0,[\"Standard Chartered Bank PLC\",\"你好William Pang，SC Mobile 支援定期存款申請的，登入後，你可以根據以下的步驟開立定期存款或「亞洲萬里通」定期存款：\\n1：於主畫面下方的選單項中選擇「探索」，然後選擇「存款」\\n2：請選擇網上定期存款或「亞洲萬里通」定期存款\\n3：查看推廣詳情、細閱條款及細則，然後點選「立即申請」\\n4：選擇定期種類，點選「開始申請」，選擇貨幣及存款期並輸入存款金額及選擇扣賬戶口\\n5：同意條款及細則並點選「繼續」，你的指示將會被處理。\\n\\n如有需要進一步協助，請在登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Wes\",[1760608910,888000000]],null,[\"101285590422317670246\",\"William Pang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUVd4NwxtVN9V6O9o8s7qYFUNPQeiDD6FD-yrZ1yNb2_nnJ93Ni\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.7\",null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"349bc77b-4191-4299-b9c2-aeb81600bc96\",[\"Kenny Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZzICsaVDOVL3v9dQhbMIzIcYmyW_nbaiz-3mSgVKInofs9Xs\\u003dmo\"]]],1,null,\"垃圾更新，而家手指紋要每一次重新確認\",[1760092405,574000000],3,[\"Standard Chartered Bank PLC\",\"你好Kenny Leung，抱歉未能帶來滿意的使用體驗，有關指紋認證問題，你可以先嘗試重新安裝SC Mobile app，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile App以帶來更佳使用體驗，多謝你的反饋及支持，謝謝。 ~ Wes\",[1760604496,253000000]],null,[\"110907227813996498729\",\"Kenny Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLZzICsaVDOVL3v9dQhbMIzIcYmyW_nbaiz-3mSgVKInofs9Xs\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,null,null,null,null,1],[\"57ab2210-3316-4827-a824-384d0ce7f2f5\",[\"Nicky Siu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUZcsHMSd-cyedrSMN5UqOBk7-fdGlDumk7h8GDFB_QOlDh2TTA\"]]],1,null,\"sc mobile team 你地無病呀嘛？ 過左咁多日再唔fixed指紋問題？唯有俾一星你地，相信會你地由4星好快keep唔到\",[1760074972,318000000],0,[\"Standard Chartered Bank PLC\",\"你好Nicky Siu，抱歉未能帶來滿意的使用體驗，有關指紋認證問題，你可以嘗試重新安裝SC Mobile app，如情況持續，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile app至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗，並期待獲得你的持續支持，謝謝。 ~ Sara\",[1760602713,111000000]],null,[\"101513313313119486864\",\"Nicky Siu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUZcsHMSd-cyedrSMN5UqOBk7-fdGlDumk7h8GDFB_QOlDh2TTA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]],[\"vaf_never_display_ads_experience\",null,[1]]]],null,null,null,1],[\"003f1596-fa31-481d-8283-a8efe9cc2770\",[\"Sunny Lin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX_s9rP7xvtGywAE3gBQvPmq91xQWTwacJcf1coYByI0bnxTwNV_g\"]]],1,null,\"指紋辨識登入突然被重置，設定好後，後來再次登入，指紋辨識又被取消要再啟用。另外，訊息中心所有訊息無故被刪除，要重新設定。打去客服熱線，輸入賬戶資料三次都話錯誤，客服人員完全冇幫助，渣打銀行網上理財系統錯漏百出，好冇安全感，存款安全令人擔心。\",[1760072579,404000000],21,[\"Standard Chartered Bank PLC\",\"你好Sunny Lin，抱歉未能帶來滿意的使用體驗及明白您的登入情況，有關指紋認證問題，你可以嘗試重新安裝SC Mobile app，如情況持續及現時仍未能登入SC Mobile或網上理財，請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我哋線上客戶顧問會爲你提供協助，謝謝。 ~ Sara\",[1760607825,134000000]],null,[\"117215549329948033294\",\"Sunny Lin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjX_s9rP7xvtGywAE3gBQvPmq91xQWTwacJcf1coYByI0bnxTwNV_g\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.9\",null,