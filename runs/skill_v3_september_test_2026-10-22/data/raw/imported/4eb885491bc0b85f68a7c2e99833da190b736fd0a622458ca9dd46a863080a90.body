{"author":{"uri":{"label":"https://itunes.apple.com/hk/reviews/id291757264?l=en"}, "name":{"label":"dustandshadow"}, "label":""}, "updated":{"label":"2026-06-30T21:30:37-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"7.15.0"}, "id":{"label":"14247980785"}, "title":{"label":"Many ad notifications but if turned off you don’t get authorisation requests"}, "content":{"label":"Mostly works fine as an authentication app BUT if notifications are turned out, SC sends you plenty of ads. But turning them off means you don’t get card authorisation notifications! PLUS, I just ordered something and when I opened SC app to authenticate, it made me download a 165MB update and I had to cancel my transaction. Terrible user experience", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/hk/review?id=445795688&l=en&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/hk/reviews/id301206968?l=en"}, "name":{"label":"one*2"}, "label":""}, "updated":{"label":"2026-06-29T08:03:02-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"7.15.0"}, "id":{"label":"14241268643"}, "title":{"label":"keeps asking to upgrade"}, "content":{"label":"This app is extremely frustrating to use. It keeps asking me to upgrade at the exact moment when I need to approve a transaction. After updating, the approval message disappears, and I have to go through the whole transaction process again. This is very annoying and creates a lot of unnecessary inconvenience.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/hk/review?id=445795688&l=en&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
