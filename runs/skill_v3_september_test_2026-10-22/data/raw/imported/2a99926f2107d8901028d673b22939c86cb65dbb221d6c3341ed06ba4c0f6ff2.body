ull,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,null,null,1],[\"5ebeafae-1c2d-4b44-ba8f-247a2ebbc901\",[\"chun yiu yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJXVvxgzMsRk_PCe2eS_BeXyIJ3Pg7_F5OZsVzXiUg6_AkS8Q\\u003dmo\"]]],5,null,\"good\",[1747215275,444000000],0,[\"Standard Chartered Bank PLC\",\"Hello chun yiu yeung, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to continuing to provide you with quality services in the future and your continuous support. ~ Danny\",[1747274797,865000000]],null,[\"108343597587969334570\",\"chun yiu yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJXVvxgzMsRk_PCe2eS_BeXyIJ3Pg7_F5OZsVzXiUg6_AkS8Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,null,null,1],[\"9993ec3d-55b3-4c15-8d46-94e0b136b447\",[\"joanna joanna\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMXOloCGdAXdeo6BiWX0l9jrJTvP3P0IzKsMlRTsJmPRaMZ4Xr\"]]],1,null,\"登記成日話唔得，又話個登入名稱及不碼不乎，重忘記密碼再入，又話個apps登記過又唔俾再用，又話要delete 個apps再登記，已經登記n次，你地銀行個apps真係好癈，點用呀，又要上網訂野，要確認付款都確認唔到啦，正垃圾\",[1747117796,619000000],2,[\"Standard Chartered Bank PLC\",\"你好joanna joanna，很抱歉未能為你帶來滿意SC Mobile 體驗，我們需要更多資料了解並及時跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1747299655,860000000]],null,[\"108868659022877447566\",\"joanna joanna\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMXOloCGdAXdeo6BiWX0l9jrJTvP3P0IzKsMlRTsJmPRaMZ4Xr\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,null,null,1],[\"033514f9-db80-4b5f-bc6c-e614d5741139\",[\"Kit Harry\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK2-0uJEnXZ2IOzQifMvBqBkxpRKuJA_O-XY4-iwc4Fp2cwvw\\u003dmo\"]]],1,null,\"煩Sss，4月尾更新app要認證，前日離港後想轉錢去支付寶，唔知做乜又要認證。煩不煩人！離港收唔到sms認證，結果要窮遊。\",[1747013378,647000000],0,[\"Standard Chartered Bank PLC\",\"你好Kit Harry ，抱歉為你帶來不便，客戶使用SC Mobile時需要設定6位數字的SC Mobile Key，設定時需要進行電郵及短訊一次性密碼驗證。一般進行高風險交易時例如新增收款人，便需使用SC Mobile Key進行認證及授權，這是銀行其中一項保安措施，用以保障賬戶安全。我們會繼續優化SC Mobile App以令客戶獲得更好體驗，謝謝。 ~ Wes\",[1747904224,612000000]],null,[\"106256931862917682584\",\"Kit Harry\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK2-0uJEnXZ2IOzQifMvBqBkxpRKuJA_O-XY4-iwc4Fp2cwvw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,null,null,1],[\"bddcdaa3-c90a-4ecf-bc0f-889b49c9a424\",[\"Joan Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVzllwaDVy65NltJYSBni_6Pa7XU9YNTsxfILTPjbsJWwNHa-c\"]]],4,null,\"👍\",[1746936513,314000000],0,[\"Standard Chartered Bank PLC\",\"你好Joan Cheung，感謝你的支持，我們會繼續致力為客戶提供最佳服務，並期待獲得你的持續支持。 ~ Carl\",[1747016546,746000000]],null,[\"114173123718076196414\",\"Joan Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVzllwaDVy65NltJYSBni_6Pa7XU9YNTsxfILTPjbsJWwNHa-c\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.7\",null,null,null,null,null,1],[\"00e8fdcf-8c66-467a-8004-d25867be1053\",[\"K HA\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV279caxfLxoKgmOO-JoBI1-niGjr9foUAoa2ONvsDPPteOXupZBA\"]]],1,null,\"我連1星都唔想畀！ 登入後經常冇任何反應，已經發生多次。 我使用過不同銀行的app，你哋銀行真係最唔穩定。 我睇到係Google 都有好多人反映唔同的問題，亦都唔係一日半日嘅事。 可見你哋根本冇認真處理過相關問題。 我已經連續三天登入後，版面完全冇反應，按任何制都冇反應，請告知如何處理！\",[1746698772,576000000],30,[\"Standard Chartered Bank PLC\",\"你好K HA，很抱歉未能為你帶來滿意的SC Mobile 用戶體驗，我們需要更多資料了解並及時跟進你的個案。請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1747274293,978000000]],null,[\"105232435903553600574\",\"K HA\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV279caxfLxoKgmOO-JoBI1-niGjr9foUAoa2ONvsDPPteOXupZBA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.5\",null,null,null,[true,false],null,1],[\"aa9db450-b515-4390-a79d-3c57ec32a8b0\",[\"王安\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVySlbwTKdvpyaCVnY3TbomlPzc5-47Q0N5YNhnrfirSxOA7otL\"]]],5,null,\"工作人员服务有礼。\",[1746692366,969000000],0,[\"Standard Chartered Bank PLC\",\"你好王安，多謝你的支持與鼓勵，我們會繼續致力為客戶提供最佳服務，並期待獲得你的持續支持。~ Carl\",[1746782026,669000000]],null,[\"116866904706694422780\",\"王安\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVySlbwTKdvpyaCVnY3TbomlPzc5-47Q0N5YNhnrfirSxOA7otL\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.4\",null,null,null,null,null,2],[\"45459703-ebb3-4c3c-822d-fd8c2f8506fc\",[\"C C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKSzXRG56DmByVMgNb4DCaas6mbu-R2C4GPYqkpercX5FmtuMw\\u003dmo\"]]],2,null,\"個app麻麻地 搵左勁耐申請影好耐相後先failed，唔得原來要update個app 講清楚開戶，要喺存款果度click入去先搵到 個自動客服剩係提登入後開戶...鬼唔知咩...入到去搵黎搵去都搵唔到\",[1746587305,273000000],0,[\"Standard Chartered Bank PLC\",\"你好 C C ，抱歉未能為你帶來滿意的使用體驗，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗，如有任何關於SC Mobile開戶問題需要協助，你可於渣打銀行網頁右下角，點擊智能助理Stacy圖示及與聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Sara\",[1747100069,483000000]],null,[\"115836461720199515617\",\"C C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKSzXRG56DmByVMgNb4DCaas6mbu-R2C4GPYqkpercX5FmtuMw\\u0