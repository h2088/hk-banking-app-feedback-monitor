)]}'

[["wrb.fr","oCPfdb","[[[\"3f041488-f26a-4ada-88b3-9d347782b6a9\",[\"F Mak\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWk4f17nBuKXXskqJngRdXL1KA9M8tJdOGh-CV1l-0Sa-zPDKXx3Q\"]]],4,null,\"使用方法清晰易明\",[1755006656,378000000],3,[\"Standard Chartered Bank PLC\",\"你好F Mak，多謝你的支持，我們會繼續致力為客戶提供最佳服務，並期待獲得你的持續支持。 ~ Carl\",[1755242981,219000000]],null,[\"108049935235253430121\",\"F Mak\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWk4f17nBuKXXskqJngRdXL1KA9M8tJdOGh-CV1l-0Sa-zPDKXx3Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"8cceb9fe-beb1-47af-abb5-83e6f00ee80d\",[\"Rics Chiu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUZhTwDiCwfwGkMBAXTEdFli9hCCW5AumVN3f59S-YMsCsOp1ir6A\"]]],1,null,\"改不到通訊地址，SC app 裡的內置人工智能，所指出的更改地址網站路徑，全是老作的。本人只有 渣打信用咭 國泰飛行數戶口，沒有任何SC理財戶口。\",[1754927702,175000000],9,[\"Standard Chartered Bank PLC\",\"你好Rics Chiu，如你登入SC Mobile 後，於「服務」中沒有「更新客戶資料」的選擇，代表你沒有登記全面的網上理財服務。如你持有信用卡及電子理財私人密碼 (TIN) ，請你前往www.sc.com/hk/zh/，於置頂目錄上選擇「登入」\\u003e「登入渣打網上理財」，選擇「以您的電話理財卡號碼登記網上理財/流動理財」重新登記渣打網上理財以享用全面嘅數碼銀行服務，然後便可以透過SC Mobile 更改通訊地址。如需要更多協助，請登入SC Mobile後點擊右上角的對話標誌選擇「聯絡及支援」圖示聯繫線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Carl\",[1755228425,728000000]],null,[\"110507567252412475401\",\"Rics Chiu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUZhTwDiCwfwGkMBAXTEdFli9hCCW5AumVN3f59S-YMsCsOp1ir6A\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"4cf9765b-f683-4ecb-89f2-a4b1cdc3bb01\",[\"BM WONG\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKmiFP-w_RkoxWQfv7_mEjVSwE52uZIxgVanaod1WmYq3vUhw\\u003dmo\"]]],1,null,\"系統勁差。SC mobile key 冇反應，就唔可以login. Why?\",[1754737248,934000000],1,[\"Standard Chartered Bank PLC\",\"你好BM WONG，抱歉未能為你帶來滿意嘅使用體驗，現時最新版本係7.7.5，如果你嘅SC Mobile已經係最新版本仍未能登入，為進一步協助，我哋需要更多資料了解並跟進你的個案。請你於渣打銀行網頁 sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我哋線上客戶顧問會爲你跟進及提供協助。 ~ Carl\",[1755224311,95000000]],null,[\"112741526808181500556\",\"BM WONG\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKmiFP-w_RkoxWQfv7_mEjVSwE52uZIxgVanaod1WmYq3vUhw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"c9a7168a-3e03-4824-8386-c49ad688ef51\",[\"SIL Ver\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyz7lmlcNsi9cAZTnAYchIEBmo7sqJTz0HJkvIVoQqiuKHUmRm\"]]],1,null,\"還了信用卡錢， 還顯示應付款額呀？ 其他銀行人家不會咁\",[1754731159,793000000],2,[\"Standard Chartered Bank PLC\",\"你好SIL Ver，抱歉未能為你帶來滿意使用體驗，關於SC Mobile信用卡版面顯示，到期應付金額及到期繳款日是按月結單週期更新，待新一期信用卡月結單發出後便會更新資料。如你需要進一步協助，請於登入SC Mobile後點擊右上角的「聯絡及支援」圖示透過智能助理Stacy聯絡線上客戶顧問，線上客戶顧問會爲你提供協助。我們亦會持續優化SC Mobile以提供更好的用戶體驗，謝謝。 ~ Carl\",[1755244670,621000000]],null,[\"112409213927607724691\",\"SIL Ver\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUyz7lmlcNsi9cAZTnAYchIEBmo7sqJTz0HJkvIVoQqiuKHUmRm\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"ad83d874-ec2d-4312-b09f-b64d70cac31a\",[\"YEUNG ANDY\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMIdPG6G0s_mWGqyO8j8JqFmcO8mRqgIUouUPdaMvfxPgJYqY\"]]],1,null,\"你哋個app又炒咗喇，更新完無限彈app，叫你哋啲senior man唔好坐住個腦諗嘢，諗下點樣正常開到個app先啦\",[1754727788,694000000],1,[\"Standard Chartered Bank PLC\",\"你好 YEUNG ANDY，抱歉未能為你帶來滿意嘅使用體驗，現時最新版本係7.7.3，如果你嘅SC Mobile已經係最新版本，並需要進一步協助，我哋需要更多資料了解並跟進你的個案。請你於渣打銀行網頁 sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，輸入「SC Mobile 閃退問題」聯絡線上客戶顧問。我哋線上客戶顧問會爲你跟進及提供協助。 ~ Sara\",[1754906089,318000000]],null,[\"105772867750181086323\",\"YEUNG ANDY\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUMIdPG6G0s_mWGqyO8j8JqFmcO8mRqgIUouUPdaMvfxPgJYqY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,[true,false],null,1],[\"4d608976-cc97-4209-9b80-26d0146d24ea\",[\"Dannysang Chian\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpDZrGkNUgui-_wYL4BNVwntF-mBicC4p7q_73SWsDhTuDl6Jp\"]]],1,null,\"垃圾\",[1754690299,709000000],1,[\"Standard Chartered Bank PLC\",\"你好 Dannysang Chian，感謝你的反饋。 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。 ~ Sara\",[1754906026,150000000]],null,[\"109681585181682772018\",\"Dannysang Chian\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWpDZrGkNUgui-_wYL4BNVwntF-mBicC4p7q_73SWsDhTuDl6Jp\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"b31a7581-a90d-43bb-814b-4c2af4c4c3d8\",[\"高高\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKn9_9w9jqRIXv9EKA5AlKr4-DmjaZbsZYduhz3AbvBTS-O3g\\u003dmo\"]]],1,null,\"剛剛入完，轉頭話我要整返mobile key， 跟程序攞密碼輸入幾次都唔得入唔到， 點算好\",[1754650780,321000000],3,[\"Standard Chartered Bank PLC\",\"你好 高高，抱歉未能為你帶來流暢的SC Mobile用戶體驗，如果你現時未能登入及成功登記SC Mobile Key，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Sara\",[1754906713,42000000]],null,[\"115548261060140031056\",\"高高\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKn9_9w9jqRIXv9EKA5AlKr4-DmjaZbsZYduhz3AbvBTS-O3g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"a1209873-68f0-49ff-a789-d56b1134875e\",[\"chi chun koo\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAyeVLNXvQjQlLaUr0sFwl-5rOXArJ_mc9v7VtfdXM9ShsrA\\u003dmo\"]]],5,null,\"方便\",[1754626934,482000000],0,[\"Standard Chartered Bank PLC\",\"你好chi chun koo，感謝你的寶貴意見。我們會繼續致力為客戶提供最佳服務，並期待獲得你的持續支持。~ Carl\",[1754634210,179000000]],null,[\"109097479005630483696\",\"chi chun koo\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIAyeVLNXvQjQlLaUr0sFwl-5rOXArJ_mc9v7VtfdXM9ShsrA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,2],[\"6f98e012-882e-42b3-9775-bbc4222b9b76\",[\"Raymond Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUprMJ_uqYHZF9iqo94E9L8Y5jChO4ns7Ldz3EuqLvrl5O8PLnv\"]]],1,null,\"垃圾,點解要強迫人用手機登入及使用你個app\",[1754625249,852000000],3,[\"Standard Chartered Bank PLC\",\"你好Raymond Cheung，感謝你的反饋，渣打銀行一直致力於保障所有客戶，以SC Mobile Key驗證網上理財登入可以為登入安全提供多一重保障。客戶於登記SC Mobile Key後仍可透過網頁登入網上理財，閣下只需要在登入網上理財時於閣下SC Mobile Key綁定之手機内批准登入，謝謝。~ Carl\",[1754634342,667000000]],null,[\"113511997212868166503\",\"Raymond Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUprMJ_uqYHZF9iqo94E9L8Y5jChO4ns7Ldz3EuqLvrl5O8PLnv\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"53ee0834-65ad-424e-9c48-f3dc55e69fea\",[\"garfield Shum\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIpB04v65cAIuVxjiPFFZegdP4iGL5mc84-HNInYBebqtz9hw\\u003dmo\"]]],1,null,\"I living in Canada, I can't download the app, what can I do?\",[1754621246,544000000],0,[\"Standard Chartered Bank PLC\",\"Hi garfield Shum, SC Mobile is supported for download on overseas and smartphones with Android 9.0 or higher. If you retry download and the issue persists, please visit : sc.com/hk, tap the icon of Stacy, to connect with our live agent and share more details about your case. We’re here to assist you promptly. Thank you. ~ Sara\",[1754647595,330000000]],null,[\"102973458551483504678\",\"garfield Shum\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIpB04v65cAIuVxjiPFFZegdP4iGL5mc84-HNInYBebqtz9hw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"0620eb67-c9c1-401f-b4e6-1be9bb73388f\",[\"chan tak fai\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFctsoZKT_3LMwg7iZK_sBZIrpZkdfLNnvw9R55WEjUdmy8g\\u003dmo\"]]],3,null,\"為何今日無法開啟app？\",[1754543376,366000000],0,[\"Standard Chartered Bank PLC\",\"你好chan tak fai，感謝你的反饋，目前系統運作正常，請重新嘗試登入SC Mobile，如問題持續，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Danny\",[1754634192,671000000]],null,[\"101702728910669924518\",\"chan tak fai\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFctsoZKT_3LMwg7iZK_sBZIrpZkdfLNnvw9R55WEjUdmy8g\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.3\",null,null,null,null,null,1],[\"38b90312-b5d7-469b-91da-aef272bc562e\",[\"VWS C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI_1Qxm2fqKBTMAew1EdGtceCHH0zWu0s2Qh6Wu4xilDu2L\\u003dmo\"]]],1,null,\"垃圾app, otp等一世都無\",[1754475281,660000000],1,[\"Standard Chartered Bank PLC\",\"你好VWS C，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你登入SC Mobile後，點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Carl\",[1754643043,422000000]],null,[\"100314743751650221218\",\"VWS C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocI_1Qxm2fqKBTMAew1EdGtceCHH0zWu0s2Qh6Wu4xilDu2L\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"4874b720-997b-44ee-8332-5d0c4decb890\",[\"Mami Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIwp9g-jbQ75g1Leam9cCNx1wUhOWqJ32dzIn-oSrH2C8UdIQ\\u003dmo\"]]],1,null,\"ANDROID 9 其實不能使用你哋的sc mobile app？\",[1754460399,1000000],0,[\"Standard Chartered Bank PLC\",\"你好 Mami Yeung，我們渣打流動理財是支援安卓智能電話(Android 9.0或以上) 。你可以查看您的APP版本是否已使用我們最新的版本，目前為7.7.0 ，以及檢查設備的存儲空間是否充足，如需進一步協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Sara\",[1754475212,14000000]],null,[\"111240132503624813997\",\"Mami Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIwp9g-jbQ75g1Leam9cCNx1wUhOWqJ32dzIn-oSrH2C8UdIQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"fb488ffb-954f-4fe1-a239-e9206a215605\",[\"Shum CHI YAN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW4yvUdBlruidN1Np912uk0uoVZa44GinDvJ7CYZk1nu3LaMNY\"]]],3,null,\"無法截圖很麻煩\",[1754300679,201000000],0,[\"Standard Chartered Bank PLC\",\"你好Shum CHI YAN，隨著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。如果你需要向收款人/商戶證明付款紀錄，我哋會於SC Pay「轉數快」、「掃描支付」、本地或海外及跨境轉賬完成付款指示後經電子郵件、推送通知或短訊通知你有關交易狀況，你亦可以於轉賬成功後點擊 「分享」，把轉賬的紀錄分享給收款人。感謝你的理解及支持，謝謝。 ~ Sara\",[1754475166,508000000]],null,[\"104492844507819797482\",\"Shum CHI YAN\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjW4yvUdBlruidN1Np912uk0uoVZa44GinDvJ7CYZk1nu3LaMNY\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,[true,false],null,1],[\"1759cbd8-6553-43e7-bbfb-7da1e8b23780\",[\"Kh Yeung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVaQ6zpmPe731ph7LIaMMUlXE7LsnVqF0bX58aucU0l3JIeKqBA\"]]],2,null,\"Too bad\",[1754300492,72000000],0,[\"Standard Chartered Bank PLC\",\"Hello Kh Yeung, thank you for your valuable feedback. We will continue to optimize the SC Mobile App to provide our customers with the best experience and look forward to your continuous support. ~ Sara\",[1754475139,937000000]],null,[\"110364277098850060605\",\"Kh Yeung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVaQ6zpmPe731ph7LIaMMUlXE7LsnVqF0bX58aucU0l3JIeKqBA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"13d7a994-073d-42d5-85ea-30cf4c49d034\",[\"freedom ying\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJwNY-gslxNrcwgQQl7gdpmpWxRuqEi3TzzIsD5sSqDm_2BkA\\u003dmo\"]]],1,null,\"垃圾app，用唔到渣打網上理財，迫人用呢個app，又唔俾螢幕截屏。\",[1754284096,673000000],2,[\"Standard Chartered Bank PLC\",\"你好freedom ying，為保障客戶網上理財安全，現時登入網頁版網上理財時，需要使用SC Mobile Key 進行驗證登入，而SC Mobile Key是自訂6位數字且必須綁定最多一部流動裝置，App内認證會比短訊一次性密碼更安全。另外，隨著惡意軟件相關事件的增多，惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。如果你需要向收款人/商戶證明付款紀錄，我哋會於SC Pay「轉數快」、「掃描支付」、本地或海外及跨境轉賬完成付款指示後經電子郵件、推送通知或短訊通知你有關交易狀況，你亦可以於轉賬成功後點擊 「分享」，把轉賬的紀錄分享給收款人。感謝你的理解及支持，謝謝。 ~ Sara\",[1754475088,377000000]],null,[\"100848639851788216674\",\"freedom ying\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJwNY-gslxNrcwgQQl7gdpmpWxRuqEi3TzzIsD5sSqDm_2BkA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,[true,false],null,1],[\"7bb5cd39-a5cc-457e-b611-73583fc7a8f3\",[\"Eros Fung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWWqYSJ-ipVWoyylV112DDauLOfdvcjMBawc3MxawfdgaPJVh4\"]]],1,null,\"失敗，没有中文版嗎？\",[1754065408,147000000],0,[\"Standard Chartered Bank PLC\",\"你好Eros Fung， SC Mobile 可以設定繁體中文顯示，語言設定可以在登入前點擊右上角的問號標誌後，選擇「Language/語言」更改為中文。如未能經此途徑更改語言設定，請登入SC Mobile後點擊右上角的對話標誌選擇「聯絡及支援」圖示聯繫線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Sara\",[1754474641,567000000]],null,[\"101579178341494473964\",\"Eros Fung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWWqYSJ-ipVWoyylV112DDauLOfdvcjMBawc3MxawfdgaPJVh4\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"3a578c26-fe41-4d45-87f9-1d246c51fed1\",[\"do o\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWyjepBdEPvXQkpNnAx8fw6z0A9EXlta5YZxlmmpcNcOvlEn9n_\"]]],1,null,\"迫人裝app先用到online banking垃L圾\",[1754038690,397000000],1,[\"Standard Chartered Bank PLC\",\"你好do o，很抱歉為你帶來不便，渣打銀行一直致力於保障所有客戶，以SC Mobile Key驗證網上理財登入可以為登入安全提供多一重保障，增強客戶對於詐騙和釣魚短訊的保護。如你使用SC Mobile時需要更多協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助。 ~ Danny\",[1754459054,789000000]],null,[\"115364946628051048378\",\"do o\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWyjepBdEPvXQkpNnAx8fw6z0A9EXlta5YZxlmmpcNcOvlEn9n_\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"dc5ce53b-e521-465d-9802-f77b8ee01d89\",[\"tomy1998\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKp5GcaCMkMPQxoa_j1qYxIVlwXjQyEiZFe60IqIFDyhBDmbw\\u003dmo\"]]],1,null,\"一間銀行app點解可以做到咁差。本身用開網上銀行網頁版登入。結果今日呢間垃圾銀行吾再比用短訊驗證碼登入。迫你用呢個垃圾app。問題你地知吾知你地個垃圾app跟本用吾到。係咪要為你地間銀行app更新換新電話?超級無奈\",[1754030201,691000000],1,[\"Standard Chartered Bank PLC\",\"你好tomy1998，感謝你的反饋，渣打銀行一直致力於保障所有客戶，以SC Mobile Key驗證網上理財登入可以為登入安全提供多一重保障，增強客戶對於詐騙和釣魚短訊的保護。如你使用SC Mobile時需要更多協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助。~ Carl\",[1754301206,682000000]],null,[\"107297271602131920859\",\"tomy1998\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKp5GcaCMkMPQxoa_j1qYxIVlwXjQyEiZFe60IqIFDyhBDmbw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"6.33.0\",null,null,null,null,null,1],[\"5d72c073-7f52-40a1-97fe-8b9b24dc3440\",[\"Leung Stella\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIgJMhxtV2BE9TTy7jLzohpOx6V_zVe4XA6NahK6IbcqJmjtQ\\u003dmo\"]]],1,null,\"真的好好差的app，為什麼這麼爛的app還要用上在網上銀行，我今日玩咗3個鐘都冇辦法上到網上銀行，其他銀行的app是非常好用方便，你們的app非常浪費時間，又沒有用，為甚麼還要客人用呢？\",[1754020185,845000000],15,[\"Standard Chartered Bank PLC\",\"你好Leung Stella，抱歉未能為你帶來滿意的流動理財用戶體驗，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助。~ Carl\",[1754289416,55000000]],null,[\"115221714860827529075\",\"Leung Stella\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIgJMhxtV2BE9TTy7jLzohpOx6V_zVe4XA6NahK6IbcqJmjtQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"e0ffafb3-4ec3-48f8-b354-a3467f324b5a\",[\"M Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmZnsasUHxPZLa214R-DVZrLIcg7MwTUJkpuk3_92SpbHpeQ\\u003dmo\"]]],1,null,\"設計極差, 極多廣告, 居然不能買賣股票！咁呢個係什麼網上銀行app？ 趕客 絕對會考慮轉到其他銀行\",[1753956101,321000000],3,[\"Standard Chartered Bank PLC\",\"你好M Chan， 抱歉未能為你帶來滿意的流動理財用戶體驗，SC Mobile設有不同的推廣去切合客戶的需要及帶來最新的資訊，期望為客戶帶來更好的銀行體驗，如有需要，你可以登入SC Mobile 並點擊「 服務」 ，然後選擇「 通訊喜好」 及「 優惠及產品資訊」 去更新SC Mobile 的廣告通訊喜好設定，最多需時10個工作天處理，另外，SC Mobile 與SC Equities 現時分別專責一般理財與股票投資服務。 以確保提供更專注及流暢的體驗。我們會持續優化及研究整合SC Mobile 為客戶帶來更好的使用體驗，謝謝你的反饋。 ~ Carl\",[1754287920,290000000]],null,[\"114924236293519545145\",\"M Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmZnsasUHxPZLa214R-DVZrLIcg7MwTUJkpuk3_92SpbHpeQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"e698f678-6a85-465a-a6e9-14dc984132d0\",[\"Raymond Li\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJwhuRZZuZMUTh3DwCtqCKZqvSdFedeiyz9_5AdgGcWs9Rh2Mw\\u003dmo\"]]],5,null,\"ok\",[1753944739,155000000],0,[\"Standard Chartered Bank PLC\",\"Hi Raymond Li, thank you for your valuable feedback. We look forward to your continuous support. ~ Danny\",[1754286681,113000000]],null,[\"104523017944420274956\",\"Raymond Li\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJwhuRZZuZMUTh3DwCtqCKZqvSdFedeiyz9_5AdgGcWs9Rh2Mw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"5cd8605d-26fe-4fc3-a661-81dd9947dd69\",[\"kei magic\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocInJnot7IA3gNshQxaiIE59B0-NlsywG_P_BAU54M8bvMyF3Q\\u003dmo\"]]],2,null,\"能不能不要每次轉換app的時候就強制登出呢，銀行交易本身就為了處理不同資金調配，一轉換就強制登出根本處理不到！！！\",[1753760486,725000000],6,[\"Standard Chartered Bank PLC\",\"你好kei magic，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息（如有），我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1754459026,647000000]],null,[\"103323681000183292856\",\"kei magic\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocInJnot7IA3gNshQxaiIE59B0-NlsywG_P_BAU54M8bvMyF3Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"890a7f03-4012-491b-832d-1e5021f35435\",[\"mm Mak\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXyiQsDpsVufodJ25oAXSQIEHd2CL3apOMgGVFbJwl5RpIRpg-l\"]]],5,null,\"efficient\",[1753675686,587000000],0,[\"Standard Chartered Bank PLC\",\"Hi mm Mak, thank you for your valuable feedback. We look forward to your continuous support. ~ Sara\",[1753850670,546000000]],null,[\"105378483536005448882\",\"mm Mak\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXyiQsDpsVufodJ25oAXSQIEHd2CL3apOMgGVFbJwl5RpIRpg-l\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"3c57f97b-6e12-4612-be1c-97a96975636a\",[\"eddy\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK675pSRbE15O5vJ1e3YHhG4xeIJeGNVPYJpd27ixQbtUnxvMvm\\u003dmo\"]]],1,null,\"你又要我登記用sc mobile key , 又唔比我登記 sc mobile key ,係咁loop 我現在入唔到app 過唔到數 都唔知你想點，真係覺得放d錢係你銀行好唔安全 d 錢完全郁唔到\",[1753581370,728000000],1,[\"Standard Chartered Bank PLC\",\"你好eddy，很抱歉未能為你帶來流暢的SC Mobile用戶體驗，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Danny\",[1754276102,986000000]],null,[\"109810089256344589748\",\"eddy\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK675pSRbE15O5vJ1e3YHhG4xeIJeGNVPYJpd27ixQbtUnxvMvm\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,null,null,1],[\"a11017bd-a7d1-4abc-9602-c4b02d33e7d9\",[\"M.W. MOW\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIRiYgMboQcDSP-BrehcKZLRk5YgKiqal3cQbxT5MGUBMkXDA\\u003dmo\"]]],1,null,\"麻煩\",[1753413132,750000000],0,[\"Standard Chartered Bank PLC\",\"你好 M.W. MOW，抱歉未能為你帶來滿意的流動理財用戶體驗，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。~ Danny\",[1753424123,797000000]],null,[\"109046204060762978703\",\"M.W. MOW\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIRiYgMboQcDSP-BrehcKZLRk5YgKiqal3cQbxT5MGUBMkXDA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"7f7044c1-a66f-4507-826b-bbdfd423b6fe\",[\"Vicky Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKT_V43uiUyKcVAmXxsooOViUs55SSx3m-_fvdH2xICBTrFsw\\u003dmo\"]]],1,null,\"開戶全部資料輸入後，說無法繼續開戶，沒有任何指示，是等待批核還是有什麼問題，弄得一頭霧水\",[1753245037,254000000],3,[\"Standard Chartered Bank PLC\",\"你好Vicky Lee，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁 sc.com/hk/zh 透過頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問，並提供你開戶申請的參考編號（如有），我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1753424918,363000000]],null,[\"117393523328091869533\",\"Vicky Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKT_V43uiUyKcVAmXxsooOViUs55SSx3m-_fvdH2xICBTrFsw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"73a100b7-3ad0-4b4d-9c2d-72d0a6259ed9\",[\"Ka Fai Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL-_jImLkAUlLZaD29Auy6vDNq4z6-Q36uWxN-OanZE28lPhQ\\u003dmo\"]]],1,null,\"連唔到入網頁登記開户\",[1753237909,744000000],0,[\"Standard Chartered Bank PLC\",\"你好 Ka Fai Cheung，很抱歉為你帶來不便，如你持有有效香港身份證，你可以下載SC Mobile App開立戶口，如果你的SC Mobile已經更新到最新版本但未能成功開戶。請你透過渣打銀行網頁 sc.com/hk/zh 頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息截圖及現正使用的SC Mobile版本，我們的線上客戶顧問會為你提供協助及跟進，謝謝。~ Danny\",[1753689083,252000000]],null,[\"108210587657891076580\",\"Ka Fai Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL-_jImLkAUlLZaD29Auy6vDNq4z6-Q36uWxN-OanZE28lPhQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"39d5f21c-6991-4927-bd21-640c7816e3f4\",[\"Chi Keung Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUr1vYvkFidc9Iq6KUW4CV5oplwwAak97ENrEx7VmN6t2_aCSe-Kg\"]]],5,null,\"SC Mobile HongKong apps, 現已正常運作 ！\",[1753106033,340000000],0,[\"Standard Chartered Bank PLC\",\"你好 Chi Keung Chan，抱歉未能為你帶來滿意嘅體驗。現時SC Mobile登入系統正常運作，暫時未有異常情況。請嘗試安裝最新版本嘅SC Mobile。如問題仍持續，你可於渣打銀行網頁 sc.com/hk/zh 右下角，透過智能助理Stacy與我哋線上客戶服務顧問聯絡跟進，謝謝。 ~ Danny\",[1740018166,472000000]],null,[\"116236355204643857560\",\"Chi Keung Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUr1vYvkFidc9Iq6KUW4CV5oplwwAak97ENrEx7VmN6t2_aCSe-Kg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,[true,false],null,1],[\"2e8da4eb-546f-48aa-8ef1-efa30637c981\",[\"Google 使用者\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"安裝後一開就彈app，完全無法使用，這樣怎樣用SC Mobile Key登入？連帶網上銀行也無法登入，因只支援SC Mobile Key登入，連SMS驗證也沒有，非常垃圾的設計\",[1752840280,657000000],3,[\"Standard Chartered Bank PLC\",\"你好Ran，對於你在使用SC Mobile 時遇到的問題表示歉意，有關於你提到安裝後應用程式無法正常使用的情況，你可以確認您的設備操作系統是否為Android 9.0或以上，以及檢查設備的存儲空間是否充足，如需進一步協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1753690977,337000000]],null,[\"111359130074513546850\",\"Google 使用者\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,2],[\"609ce675-590d-4d61-aefd-0d1976c09cf5\",[\"Ester Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJnIbLGGy_l9LV7LYBufjwy2PMKdIrnzlbdbEATNTn8EOLfOA\\u003dmo\"]]],1,null,\"夜晚8點幾就開唔到個app，咁早做backup?\",[1752755128,540000000],0,[\"Standard Chartered Bank PLC\",\"你好Ester Leung，感謝你的反饋，我們在該時間段內系統運作正常。如果你現時未能登入，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Carl\",[1753696901,636000000]],null,[\"108211959425007776837\",\"Ester Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJnIbLGGy_l9LV7LYBufjwy2PMKdIrnzlbdbEATNTn8EOLfOA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"e0d25d21-79c6-46d0-8a9c-f8c3bdef3c96\",[\"Jack Mak\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU3ISLhM-eynlSFW2-jPB7wfqu45gQKMTqhqXy_oQbHR-vqc9LR\"]]],1,null,\"好多 push 廣告通知\",[1752670544,507000000],0,[\"Standard Chartered Bank PLC\",\"你好 Jack Mak， 抱歉未能為你帶來滿意的流動理財用戶體驗，SC Mobile 設有不同的推廣去切合客戶的需要及帶來最新的資訊，期望為客戶帶來更好的銀行體驗，如有需要，你可以登入SC Mobile 並點擊「 服務」 ，然後選擇「 通訊喜好」 及「 優惠及產品資訊」 去更新SC Mobile 的廣告通訊喜好設定，最多需時10個工作天處理，謝謝。 ~ Danny\",[1752731207,406000000]],null,[\"107736665995247208739\",\"Jack Mak\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU3ISLhM-eynlSFW2-jPB7wfqu45gQKMTqhqXy_oQbHR-vqc9LR\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,[true,false],null,1],[\"d8e0295f-0e7a-422f-ab91-1ea26437d5cf\",[\"C M\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLVB8EUipXziqTBJ_fZK_NMm5O5lvfcnaPOyQ-gP37FX5WAEA\\u003dmo\"]]],1,null,\"由前兩日直到今日，用指紋登入不到，採用了離線密碼，在輸入位置上卻沒有輸入的按鍵....之前一直登入都沒有問題的，究竟發生什麼事呢\",[1752627882,693000000],0,[\"Standard Chartered Bank PLC\",\"你好 C M， 抱歉未能為你帶來滿意的體驗，你可以登入SC Mobile 並點擊「 服務」 ，然後選擇「 密碼及安全」 及「 管理生物識別登入」 去啓動SC Mobile 的生物驗證服務，如啓動後仍遇到這個問題， 請於登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Danny\",[1752739570,314000000]],null,[\"100742442006608630242\",\"C M\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLVB8EUipXziqTBJ_fZK_NMm5O5lvfcnaPOyQ-gP37FX5WAEA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"60a5f6dd-cc3d-4626-9dff-4f0d23eaa875\",[\"will301 lokhim\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXA8jvJmkfFYsSHOAkTniqJ71qqNTJwgDIE5bRHrZSjcGoe0zH7\"]]],1,null,\"個 人臉識別 功能廢到嘔\",[1752241052,8000000],0,[\"Standard Chartered Bank PLC\",\"你好 will301 lokhim，抱歉未能為你帶來滿意的流動理財用戶體驗，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。~ Danny\",[1752743585,321000000]],null,[\"107819974078965307017\",\"will301 lokhim\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXA8jvJmkfFYsSHOAkTniqJ71qqNTJwgDIE5bRHrZSjcGoe0zH7\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,[true,false],null,1],[\"fe2c2776-1959-4fdb-925f-ed5ae33aa323\",[\"神東海\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocICWpKpPR2RRmLDqDyF8y59IswB0nxrUvsp06ADWnaSTnPZSg\\u003dmo\"]]],1,null,\"垃垃圾app，指紋生物認證經常失效，失校重新輸入帳戶密碼，就顯示用戶錯誤或者密碼，但事實根本沒有打錯，又要重新做認證當忘記密碼處理，非常麻煩，我真係打算考慮唔用渣打銀行，咁大間公司一個app可以做到咁垃圾\",[1752239448,227000000],14,[\"Standard Chartered Bank PLC\",\"你好神東海，很抱歉未能為你帶來流暢的SC Mobile用戶體驗，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Danny\",[1753258448,375000000]],null,[\"115413551359680638314\",\"神東海\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocICWpKpPR2RRmLDqDyF8y59IswB0nxrUvsp06ADWnaSTnPZSg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"2e68bb7b-b1ce-4a16-9c03-02cc61f98b6d\",[\"kuk heung tong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL1mZ8hlJTVVo43mP_BElGyiga_-AM0MvNHMsOgkSDABMFyqA\\u003dmo\"]]],4,null,\"Can be more user friendly\",[1752148713,664000000],0,[\"Standard Chartered Bank PLC\",\"Hello kuk heung tong, thank you for your feedback and support. We will continue to optimize the SC Mobile App to provide our customers with the best experience. ~ Wes\",[1752215967,890000000]],null,[\"102216401019243786773\",\"kuk heung tong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL1mZ8hlJTVVo43mP_BElGyiga_-AM0MvNHMsOgkSDABMFyqA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"ae3456a6-438c-4ec0-a288-49fcd850addb\",[\"Siu Fei\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLqW3aAG_fiVrvxzbIMWTG5K6dGHVpUbMYsKuMFXYQ7ccjANQ\\u003dmo\"]]],5,null,\"很好\",[1751643330,654000000],0,[\"Standard Chartered Bank PLC\",\"你好Siu Fei，多謝你的支持與鼓勵，我們會繼續致力為客戶提供最佳服務，並期待獲得你的持續支持。 ~ Carl\",[1751883409,390000000]],null,[\"112510804699216653914\",\"Siu Fei\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLqW3aAG_fiVrvxzbIMWTG5K6dGHVpUbMYsKuMFXYQ7ccjANQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"ec49e2e9-129d-42fe-926d-44e39d15f3f8\",[\"Wu Raymond\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWHPQJQJwuDgb7C_LUw1L7oI8iX3HX23Uo1t97Zv2G_BH3cGHCHxw\"]]],2,null,\"想開立高息馬拉松戶口，第一步選擇開立原因正常，第二步明白開立儲存的確認按鈕只得一半，到第三步睇晒條款後，沒有確認按鈕，點攪？\",[1751554024,540000000],3,[\"Standard Chartered Bank PLC\",\"你好Wu Raymond，抱歉為你帶來不便，為了進一步了解你目前遇到的顯示問題，請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1751946304,735000000]],null,[\"116261311687557699749\",\"Wu Raymond\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWHPQJQJwuDgb7C_LUw1L7oI8iX3HX23Uo1t97Zv2G_BH3cGHCHxw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"e95c9698-0dce-4d7c-a34a-e7ab5db6820a\",[\"Leslie Shiu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUb0RGPkWMC0ADNmjTVyjWpzUKBDeqoftF62mYt2kD-pIDTgoU\"]]],5,null,\"apps很user friendly 簡單快捷方便\",[1751530169,380000000],3,[\"Standard Chartered Bank PLC\",\"你好Leslie Shiu，多謝你的支持與鼓勵，我們會致力為客戶提供最佳服務，並期待獲得你的持續支持。 ~ Danny\",[1751536525,777000000]],null,[\"113218766787564219812\",\"Leslie Shiu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUb0RGPkWMC0ADNmjTVyjWpzUKBDeqoftF62mYt2kD-pIDTgoU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.11\",null,null,null,null,null,1],[\"98da31ae-8836-4c7b-953