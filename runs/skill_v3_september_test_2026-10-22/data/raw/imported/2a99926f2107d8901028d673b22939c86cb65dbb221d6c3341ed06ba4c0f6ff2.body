om/a/ACg8ocKHjpU3-4LpYCTs0HvkQuKE0N1kQ5iuDuJsovkBDc7mKYr1HQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"9824978b-550c-4176-9e8a-c7c976a748c6\",[\"Ingram Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXdql5VlB-FQVkzPPSGCxwUlZz9SKzFONjKT6JLj6wLzPfCpGE\"]]],1,null,\"垃圾，更新後登入完成又叫重新登入，登入左五次都係叫我重新登入，我down 個app就係為左不停登入，係咪好好玩！\",[1751001053,693000000],0,[\"Standard Chartered Bank PLC\",\"你好Ingram Leung，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁 sc.com/hk/zh 透過頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、完整錯誤信息，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\",[1751007314,736000000]],null,[\"104799807828379893714\",\"Ingram Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXdql5VlB-FQVkzPPSGCxwUlZz9SKzFONjKT6JLj6wLzPfCpGE\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"6.21.0\",null,null,null,null,null,1],[\"4b2a0b75-ac3a-4dfc-812d-8817c9816a4a\",[\"Eva LO\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWK1e-nE5Pj1QL-vSJZeBRcJjqbafZWCfnefe5q5xOwgvGnvCb\"]]],5,null,\"清晰方便使用\",[1750751498,779000000],0,[\"Standard Chartered Bank PLC\",\"你好 Eva LO，多謝你的支持與鼓勵，我們致力為客戶提供最佳服務，並期待獲得你的持續支持。~ Wes\",[1750846784,442000000]],null,[\"103904117310521884083\",\"Eva LO\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWK1e-nE5Pj1QL-vSJZeBRcJjqbafZWCfnefe5q5xOwgvGnvCb\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"a4af8180-630a-407d-8d40-a9f372535812\",[\"Anson Lee\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjULKJx9mrbG5UvJ8z7mae2VlNZVBuWHcck9UVcWw7jJ4_w8CPreMg\"]]],1,null,\"你的程式開不到，經常彈回主畫面，無法正式運用。\",[1750719047,658000000],0,[\"Standard Chartered Bank PLC\",\"你好 Anson Lee，很抱歉未能為你帶來流暢的SC Mobile使用體驗。你可以檢查及更新你嘅SC Mobile至最新版本7.6.9再嘗試。如果問題持續需要進一步的協助，你可以於渣打銀行網頁 sc.com/hk/zh 透過頁面右下角的智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Wes\",[1750846738,424000000]],null,[\"106460711288466758975\",\"Anson Lee\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjULKJx9mrbG5UvJ8z7mae2VlNZVBuWHcck9UVcWw7jJ4_w8CPreMg\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"c0f661b8-531a-4857-822f-321b06060cd2\",[\"奇思伯伯\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUR6DTRG3FlWsF-FwlwdP6GxWsYTour9RF3sI4gG-ebt0OUF80h\"]]],1,null,\"升了更新版才驚覺，渣打真係似微軟，儍更更總弄唔清，簡約同簡漏嘅分别，實在係唔蠢嘅事做唔出。版面設計嘅低效程度直廹同行花皮銀行個爛App. 。直情連總結存應該計算用戶名下所有戶口都唔知(而唔係話設定咗顯示幾多個戶口就計幾多個戶口吖)，咁樣交條爛數出街，鄙人真正佩服到五體投地喇❗藉口話升級，實際就將大量設定細節乘機刪走咗，咁樣做 IT人就真真高手啦，後續多清閒吖❗ 等渣記管理層以為會吸納到更多人用 App，到頭來侷到個個用戶要放工番去電腦旁邊，用瀏覽器界面，就夠驚奇喇❗ 近排 IT 人啲思維邏輯就夠怪，隻隻都想學足微軟，猛嗌升級反而會倒退超過十年嘅❗ 個爛App仲話係更新版，直情爛到應盡快下架用番舊版頂住先吖❗ 近日SCB 個爛App又不停撞版啦，明明才剛剛用生物驗證登入，又即刻鬧同機從複登入踢返用戶出嚟要再做，佢咁樣自己撞板幾次，就賴用戶未登記生物驗證，夾硬off setting,要用戶用密碼登入再設定， 幾個 Chats,又擋來擋去，什麼事也做不成，答不上口，好心SCB就炒哂整個IT部門班垃圾程式員喇❗\",[1750385365,288000000],45,[\"Standard Chartered Bank PLC\",\"您好 奇思伯伯，這不是我們希望您擁有的體驗。現時sc mobile 已升級至版本7.2.2。歡迎你隨時升級及給出意見以便我們提升應用程序的服務體驗。~ Jeff\",[1701997272,647000000]],null,[\"111487237304753885512\",\"奇思伯伯\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUR6DTRG3FlWsF-FwlwdP6GxWsYTour9RF3sI4gG-ebt0OUF80h\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,[[[\"vaf_phase1_tracking_stocks\",[2]],[\"vaf_never_display_content_language\",[1]],[\"vaf_phase1_auto_investing\",[2]]]],null,[true,false],null,1],[\"e4558e70-a874-4da9-82a0-409d4b1f2cbb\",[\"CK一\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUdftJihbcnptXIB59DYqOuOm6HkI_ONB2uhwk7Xc9Ap_Rb97w1\"]]],1,null,\"銀行app係咁彈廣告推送 極垃圾\",[1750127633,1000000],9,[\"Standard Chartered Bank PLC\",\"你好 CK一， 抱歉未能為你帶來滿意的流動理財用戶體驗，SC Mobile設有不同的推廣去切合客戶的需要及帶來最新的資訊，期望為客戶帶來更好的銀行體驗，如有需要，你可以登入SC Mobile 並點擊「 服務」 ，然後選擇「 通訊喜好」 及「 優惠及產品資訊」 去更新SC Mobile 的廣告通訊喜好設定，最多需時10個工作天處理，謝謝。 ~ Carl\",[1750226246,48000000]],null,[\"111465380874378515861\",\"CK一\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUdftJihbcnptXIB59DYqOuOm6HkI_ONB2uhwk7Xc9Ap_Rb97w1\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,[[[\"vaf_never_display_deceptive_ads\",[2]],[\"vaf_phase1_fdic_insured\",[3]],[\"vaf_never_display_make_you_happy\",[3]]]],null,[true,false],null,1],[\"be46782c-3ba0-4a90-94c5-dc04555e1554\",[\"Ken Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUAdiNC4WYGwnCgY4YvnAv8CNuA3qLAhmnXvBFzNdkZEpMFdWA\"]]],1,null,\"垃圾\",[1750042642,708000000],0,[\"Standard Chartered Bank PLC\",\"你好 Ken Chan，抱歉未能為你帶來滿意的流動理財用戶體驗，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。~ Carl\",[1750226157,883000000]],null,[\"111359934269674497557\",\"Ken Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUAdiNC4WYGwnCgY4YvnAv8CNuA3qLAhmnXvBFzNdkZEpMFdWA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"9bce5bf1-7dac-4df3-a3d3-320b7ab11bb4\",[\"lobster tail\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLloQYYCQF8mHNWd0vDaCHuyEGM7Gn_5M-1hTmLkLFm7GMhGQ\\u003dmo\"]]],1,null,\"You can never change you personal information through the app\",[1749778119,969000000],0,[\"Standard Chartered Bank PLC\",\"Hi lobster tail, please register to access full digital banking services to update personal information via ATM/debit card with Pin or Tele-electronic identification number (TIN). If you encounter issue, please contact us through SC Mobile and tap “Contact \\u0026 Support” at top right corner to connect with our live agent for assist. Thank you. ~ Carl\",[1750241679,127000000]],null,[\"117457142331023499604\",\"lobster tail\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLloQYYCQF8mHNWd0vDaCHuyEGM7Gn_5M-1hTmLkLFm7GMhGQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,null,null,1],[\"2fdeae0c-5b06-40cd-9edb-30a3f9498e9c\",[\"Paul Wai Hin Chiu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJWK0eO5GEA-piQu-Yzlwuk7P9Mn7o30gii-mwMQLGD8geC7w\\u003dmo\"]]],1,null,\"360換領經常壞，每次我登入都維修中，網頁版亦都一樣，好廢....\",[1749584280,275000000],1,[\"Standard Chartered Bank PLC\",\"你好Paul，網上理財密碼需要客戶自行設定而唔係經由電郵確認嘅。如果你於重設網上理財需要即時協助，建議你可以透過Stacy聯絡線上客戶服務主任查詢。 ~Sophia\",[1656291963,586000000]],null,[\"106880091889758742821\",\"Paul Wai Hin Chiu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJWK0eO5GEA-piQu-Yzlwuk7P9Mn7o30gii-mwMQLGD8geC7w\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,[true,false],null,1],[\"80900939-6dc7-498e-b0bb-248d2823da90\",[\"wai Ma\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWuI6dbw81ORka0ncrh0ZLHSr63XjZbM8dPFxkKgGOLqqYLY_nV4w\"]]],2,null,\"近星期經常入唔到個程式，有時得有時唔得. 之前用同一部手機都冇問題\",[1749382165,438000000],0,[\"Standard Chartered Bank PLC\",\"你好wai Ma ，抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會為你提供協助及跟進，謝謝。 ~ Carl\",[1749622993,227000000]],null,[\"109336837656294959013\",\"wai Ma\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWuI6dbw81ORka0ncrh0ZLHSr63XjZbM8dPFxkKgGOLqqYLY_nV4w\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,[true,false],null,1],[\"0421d468-d0dd-4526-91e3-5c795a107739\",[\"Derek Mok\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXHFH9qi8IvDLfO31E-WEeDPbWtUEpei35FPxh2Bp57ZPwoFAk\"]]],1,null,\"打開手機銀行app後説需要更新，但更新後便説手機或銀行app不是最新版之類，於是嘗試把手機系統更新至Android 15，之後銀行app仍然同樣不能用。現在手機銀行用不了，想用網上銀行也不行，因無法用手機認證登入！ 其實不明白，究竟是真的有需要所以才經常推出更新，還是衹是因為\\\"為了要有更新\\\"而更新？\",[1749375969,298000000],46,[\"Standard Chartered Bank PLC\",\"你好 Derek Mok，很抱歉未能為你帶來流暢的用戶體驗，為左提升用戶體驗我地會不定時更新手機版本，現時最新版本為7.6.9，如果已經更新至最新版本就無須再更新，但如果問題持續發生，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會為你提供協助及跟進，謝謝。 ~ Sara\",[1749719739,379000000]],null,[\"102729347631069042108\",\"Derek Mok\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXHFH9qi8IvDLfO31E-WEeDPbWtUEpei35FPxh2Bp57ZPwoFAk\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.6.9\",null,null,null,[true,false],null,1],[\"416b8514-92b5-435c-b6c5-558f09619483\",[\"AN AN\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJx-RI8UrugaqEtEM_0wmvfwrFn-IsnGkez0-228UIgHJmHSA\\u003dmo\"]]],1,null,\"垃圾app, 一login完就唔俾用，叫人更新後先可以用 點解唔可以一開app就叫人更新先呢？\",[1749258842,998000000],0,[\"Standard Chartered Bank PLC\",\"你好AN AN，很抱歉為你帶來不便， 我們會定期更新SC Mobile App，以優化服務及為客戶提供更順暢的網上銀行體驗，我們期待獲得你的持續支持，謝謝。 ~ Danny\",[1749521585,608000000]],null,[\"105669602488175109744