)]}'

[["wrb.fr","oCPfdb","[[[\"0b46db7a-f29f-4aa3-a5a4-90b18f9d6995\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"超级难用\",[1575546396,279000000],2,[\"Standard Chartered Bank PLC\",\"多謝你花時間留下評論，潘竞飞！我哋知道SC Mobile尚有進步嘅空間，亦都好想知道多啲你嘅意見，以助我哋改進SC Mobile。希望你會將姓名同聯絡電話電郵至[SocialCare.HK@sc.com]畀我哋，電郵標題[潘竞飞 Case #143898]，我哋會喺收到你嘅電郵後聯絡你。謝謝！~ Karl\",[1575552301,62000000]],null,[\"112902478895354061543\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.21\",null,null,null,null,null,1],[\"a074744c-edb8-4e75-a7ea-11720395c245\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"difficult to open\",[1575018647,886000000],0,[\"Standard Chartered Bank PLC\",\"Hello Yang, I'm sorry that SC Mobile is encountering this issue, our technical team is working hard to fix it. Please login with Offline PIN via Online Banking webpage temporarily.\\n1. Stay on SC Mobile welcoming page (pre-login);\\n2. Click the 'Menu' button in the top left corner\\n3. Choose ' Offline PIN'\\nSorry for the inconvenience caused.~ Karl\",[1575028800,823000000]],null,[\"101548346450228981760\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"4a5fc668-d7e3-4fb0-952b-e07c13d75c33\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"Why is this stupid app only available in Google play store? I can't download it on my new Huawei cellphone.\",[1569380371,579000000],0,[\"Standard Chartered Bank PLC\",\"Hi, Xining. For security issue, our app can only post on some official store. You are suggested to use online banking instead of mobile banking as per your situation. ~ Karl\",[1569382344,639000000]],null,[\"106986662655039111396\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"6ab8da00-de1f-4b53-bc76-f37a0e90dcad\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],5,null,\"不错的app\",[1567478441,543000000],0,[\"Standard Chartered Bank PLC\",\"多謝你對SC Mobile嘅支持，成鸿！我哋嘅團隊致力去優化SC Mobile令你哋可以享受到最佳體驗。如果想第一時間體驗到SC Mobil嘅新功能，就記得要密切留意每一個更新啦！~ Karl\",[1567483369,562000000]],null,[\"118004108574912551686\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.14\",null,null,null,null,null,1],[\"9b4e830e-8704-46ad-84b8-b50be05fd1a5\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"大陆的手机用不了，非常不方便，网站又打不开，我都想把所有渣打的投资都退了，太不方便了，都什么年代了，还做的这么保守。\",[1566906481,173000000],7,[\"Standard Chartered Bank PLC\",\"你好Haiqi，我們收到你的電郵，亦嘗試致電聯絡你但未能成功。請你再次確認一下你的電話號碼，並Email至SocialCare.HK@sc.com告知我們方便接聽電話的時間，我們會安排在指定時間再致電你。 ~ Vichy\",[1567230388,950000000]],null,[\"111663382151711114054\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.12\",null,null,null,null,null,1],[\"490fd052-f181-45d2-92cc-d741386c35a3\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"so bad. cannnnnnnnnot login.\",[1565141091,556000000],1,[\"Standard Chartered Bank PLC\",\"Hi Yiming. Thank for your message, and we like to know more details on your situation. To safeguard the confidentiality and security of your account information, please send us your Name and Contact Number via email  with Email Subject: [Yiming SUN Case#89187]. We'll contact  you upon receipt of your email. Thank you. ~ Karl\",[1565144727,11000000]],null,[\"116606500936838025554\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.12\",null,null,null,null,null,2],[\"be5de3b9-615c-45ea-a6c8-483dce91ea94\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],4,null,\"Problem resovled after dev suggested to uninstall and install. Still, forex page won't enter unless the network in using is perfect as in HK.\",[1563367722,191000000],0,[\"Standard Chartered Bank PLC\",\"Hi, Difei. Thank for you message, we suggest that you may try to delete and re-install the app first. If the problem still exist. Please send us your Name and Contact Number via email with Email Subject: [Zhao Difei Case##82776] to SocialCare.HK@sc.com. We'll contact you soon upon receipt of your email. Thank you. ~ Karl\",[1563367017,470000000]],null,[\"108093859691092957153\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.10\",null,null,null,[true,false],null,1],[\"b15b6275-913b-4668-bc1f-1e6ff8484e23\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"手痒进入了，之后发现网页版本无法登录了，按照提示找了半天没找到离线密码的选项，太坑了。\",[1561451192,814000000],3,[\"Standard Chartered Bank PLC\",\"你好ddrliz。請登入網上理財服務，然後按「離線密碼」。之後，在SC Mobile中按三個橫線圖案\\u0026gt;離線密碼\\u0026gt;取得離線密碼。謝謝。~ Max\",[1561451856,466000000]],null,[\"109832955786769151765\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.9\",null,null,null,null,null,1],[\"4713bcae-829a-452c-a048-c9c01ebfdd5a\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"前几天在香港更新后回大陆一直都不能使用，用指纹登陆，显示“我们未能处理您的指示”，改用密码登陆还是一样，什么情况？\",[1557448939,129000000],2,[\"Standard Chartered Bank PLC\",\"你好，June。更新版本已經推出。除了指紋認證功能已經修復，我們同時加入了全新功能 - SC Keyboard。現時不用切換到SC Mobile都可以於手機鍵盤進行轉賬及查閱戶口結餘，簡單方便！快點去體驗這個全新功能。如果喜歡的話，記得要給我們五星好評支持一下啊！~ Vichy\",[1558159166,326000000]],null,[\"107931662879762217481\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"5.7.7\",null,null,null,null,null,1],[\"cdf00401-9639-475c-af07-cf6c38b5cb6d\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],2,null,\"隔几天不用，sc key就失效，输入Sc Key密码会反复提示系统错误。除了卸载重装没找到其他办法，要么就电话终止Sc Key，但终止后就不能用手机银行，这是个死循环。\",[1556905183,395000000],3,[\"Standard Chartered Bank PLC\",\"你好，ZhaoPing。除非定期的系統更新，否則SC Mobile Key於成功登記後不會因為長期閒置而失效。若問題持續，請將你的姓名及聯絡電話Email至SocialCare.HK@sc.com，標題請註明「ZhaoPing Qian - Case#37228」。收到你的電郵後，我們會於一至兩個工作天內聯絡你跟進有關情況，謝謝！~ Vichy\",[1556928271,160000000]],null,[\"107379693470973833768\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"4.19\",null,null,null,[true,false],null,1],[\"4147ce9b-31ba-4ca6-a1c0-14b5b2d45ac8\",[\"Google 用户\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],5,null,\"挺好\",[1556619384,702000000],0,null,null,[\"105975370560750794361\",\"Google 用户\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null