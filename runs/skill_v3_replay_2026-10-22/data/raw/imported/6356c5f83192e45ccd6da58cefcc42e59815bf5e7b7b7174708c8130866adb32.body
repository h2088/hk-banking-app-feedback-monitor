0acZ7YrGVZdTECNfaAcLa00mw-c3wbIdtGtV21AC\"]]],3,null,\"other bank app would not ask u yo reset security token again n again. it asks u to take photo of your ID n your self portrait again n again\",[1766381250,562000000],0,null,null,[\"101559656144257712953\",\"真千江映月\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWtpUFmHR0m0acZ7YrGVZdTECNfaAcLa00mw-c3wbIdtGtV21AC\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.9\",null,null,null,null,null,1],[\"e0f42262-f3ff-48ac-886a-40db9cd99b21\",[\"D\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXNytJIQ-m4n6eulS8tLmJS__dCGVnjb9Dwfxod_iWU7eGZ6O5N\"]]],1,null,\"BOCHK is the worst if you spend most of your time abroad. Often get fully locked out of Internet banking due to their stupid new mobile token which requires SMS verification, and SMS is broken half the time. I was ready to close my account but I made the mistake of moving some money into it and now I have to go through their awful phone support again or fly to Hong Kong from the US. The app matches my experience with Bank of China HK: awful.\",[1766331247,265000000],2,null,null,[\"111793314915891420110\",\"D\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXNytJIQ-m4n6eulS8tLmJS__dCGVnjb9Dwfxod_iWU7eGZ6O5N\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.5\",null,null,null,null,null,1],[\"5e602f6e-68ce-4fb3-b30a-cb0fb4b50d17\",[\"Erna Adelia\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ2BbD1tgZRGtBHBXFtHDtHgysQwAfMARs3k3h5QHib4eIHiw\\u003dmo\"]]],1,null,\"very bad app after to much update I can't login my internet Banking,even everything is correct but still can't login ,I try more then 30 time still can't even I reset and scan with my face and out id card ,why like this!\",[1766329043,690000000],6,null,null,[\"106654406133306289243\",\"Erna Adelia\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ2BbD1tgZRGtBHBXFtHDtHgysQwAfMARs3k3h5QHib4eIHiw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.9\",null,[[[\"vaf_never_display_ads_experience\",null,[1]]]],null,[true,false],null,1],[\"8abd4c96-a40e-4407-b17b-6aabe56cb3f6\",[\"Caleb Mok\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXqUWE7U8thgwGA0xN_fnHMRQPGAEuXGjIHkftbxbb0fGSAd56Qaw\"]]],1,null,\"new log-in procedure takes forever and makes the app unstable, repeatedly saying the app isn't responding\",[1766297079,502000000],0,null,null,[\"112488987478573763044\",\"Caleb Mok\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXqUWE7U8thgwGA0xN_fnHMRQPGAEuXGjIHkftbxbb0fGSAd56Qaw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.9\",null,[[[\"vaf_never_display_ease_of_use\",null,[1]]]],null,[true,false],null,1],[\"4b1acae2-fffc-49e2-952b-f1753f4cbb49\",[\"Genevie Amodia\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ_IEkYeRn7M0seBi_RHqPAIdlcDgQ7-8wriudQpk6PcuxtPVY\\u003dmo\"]]],5,null,\"🥰\",[1766227579,898000000],0,null,null,[\"110779030552982121239\",\"Genevie Amodia\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ_IEkYeRn7M0seBi_RHqPAIdlcDgQ7-8wriudQpk6PcuxtPVY\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.3.9\",null,null,null,null,null,1],[\"eb2d6e9b-a353-4d4e-b53c-400244fdfbb1\",[\"Jasmine Wu\",[null,2,null,[null,nu