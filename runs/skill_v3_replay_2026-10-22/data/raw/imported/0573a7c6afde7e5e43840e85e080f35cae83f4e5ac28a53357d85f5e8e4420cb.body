{"author":{"uri":{"label":"https://itunes.apple.com/hk/reviews/id185535375?l=en"}, "name":{"label":"SumYC"}, "label":""}, "updated":{"label":"2025-06-26T04:39:21-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"7.6.9"}, "id":{"label":"12819090851"}, "title":{"label":"No way to verify and sign in to the app"}, "content":{"label":"After signing in with my username and password, I am required to verify my identity via both email OTP and SMS OTP. However, I never receive the email OTP in my inbox (I’ve checked my junk mail as well). I am certain that my email address is correct because I can sign in through the website and receive email communications from SC. I called the hotline, but the customer service representative only advised me to delete the app and reinstall it. Of course, that didn’t solve the problem. I have never encountered this situation with other banking apps.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/hk/review?id=445795688&l=en&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
