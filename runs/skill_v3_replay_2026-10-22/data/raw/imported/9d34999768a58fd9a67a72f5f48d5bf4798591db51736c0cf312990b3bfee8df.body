)]}'

[["wrb.fr","oCPfdb","[[[\"5aff2125-6679-4f56-a7af-1332ebf52dc4\",[\"Jack Cheung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK0x5fUa0KHZZvapu7eS5Za64hhrYCeMD-cbARRk2glQpdbaQ\\u003dmo\"]]],1,null,\"請問已經Log in SC Mobile, 由SC Mobile click 入股票，請不要再發出Log in 的推送通知，例如\\\"You successfully log in\\\" , 最初由SC Mobile click 入股票網頁，根本沒有推送通知，後來阿茂整餅，click 入股票網頁，多了推送通知，根本就REDUNDANT, 根本沒有需要，這個通知屬於Disturbing！\",[1792202951,707000000],24,[\"Standard Chartered Bank PLC\",\"你好Jack Cheung，多謝你的反饋，相關登入股票服務提示是基於賬戶安全考慮而設，目的是讓客戶能及時得悉相關登入活動。我們亦會持續優化SC Mobile去帶來更好的使用體驗，感謝你的理解。~ Wes\",[1792564737,200000000]],null,[\"117609695288435500203\",\"Jack Cheung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocK0x5fUa0KHZZvapu7eS5Za64hhrYCeMD-cbARRk2glQpdbaQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,[[[\"vaf_never_display_positive_impact\"],[\"vaf_phase1_getting_credit_scores\"],[\"vaf_phase1_backing_up_your_data\"]]],null,null,null,1],[\"84f5cac4-9de6-45d4-a52c-7cc9053ca9fd\",[\"Jason C\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItL13j5lTbGi5NGi0nf5liDTA7GDByo59zHcp4crHIj4GKfQ\\u003dmo\"]]],1,null,\"最近登入時經常閃退,非常不便,幾時先會整好\",[1792067986,456000000],0,[\"Standard Chartered Bank PLC\",\"你好Jason C，抱歉未能為你帶來滿意的使用體驗，請更新SC Mobile App到最新版本的7.19.0後再嘗試。如問題持續，你可於渣打銀行網頁： sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，輸入「SC Mobile 閃退問題」聯絡線上客戶顧問。並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Carl\",[1792490295,742000000]],null,[\"103294492492053821855\",\"Jason C\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocItL13j5lTbGi5NGi0nf5liDTA7GDByo59zHcp4crHIj4GKfQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"b8ae35f3-ef92-4401-b3bc-447ac8ebd116\",[\"King Tai Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKaErtipQ6BCbhrWe79F4ks4SV7FPapeDYhxoXmlcBm5efQQg\\u003dmo\"]]],1,null,\"成日彈app\",[1792062942,937000000],0,[\"Standard Chartered Bank PLC\",\"你好King Tai Wong，抱歉未能為你帶來滿意的使用體驗，請更新SC Mobile App到最新版本的7.19.0後再嘗試。如問題持續，請你於渣打銀行網頁： sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，輸入「SC Mobile 閃退問題」聯絡線上客戶顧問。並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Carl\",[1792490413,583000000]],null,[\"112714982587524456361\",\"King Tai Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKaErtipQ6BCbhrWe79F4ks4SV7FPapeDYhxoXmlcBm5efQQg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,[true,false],null,1],[\"4fb05025-1f65-4a1f-8566-99af6b21a7f3\",[\"K Lau\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKrWz3g1x7Gkpjo2mUbLc9j2XjktcLnrGAWgez8vy6MhH0qvA\\u003dmo\"]]],3,null,\"個 app 間中入曬 username，password之後就閃退，會令人唔安心。見到其他 comments 都有提過呢個問題。同埋希望轉款後或開新戶口之後可以 screen cap.\",[1792017677,750000000],2,[\"Standard Chartered Bank PLC\",\"你好K Lau，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁 sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助。而隨著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料，感謝你的理解及支持，謝謝。 ~ Danny\",[1792051599,160000000]],null,[\"115675714778741938272\",\"K Lau\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKrWz3g1x7Gkpjo2mUbLc9j2XjktcLnrGAWgez8vy6MhH0qvA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,[[[\"vaf_app_quality_ads_intrusiveness\",[1]],[\"vaf_app_quality_ads_presence\",[2]],[\"vaf_app_quality_performance\",[3]]]],null,null,null,1],[\"294bc652-20eb-47d2-9ed4-5c55343210e2\",[\"D Hsu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIhgFmwDeu3zy4aurNOPjANOuF7F0Hc7GTfOumBJNgn1m35ug\\u003dmo\"]]],1,null,\"每次輸入正確用戶名稱同密碼都登入唔到，每次都要㩒忘記密碼，但重新set嘅密碼明明一模一樣，到底點解會登入失敗？搞到次次都懷疑係咪有人盜用我身份改密碼，咁樣到底點樣保障我戶口嘅安全？\",[1791880202,422000000],0,[\"Standard Chartered Bank PLC\",\"你好D Hsu，我們需要更多資料了解並跟進你的個案，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Carl\",[1791970885,955000000]],null,[\"109511557813696839772\",\"D Hsu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIhgFmwDeu3zy4aurNOPjANOuF7F0Hc7GTfOumBJNgn1m35ug\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"abb8f273-e90e-493b-9b75-6bb05527b643\",[\"KM TING\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVVlr-AtzzfYZ7BeEkxg2i1xEmVhlH5dc5fVagxfWDGqhsjX8_G\"]]],1,null,\"更新後由9月到現在閃退都未停過, 而且還越來越嚴重, 究竟還須要等到何時呢！ Xiaomi HyperOS - 3.0.306.0 Android 16\",[1791620535,48000000],7,[\"Standard Chartered Bank PLC\",\"你好 KM TING，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。如閣下的SC Mobile 已經更新到最新版本但閃退問題仍然持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示聯絡線上客戶顧問，並提供遇到問題的日期與時間、 手機型號、 作業系統版本、錯誤信息及現正使用的SC Mobile版本，我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Carl\",[1791786613,769000000]],null,[\"115786338452515359375\",\"KM TING\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVVlr-AtzzfYZ7BeEkxg2i1xEmVhlH5dc5fVagxfWDGqhsjX8_G\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"20ce6dca-1243-41bd-ab1a-9dfbf815b048\",[\"PT Li\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU7n4uKqyTmCaEucSFCTgwHz10-WR4NGqeRiDZGs5SppduZdGPU\"]]],5,null,\"好用！\",[1791551351,4000000],0,[\"Standard Chartered Bank PLC\",\"你好PT Li，多謝你的支持與鼓勵，我們會繼續致力為客戶提供最佳服務，並期待獲得你的持續支持。 ~ Carl\",[1791786269,310000000]],null,[\"108752233833365507529\",\"PT Li\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU7n4uKqyTmCaEucSFCTgwHz10-WR4NGqeRiDZGs5SppduZdGPU\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"1667bf76-90d7-4bb3-b74c-38fdd6d54c1b\",[\"KC\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIOaFF__9bKkaJzOYNBQm6rPe4HOfnsCsjihJqiMTZv07sZyA\\u003dmo\"]]],1,null,\"成個月都仲係入完密碼登入後立即彈出。手機話叫閃退，叫我更新同係度回報。都係仲未有改善。這個幾星期，一按APP，第一次一定是閃退（手機資訊話是APP閃退）。要按第二次先得。兩部唔同手機都係咁。\",[1791535657,361000000],4,[\"Standard Chartered Bank PLC\",\"你好KC，抱歉未能為你帶來滿意嘅使用體驗，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁 sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，輸入「SC Mobile 閃退問題」聯絡線上客戶顧問。我們線上客戶顧問會爲你跟進及提供協助。 ~ Wes\",[1790158100,385000000]],null,[\"101321194608543421505\",\"KC\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIOaFF__9bKkaJzOYNBQm6rPe4HOfnsCsjihJqiMTZv07sZyA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,[true,false],null,1],[\"7bd0da68-10f5-4589-9d42-a26402a0d743\",[\"好玩遊戲\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKu7vlmb5XQeF8gAVAIpVeCqSBsLd0yzzv_-5rym9GXjjN4Zg\\u003dmo\"]]],1,null,\"自從換左新版本 每日想打開都會閃退 係發生緊咩事？？\",[1791331770,714000000],1,[\"Standard Chartered Bank PLC\",\"你好好玩遊戲，抱歉為你帶來不便，對於你提及的出現閃退情況，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，透過智能助理Stacy圖示聯絡線上客戶顧問提供閃退發生時間、日期以及裝置資料。我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Wes\",[1791347327,662000000]],null,[\"115182956680329413826\",\"好玩遊戲\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKu7vlmb5XQeF8gAVAIpVeCqSBsLd0yzzv_-5rym9GXjjN4Zg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,[true,false],null,1],[\"8eb25231-7a8a-4589-a2e0-9810b1238107\",[\"waisan to\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKjTOcXy9v0_KFv8NYtQLUsBg-1P4NbLv4fcqKarCwwfuQxzA\\u003dmo\"]]],5,null,\"good\",[1791288802,885000000],0,[\"Standard Chartered Bank PLC\",\"Hi waisan to, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to providing you with quality services in the future and your continuous support. ~ Wes\",[1791347247,595000000]],null,[\"102512517835624698092\",\"waisan to\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKjTOcXy9v0_KFv8NYtQLUsBg-1P4NbLv4fcqKarCwwfuQxzA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"6878b88c-71a8-40a6-9c16-890ea421f2d9\",[\"Joyce Chan\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIwAajDtiPc_1cqUXtuGWYHBSMlJO1Ip5HG4MaT0hSR2JscrQ\\u003dmo\"]]],3,null,\"在這渣打手机銀行做即時轉賬，實則已轉數完成，但渣打未能顯示同步，慢很多拍。 基本都是慢，令人誤會轉賬失敗。 系統未完善，速度未能同步！\",[1791269468,603000000],73,[\"Standard Chartered Bank PLC\",\"你好Joyce Chan，抱歉未能爲你帶來滿意的使用體驗，我們會持續更新SC Mobile去優化使用體驗，如你在使用SC Mobile時需要進一步協助，請於登入SC Mobile後點擊右上角的「聯絡及支援」圖示透過智能助理Stacy聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Danny\",[1791352362,730000000]],null,[\"107870084122741078405\",\"Joyce Chan\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIwAajDtiPc_1cqUXtuGWYHBSMlJO1Ip5HG4MaT0hSR2JscrQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"e0704a41-240a-415e-97d3-02c2f6bc7daf\",[\"Alvin\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV6d5VEBqjwcoiCSYcF8pV1zwJv2t8sfxag9HGK3Q5BYD11LeEcKQ\"]]],1,null,\"不停彈app 根本用唔到\",[1791246965,79000000],2,[\"Standard Chartered Bank PLC\",\"你好Alvin，很抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Danny\\n\",[1791347210,679000000]],null,[\"117406177260573610190\",\"Alvin\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjV6d5VEBqjwcoiCSYcF8pV1zwJv2t8sfxag9HGK3Q5BYD11LeEcKQ\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"47ac6a47-3f61-47ac-97ff-7d9869521ed4\",[\"Jacky\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXJ2pkKkYbpqNODBgeuDA27UR8fSgbUbveQGqht_MUA6CBpxqik\"]]],1,null,\"諗住開戶口，影完身份證個App就崩潰，開左幾次都係咁 2年過去，依然都係開唔到戶口，自拍完個樣，跟住就成版面空白曬冇野show出黎\",[1791042440,913000000],3,[\"Standard Chartered Bank PLC\",\"你好Jacky，抱歉為你造成不便，你可以嘗試重新安裝SC Mobile再喺登入版面點擊【幾分鐘內完成開戶或登記】，申請開立銀行戶口。網上開戶係其中一種開戶途徑，你亦可以帶備香港身份證及初次開戶資金HKD1,000親臨分行辦理開戶，謝謝。 ~ Wes\",[1734665149,162000000]],null,[\"107175474450030746725\",\"Jacky\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXJ2pkKkYbpqNODBgeuDA27UR8fSgbUbveQGqht_MUA6CBpxqik\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,[true,false],null,1],[\"323409a9-9cf3-413a-bab1-3273ccaa582f\",[\"Km Leung\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJoXnmC_HaEg-hx4R7ypgkUykjXzaoEQCJc2CykQKLuEe2BjA\\u003dmo\"]]],1,null,\"留意吓有無問題，最近一兩週開始，成日彈app\",[1791022074,410000000],2,[\"Standard Chartered Bank PLC\",\"你好Km Leung，抱歉為你帶來不便，對於你提及的多次出現閃退情況，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，透過智能助理Stacy圖示聯絡線上客戶顧問提供閃退發生時間、日期以及裝置資料。我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Wes\",[1791286156,878000000]],null,[\"117307352428258787002\",\"Km Leung\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJoXnmC_HaEg-hx4R7ypgkUykjXzaoEQCJc2CykQKLuEe2BjA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,null,null,null,null,1],[\"ed00a746-b173-48bc-8e84-746271063171\",[\"jim huang\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJUHMH2aMvAbpExqJmrX3TJlLk-8e4tmNvQNgupY4aws4BzoA\\u003dmo\"]]],1,null,\"近期經常登入後彈出系統，再次登入亦彈出，又沒有最新版本要更新，還敢說自己是最受用戶喜愛的網上銀行程式。\",[1790828252,129000000],3,[\"Standard Chartered Bank PLC\",\"你好jim huang，非常抱歉為你帶來不便，對於你提及的登入後出現閃退情況，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問提供閃退發生時間、日期以及裝置資料。我們的線上客戶顧問會爲你提供協助及跟進，謝謝。 ~ Wes\",[1791285067,574000000]],null,[\"109980372829418734901\",\"jim huang\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJUHMH2aMvAbpExqJmrX3TJlLk-8e4tmNvQNgupY4aws4BzoA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.18.1\",null,[[[\"vaf_app_quality_performance\",[2]],[\"vaf_app_quality_ads_presence\",[1]],[\"vaf_app_quality_visual_appeal\",[2]]]],null,null,null,1],[\"aae1eeaa-08b3-4baa-a88b-4eece9730470\",[\"Oscar Au\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKtSBkr9bmwpA5vsnEchxYR8Lc4ebjB-lnVVakTl9Y46Leh6w\\u003dmo\"]]],1,null,\"軟件更新後經常鎖屏，不能操作軟件中的所有功能。\",[1790821229,588000000],0,