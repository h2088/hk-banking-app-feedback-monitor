usercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.17.0\",null,null,null,null,null,1],[\"fe4b0fc9-4155-4208-a718-ae9b1521622f\",[\"Chiu Mary\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLDmILrTRGQmQIGH0QsmY7RiXb8nZ2QM5Kba5dx7YsuktMXzA\\u003dmo\"]]],1,null,\"有些指令申請不到有當機\",[1788068319,87000000],0,[\"Standard Chartered Bank PLC\",\"你好Chiu Mary，抱歉為你帶來不便，我們需要更多資料了解並跟進你的個案。請登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Danny\",[1788849086,438000000]],null,[\"115759317824985655664\",\"Chiu Mary\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLDmILrTRGQmQIGH0QsmY7RiXb8nZ2QM5Kba5dx7YsuktMXzA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,[[[\"vaf_app_quality_stability\",[2]],[\"vaf_app_quality_battery_heat\",[2]]]],null,null,null,1],[\"85cb7f69-2ae6-4cdd-be7b-15d14f4848cd\",[\"TAT MING LEE\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVrAq5wAbTo0936-yVff0jQIYiIr6DhqKStD24Sqs9o1zEzK_8\"]]],1,null,\"確實如其他使用者所提及的，垃圾到不得了。 早兩日用個apps做個投資意向問卷，途中無端端同我登出（我十萬個肯定冇自己登出），跟住要由頭再嚟，直接發顛我真係！我嗰陣做到step 5/6架喇！要知道個問卷又複雜又難做！！ 另外每次用完，都問「會唔會推薦呢個SC Mobile apps比朋友？」。。。係咪白痴架？我冇朋友有渣打銀行戶口推乜鬼薦？有嘅好似我咁通常自己就會download... 超救命，次次用完都問。 其他個apps啲問題我都費事講，我就此省略一萬字！！\",[1787925813,459000000],6,[\"Standard Chartered Bank PLC\",\"你好WILL LEE，抱歉為你帶來不便，現時SC Mobile投資取向問卷的功能未有異常的情況，請確保使用時已連接穩定網絡。如你仍未能使用，我們需要更多資料了解並跟進你的個案。請登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Danny\",[1788848973,725000000]],null,[\"100980404591401045160\",\"TAT MING LEE\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjVrAq5wAbTo0936-yVff0jQIYiIr6DhqKStD24Sqs9o1zEzK_8\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"a0b10bc5-0032-434b-85d2-a3cbc5217bde\",[\"ChunKwok Chow\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXU7Oje2WL7Uj5k1-w2_3IGynKi9-mmvXXRucWffPve5c9Rzluy\"]]],1,null,\"8/17 不知所謂. 登入又入不到. 垃圾. 8/24 當你們回覆說正常可用, 怎知！一樣入不到. 垃圾！一星期也弄不好.\",[1787567237,445000000],2,[\"Standard Chartered Bank PLC\",\"你好ChunKwok Chow，抱歉未能為你帶來流暢的使用體驗，SC Mobile現時正常運作中，請重新嘗試登入。如你現時仍未能成功登入，請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Wes\",[1787564400,494000000]],null,[\"115483413504180233705\",\"ChunKwok Chow\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXU7Oje2WL7Uj5k1-w2_3IGynKi9-mmvXXRucWffPve5c9Rzluy\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,[[[\"vaf_app_quality_stability\",[2]]]],null,[true,false],null,1],[\"2122475e-c833-4b6a-8877-e51e47399090\",[\"Amigo Yiu\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUuTSo3Ztx5tJ2bb5ul4YMjpOHMLpdQ2EAKVL6lxhx_q9oCKAhl\"]]],1,null,\"即時通訊不能使用，打上客服佢話無問題，我已經del apps重新安裝，重新開機。\",[1787133809,78000000],1,[\"Standard Chartered Bank PLC\",\"你好Amigo Yiu，很抱歉令你造成不便，你可以嘗試登入SC Mobile後點擊主畫面的「即時對話」按鈕聯絡線上客戶顧問，如問題未能解決，你可以前往渣打銀行網頁: sc.com/hk/zh ，登入後點擊右下角的智能助理Stacy圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile以帶來更好的用戶體驗，謝謝。~ Carl\\n\",[1787620168,589000000]],null,[\"101446905850864463128\",\"Amigo Yiu\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUuTSo3Ztx5tJ2bb5ul4YMjpOHMLpdQ2EAKVL6lxhx_q9oCKAhl\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.16.0\",null,null,null,null,null,1],[\"04e259f3-9709-4da4-8354-5250b566574c\",[\"黃少強\",[null,2,null,[null,n