,[\"a813717a-e4a9-4a17-a681-9a9e7ec25e05\",[\"Karman Li\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ4NX0Lx3r1ba0blLQl25VJAxpYzK_GT20ICFa73nU3YkOT0Q\\u003dmo\"]]],1,null,\"股票apps持貨盈虧同現價唔識得更新，明明股價係7.5但顯示仲係尋日收請6價\",[1769046485,743000000],0,[\"Standard Chartered Bank PLC\",\"你好Karman Li，目前股票持貨盈虧及查看現價功能運行正常，你可以重新嘗試。 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持，謝謝。 ~ Carl\",[1770093973,100000000]],null,[\"110471285462142672580\",\"Karman Li\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ4NX0Lx3r1ba0blLQl25VJAxpYzK_GT20ICFa73nU3YkOT0Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"13cfe4bd-9973-4bc6-af59-539da3d6393a\",[\"Lam Yip Ming\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXMMw4tSQyT9jew67ciiZPabFgXptes19IgHNKvqlW3QDaFEk8_aA\"]]],1,null,\"唔俾人cap圖，你咪自己output一張過數紀錄俾人save低囉。而家整張貼圖俾我係想點？你張sticker好可愛咩？我要send入數紙俾人做証明呀嘛，最基本要銀碼，戶口，ref no。Send張貼圖俾人做乜9\",[1768902281,29000000],8,[\"Standard Chartered Bank PLC\",\"你好Lam Yip Ming，感謝你的反饋，隨著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。如果你需要向收款人/商戶證明付款紀錄，我哋會於SC Pay「轉數快」、「掃描支付」、本地或海外及跨境轉賬完成付款指示後經電子郵件、推送通知或短訊通知你有關交易狀況，你亦可以於轉賬成功後登入網頁版網上理財，選擇「轉賬」、「轉賬記錄」查看相關付款紀錄及截圖，謝謝。 ~ Carl\",[1770093275,702000000]],null,[\"110094590199163902349\",\"Lam Yip Ming\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXMMw4tSQyT9jew67ciiZPabFgXptes19IgHNKvqlW3QDaFEk8_aA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"d6b61dbc-7875-4503-a970-ac7282585113\",[\"Shu Kano\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLqdzohjKZFaOYVcpag-3323YWfNmHAIjUZo3nN27K6B6WXqw\\u003dmo\"]]],1,null,\"登入唔到app，一直白屏，拎唔到Sc mobile key，搞到電腦版同APP都入唔到。 唔需要話你試OK或者試下移除個APP或者換部手機，問題係咁大個銀行倚賴一個登入方式，好似宜加咁跪咗根本咩都做唔到\",[1768866580,447000000],12,[\"Standard Chartered Bank PLC\",\"你好Shu Kano，抱歉未能為你帶來滿意體驗，渣打銀行一向致力保障客戶的網上理財安全。為防範短訊一次性密碼（OTP）被釣魚的風險，本行已加強安全措施，現須使用已綁定的 SC Mobile Key 以驗證網上理財登入及執行高風險交易。關於你提及未能登入SC Mobile 的情況，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Wes\",[1770097591,490000000]],null,[\"102436160548784598163\",\"Shu Kano\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLqdzohjKZFaOYVcpag-3323YWfNmHAIjUZo3nN27K6B6WXqw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_spend_more_time\",[1]],[\"vaf_phase1_linking_bank_accounts\",[1]],[\"vaf_phase1_see_multiple_accounts\",[2]]]],null,[true,false],null,1],[\"5d47c2ba-db26-4df0-bf13-ac32a0aaa659\",[\"Jonathan N\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWB3FnP3Asa-PwV_-lLtoAILqd6jlQ2q-4skGbwnPynMmowXZl\"]]],2,null,\"用幾個月就話我手機未登記，都冇換機，試過唔只一次\",[1768825087,643000000],0,[\"Standard Chartered Bank PLC\",\"你好Jonathan N，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1770100103,880000000]],null,[\"115022886604578030078\",\"Jonathan N\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWB3FnP3Asa-PwV_-lLtoAILqd6jlQ2q-4skGbwnPynMmowXZl\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"1c8e2f93-bc70-4fa9-8c9e-edba0916ba5c\",[\"choison\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWZfCmuO8bJxZ3fNEOleB_XKuXZwv2sVj4vGeIM-5RUN8G7MhAAw\"]]],1,null,\"Fxx2x Fitness健身公司 跟 MxX 信用卡公司 合謀詐騙港人!!! Fxx2x Fitness健身公司搶電話唔比返你迫你提供個人資料 瞞住你 開信用卡 及 碌卡過數去FIT24口 詐騙流程： FIT24職員用抽中理由，在街上跟人聲稱去禮品部，結果帶了去FIT24健身公司，\",[1768739858,396000000],0,null,null,[\"103869422614354720845\",\"choison\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXWZfCmuO8bJxZ3fNEOleB_XKuXZwv2sVj4vGeIM-5RUN8G7MhAAw\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"6.15.0\",null,null,null,null,null,2],[\"35fe12d7-0a09-4ef2-81ee-514fa412f063\",[\"Leung Mrs\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL5NtQovnJ1Mc1wGEPrr-ED_NXEKVRIviUVFy6HGtCU87j73Q\\u003dmo\"]]],1,null,\"点解download唔到SC mobile app 嘅? 顯示..你的裝置与运個版本不兼容\",[1768726214,36000000],1,[\"Standard Chartered Bank PLC\",\"你好Leung Mrs，為了向用戶提供更好的服務和更高的安全性，我們定期更新應用程式版本。本行已將SC Mobile APP的最低操作系統要求設置為Android 10.0。你可以在「設定」應用程式中，點選「關於手機」或「系統」選項查看目前的系統版本，我們會繼續改進SC Mobile app以令客戶獲得更佳體驗，謝謝。 ~ Carl\",[1769570156,708000000]],null,[\"116130354167806916122\",\"Leung Mrs\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL5NtQovnJ1Mc1wGEPrr-ED_NXEKVRIviUVFy6HGtCU87j73Q\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.7.0\",null,null,null,[true,false],null,1],[\"43a03dad-d7d3-4213-946f-586e238e1225\",[\"tt ss\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmgLBAYtDS3U9HhkLz6rJrArkxf826GMbGeSa6_3C-Lu5qR68\\u003dmo\"]]],1,null,\"我已經系Android 16，點解都入唔到投資app? 太麻煩了! 如果我有重要股票要沽，誰賠比我!\",[1768561729,561000000],1,[\"Standard Chartered Bank PLC\",\"你好tt ss，感謝你的反饋，如你需要進行股票交易，請將SC Mobile手機應用程式更新至最新版本，登入SC Mobile後，你可以在頁面最下方選擇「投資及保險」，然後選擇「股票」，即可進行股票交易買賣。我們從2025年11月起，陸續分批為客戶的SC Equities應用程式自動進行合併至SC Mobile App，所有SC Equities原有的網上股票投資功能、服務及操作界面等，不會在合併至SC Mobile App後有任何改變。合併後的分別主要在於，登入所用的應用程式由現有的SC Equities改爲透過SC Mobile App登入網上股票交易，我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持，謝謝。 ~ Carl\",[1769422025,181000000]],null,[\"107983189178440805240\",\"tt ss\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLmgLBAYtDS3U9HhkLz6rJrArkxf826GMbGeSa6_3C-Lu5qR68\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]],null,null,null,1],[\"145aa275-0ac3-4f43-b387-613e7147411c\",[\"T Tr\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLKaUXhmYVf5_DjNwyLTDb7dcUJCauoiCa56BcpfKq0JewEGA\\u003dmo\"]]],1,null,\"用完app開戶，沒有任何email 訊息通知成功與否，約3星期後，突然收到銀行卡。用app登入失敗，嘗試重設密碼，出現系統碼3000。跟電腦客服指示嘗試在網頁重設，但網頁卻顯示需要用App重設密碼，完全玩客。faq 提及3000是太多人使用，稍後登入，但過了一星期還是出現3000。 找人工客服，告訴我等幾分鐘，可是等了一個鐘，等到6點收工都無覆。 由開始申請已一個月，還未能存錢到戶口。\",[1768532529,995000000],11,[\"Standard Chartered Bank PLC\",\"你好 T Tr，抱歉未能為你帶來滿意的使用體驗，如你仍未能成功重設登入資料，你可以先將SC Mobile app 刪除及重新安裝至最新7.11.0版本，如重置APP後情況仍持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Sara\",[1769649393,820000000]],null,[\"103849313144919214149\",\"T Tr\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLKaUXhmYVf5_DjNwyLTDb7dcUJCauoiCa56BcpfKq0JewEGA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"477513da-b8da-4a3e-93ce-b1c2177ba9fc\",[\"Kwok Wong\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ3nFJpppEJ9xOhS9_Dq-joHVHu0l_QiULDIwufu6qbo-gQ\\u003dmo\"]]],1,null,\"每次在手机冇办法诶上更改已经废了的电邮地址,每次都。成功更改但是重新登入又是旧的废的电邮地址,真的令人气愤,绝对万分失望,根本唔可以用,废废废废\",[1768487705,650000000],0,[\"Standard Chartered Bank PLC\",\"你好Kwok Wong，很抱歉未能為你帶來滿意的服務體驗，透過SC Mobile 更新個人資料處理需時，更新個人資料成功後會收到短訊通知，我們需要更多資料了解並跟進你的個案。請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1769508126,115000000]],null,[\"118250064752890565762\",\"Kwok Wong\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJ3nFJpppEJ9xOhS9_Dq-joHVHu0l_QiULDIwufu6qbo-gQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"2b398db4-7d3c-41d7-bf3a-892ec1f68830\",[\"FRANKIE LEUNG\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocId2JXc3EYjYM_UYXgCX5autK22EPiNMxgQ-mZ3lNJO65_0Rw\\u003dmo\"]]],1,null,\"基金 load完10秒就全mon白色咩都沒。你地有沒running test...\",[1768466292,99000000],1,[\"Standard Chartered Bank PLC\",\"你好FRANKIE LEUNG，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你登入網上銀行，點擊頁面右下角的智能助理Stacy圖示，或更新SC Mobile至最新版本，登入後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\",[1769418993,920000000]],null,[\"108239320987357024081\",\"FRANKIE LEUNG\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocId2JXc3EYjYM_UYXgCX5autK22EPiNMxgQ-mZ3lNJO65_0Rw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],null,null,null,null,null,null,1],[\"8a10b2b4-3544-4902-b823-ad97c062321f\",[\"Kenneth Choi\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocILlAl7UNJxb9Bs3UqorbkSTnVu5of3_5VFNaXfANwlcgd7kg\\u003dmo\"]]],1,null,\"指模登入功能不停出問題\",[1768442208,461000000],0,[\"Standard Chartered Bank PLC\",\"你好Kenneth Choi，很抱歉為你帶來不便。我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助。 ~ Carl\\n\",[1769418938,129000000]],null,[\"112532653453195256671\",\"Kenneth Choi\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocILlAl7UNJxb9Bs3UqorbkSTnVu5of3_5VFNaXfANwlcgd7kg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"d193ee90-23dd-4a36-a6fc-4247bfff9566\",[\"AnyThinG\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU2oSe32yGjWM6wuquy8-qXMXoRn7w55ro7WlWJwaGASwLj3VM\"]]],1,null,\"一間咁大嘅銀行，個app垃圾到，一般功能已經唔係特別上手易用，想搵客服文字對答仲難過打hotline去政府部門！ 冇心做就唔好學人出app，人哋匯豐精簡易用，對答如流！\",[1768280122,520000000],3,[\"Standard Chartered Bank PLC\",\"你好AnyThinG，抱歉未能為你帶來滿意嘅使用體驗， 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。如你使用SC Mobile App時遇到問題，請登入SC Mobile後點擊右上角的「聯絡及支援」圖示並於智能助理Stacy對話框内輸入【線上客戶顧問】聯絡我們，我哋嘅線上客戶顧問會爲你提供協助及跟進，謝謝。~ Danny\",[1768887972,829000000]],null,[\"116253696151427198894\",\"AnyThinG\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjU2oSe32yGjWM6wuquy8-qXMXoRn7w55ro7WlWJwaGASwLj3VM\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_difficult_to_use\",[1]],[\"vaf_never_display_content_language\",[1]],[\"vaf_never_display_spend_more_time\",[1]]]],null,null,null,1],[\"143db2b4-e67c-4cf0-b666-cec89353f8b6\",[\"Ms Devil\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWBQGfFBSwajSQaeYACnUizM0ac9cbDo17YQVjVmkNjB4Qkq6YO8Q\"]]],1,null,\"11/1晚到12/1都系統訊息3000，用不到\",[1768191934,703000000],0,[\"Standard Chartered Bank PLC\",\"你好Ms Devil，錯誤代碼3000係一般錯誤代碼，需要配合你嘅戶口資料去了解及確認未能操作嘅原因。由於呢邊係第三方平台，而你嘅查詢涉及戶口資料，請你登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我哋線上客戶顧問會爲你提供協助及跟進，謝謝。~ Carl\",[1768878779,626000000]],null,[\"117380005121807484990\",\"Ms Devil\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWBQGfFBSwajSQaeYACnUizM0ac9cbDo17YQVjVmkNjB4Qkq6YO8Q\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"c10ec3b0-a15d-4ef7-9300-e5d3f8a0e041\",[\"hades Ng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJrU-BxjoVeqXG_mH1dIAhVZMhluSNpUeE2w6nnOvw9yvjWQA\\u003dmo\"]]],1,null,\"app 真人客服介面比例不會接手機型號調整 文字輸入欄會被導覽列遮蔽 app 接入Stacy 及客服介面 不停有卡頓 彈app情況\",[1768182115,733000000],0,[\"Standard Chartered Bank PLC\",\"多謝你花時間留下評論，hades！我哋知道SC Mobile尚有進步嘅空間，我哋會不斷改進SC Mobile，希望之後可以令你感到滿意啦！ ~ Kelly\",[1663130424,871000000]],null,[\"116253729762542496820\",\"hades Ng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJrU-BxjoVeqXG_mH1dIAhVZMhluSNpUeE2w6nnOvw9yvjWQA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"86a4fca4-22b1-49ea-8ac4-f1d9975747a6\",[\"Ka Fai Poon\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJsKo3SCjHx8bo9Fj-fY1o5og8xhm0pPiUf1S_f6rF0vh_vHQ\\u003dmo\"]]],3,null,\"is it possible to delete my payees? things like salaries tax number changes. very confusing to have several payees for salaries tax\",[1768146976,607000000],0,[\"Standard Chartered Bank PLC\",\"Hi Ka Fai Poon. To delete your bill payment payee, you may login to your online banking in sc.com/hk and select [Payments] \\u003e [Bill Summary] \\u003e [Delete Payee] to arrange. Thank you. ~ Danny\",[1768879248,842000000]],null,[\"110766806412600324883\",\"Ka Fai Poon\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJsKo3SCjHx8bo9Fj-fY1o5og8xhm0pPiUf1S_f6rF0vh_vHQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"25ad8ed0-5dc1-4440-a8af-94afa991be8f\",[\"Jen Ng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXug7s0-yQfcMUNoyXPLBAdxuXvJGcmWuff1sOMgXGDoLPymmxW\"]]],5,null,\"good\",[1768119008,122000000],0,[\"Standard Chartered Bank PLC\",\"Hi Jen Ng, thank you for your positive feedback! We’re delighted to hear you’re having a great experience. We look forward to provide you with quality services in the future and your continuous support. ~ Danny\",[1768879216,906000000]],null,[\"100304229059617187390\",\"Jen Ng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjXug7s0-yQfcMUNoyXPLBAdxuXvJGcmWuff1sOMgXGDoLPymmxW\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,null,null,1],[\"a296eb1c-d8cf-4d9c-8b4e-c027c10f8d30\",[\"Brian Lam\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJE8GBkgH9rkhZKa9TcxbWPDmHqiLk6QAkTwE-hGV-MvQhsoQ\\u003dmo\"]]],1,null,\"又在不知情况下被block\",[1767969871,988000000],0,[\"Standard Chartered Bank PLC\",\"你好Brian Lam，抱歉為你帶來不便，SC Mobile及網上理財現時正常運作，如你現時仍未能登入SC Mobile或網上理財，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Carl\",[1768878705,338000000]],null,[\"116013386070186396018\",\"Brian Lam\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocJE8GBkgH9rkhZKa9TcxbWPDmHqiLk6QAkTwE-hGV-MvQhsoQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,[[[\"vaf_never_display_ads_experience\",null,[1]],[\"vaf_never_display_ease_of_use\",null,[1]]]]