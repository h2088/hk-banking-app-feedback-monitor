ull,null,null,null,1],[\"6c96c78f-57a4-41ea-92ca-7c66b064d8f1\",[\"Google 使用者\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],1,null,\"更新完sc mobile apps7.12，用轉數快收唔到由#SCBHKsms發出的短訊通知。\",[1773029944,805000000],3,[\"Standard Chartered Bank PLC\",\"你好anonymous，轉數快 (SC Pay) 交易成功完成後會有電郵通知，已啟用推送通知的客戶亦會收到相關推送通知，而未啟用推送通知的客戶則會收到短訊通知。如你需要進一步協助，請你登入SC Mobile後點擊右上角的「聯絡及支援」圖示聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。 ~ Wes\",[1773829665,795000000]],null,[\"114803743674681679799\",\"Google 使用者\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/EGemoI2NTXmTsBVtJqk8jxF9rh8ApRWfsIMQSt2uE4OcpQqbFu7f7NbTK05lx80nuSijCz7sc3a277R67g\"]]],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,[[[\"vaf_phase1_auto_insurance\"]]],null,[true,false],null,1],[\"f33e24eb-3020-4cc3-befb-47fa0166deb5\",[\"Mama Hailey\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKpoTdLLjLlAJ7RpK2xdp6irdU8p7bbHnC4SonVaiMdKUU-pQ\\u003dmo\"]]],1,null,\"差差差！！！ 差到不得了！ 每隔一段時間上來就入不到，總是浪費他人時間轉來轉去。於網上嘗試登入又不成功(永遠又要手機程式取驗証碼)，根本是為刁難客人而設！ 請高層認真檢討，我已決定把資金搬離渣打，一個帶给人不方便的程式確實趕客。超級失望！！！😡😡😡😡😡😡(俾一粒星也嫌多，為了發佈評論只好就範)\",[1773023672,359000000],13,[\"Standard Chartered Bank PLC\",\"你好 Mama Hailey，抱歉未能為你帶來滿意的體驗，SC Mobile及網上理財現時正常運作，如你現時仍未能登入SC Mobile或網上理財，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續改善SC Mobile去提供更好的使用體驗，謝謝。 ~ Danny\",[1773829448,615000000]],null,[\"113436243224363162815\",\"Mama Hailey\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocKpoTdLLjLlAJ7RpK2xdp6irdU8p7bbHnC4SonVaiMdKUU-pQ\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"8aa83d85-a76c-42cb-b6e8-9f6003b1c7db\",[\"DarkZ Law\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL-Y5IjFQf_81dpKP5zJ0kez9FV__w-mmIUtpNMv4tNoekTfbU\\u003dmo\"]]],1,null,\"點解你系統維護之後(8 Mar 2026), 我連login 個account 都冇埋？話我錯acc/pw???\",[1773023199,405000000],0,[\"Standard Chartered Bank PLC\",\"你好 DarkZ Law ，抱歉為你帶來不便，SC Mobile及網上理財現時正常運作，如你現時仍未能登入SC Mobile或網上理財，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Danny\",[1773829251,258000000]],null,[\"117146826242298587814\",\"DarkZ Law\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocL-Y5IjFQf_81dpKP5zJ0kez9FV__w-mmIUtpNMv4tNoekTfbU\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"201efa96-5e40-4d59-a298-e410ec14f0bd\",[\"新田\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBOLTDJwL2kfziGE4P9IS0yBn3_xnnrfq6G85FrxYUXYO3bgXA\"]]],1,null,\"舊電話壞了 想用另一部電話down都唔得 點搞\",[1772258163,408000000],0,[\"Standard Chartered Bank PLC\",\"你好新田，感謝你的反饋意見。 我們會繼續優化SC Mobile App以令客戶獲得更佳體驗， 並期待獲得你的持續支持。隨著惡意軟件相關事件的增多，渣打銀行香港加強了安全控制措施，以保護我們的客戶，為他們提供最安全的網上銀行體驗。惡意軟件可能會使欺詐者在未經授權的情況下使用受害者的設備，並使用手機的螢幕錄製和類似功能來得到如電子銀行憑證等敏感資料。通過這些新的安全功能，客戶可以放心使用網上理財。 如果你需要向收款人/商戶證明付款紀錄，我哋會於SC Pay「轉數快」、「掃描支付」、本地或海外及跨境轉賬完成付款指示後經電子郵件、推送通知或短訊通知你有關交易狀況，謝謝 。 ~ Sara\",[1712539655,757000000]],null,[\"112408514424091853931\",\"新田\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjUBOLTDJwL2kfziGE4P9IS0yBn3_xnnrfq6G85FrxYUXYO3bgXA\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"309dd9fd-e9b8-4d0c-ac48-3ea6e6676392\",[\"张David\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFQl-oyW286KRmEQb_sSprWo6fJtHiKsc3IsGyAgBgfsp7gw\\u003dmo\"]]],1,null,\"怎麼回事？一直更新不了，停頓在99％\",[1772169176,40000000],0,[\"Standard Chartered Bank PLC\",\"你好张David，關於你提及更新SC Mobile時遇到停頓問題，我們建議您可以清除 Google Play Store 快取及檢查網路連線，然後再嘗試更新SC Mobile。你亦可以前往我們以下網站：https://www.sc.com/hk/zh/bank-with-us/app-sc-mobile/apk-download/ ，透過掃描二維碼形式下載SC Mobile。如你需要進一步協助，請你於渣打銀行網頁右下角，點擊智能助理Stacy圖示，聯絡線上客戶顧問，我們的線上客戶顧問會爲你提供協助，謝謝。~ Carl\",[1772522903,952000000]],null,[\"104699601113931291861\",\"张David\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIFQl-oyW286KRmEQb_sSprWo6fJtHiKsc3IsGyAgBgfsp7gw\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.11.0\",null,null,null,[true,false],null,1],[\"9eeb32e3-64e8-45a1-ad9a-f7a1835c78a9\",[\"Cy Hh\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLWNyLnEZ-s-waokidVlxTEAtvyIQ-1UZ-PxwVKmbvs2CrsWA\\u003dmo\"]]],1,null,\"三星A52 5g,說手机太舊無法相容、不能更新！不知怎用App了！\",[1772086914,400000000],0,[\"Standard Chartered Bank PLC\",\"你好Cy Hh，為了向用戶提供更好的服務和更高的安全性，我們定期更新應用程式版本。本行已將SC Mobile APP的最低操作系統要求設置為Android 10.0。你可以在「設定」應用程式中，點選「關於手機」或「系統」選項查看目前的系統版本，我們會繼續改進SC Mobile app以令客戶獲得更佳體驗，謝謝。 ~ Carl\",[1772503065,337000000]],null,[\"111219084989713328241\",\"Cy Hh\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLWNyLnEZ-s-waokidVlxTEAtvyIQ-1UZ-PxwVKmbvs2CrsWA\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,null,null,1],[\"3855f0af-bebe-4e48-b4b1-9cb0656e2589\",[\"Yiu Lai Ping\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWie5Nt_d74bLCaHAvNtJWj0ZLlkhke7K0nrYxlBeKj_OwxuC0\"]]],1,null,\"登入唔到，係咁要我啟動生物認證。但我一早啟動左\",[1772046574,996000000],0,[\"Standard Chartered Bank PLC\",\"你好Yiu Lai Ping，抱歉未能為你帶來滿意的使用體驗，明白你遇到生物認證登記問題，你可以先將SC Mobile更新至最新版本。如更新後提及的情況仍持續，請你於渣打銀行網頁： www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們也會繼續改進SC Mobile app以令客戶獲得更佳體驗，多謝你的反饋及支持，謝謝。 ~ Carl\",[1772509747,982000000]],null,[\"100268516655680110241\",\"Yiu Lai Ping\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a-/ALV-UjWie5Nt_d74bLCaHAvNtJWj0ZLlkhke7K0nrYxlBeKj_OwxuC0\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,[true,false],null,1],[\"1a01f627-2f61-40f0-b332-d1b4eb77ef00\",[\"Mike Cheng\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLiuIv0rkpkIZTNUlfZR8_HdQu2vAa8DZexdQBgs6gEtWL4Pg\\u003dmo\"]]],1,null,\"經常不能登入，已確定冇入錯資料，仍然成日入唔到，要重新申請賬號，垃圾一樣的app\",[1771919067,553000000],0,[\"Standard Chartered Bank PLC\",\"你好Mike Cheng，抱歉為你帶來不便，SC Mobile及網上理財現時正常運作，如你現時仍未能登入SC Mobile或網上理財，我們需要更多資料了解並跟進你的個案。請你於渣打銀行網頁：www.sc.com/hk/zh 右下角，點擊智能助理Stacy圖示，選擇「數碼銀行」\\u003e「登入問題」\\u003e「不能登入網上理財」聯絡線上客戶顧問。我們的線上客戶顧問會爲你提供協助，我們亦會持續優化SC Mobile去提供更好的使用體驗，謝謝。 ~ Carl\",[1772507945,920000000]],null,[\"101235527040428158278\",\"Mike Cheng\",null,[[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocLiuIv0rkpkIZTNUlfZR8_HdQu2vAa8DZexdQBgs6gEtWL4Pg\\u003dmo\"]],true],[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/Yq7oyNIvAAkuc69fG51sbAQS4otJxbObbt3xdr8tXxXyUdq4tVGtfgeKuptveGdP1srxaHVrNPzOYcfaEQ\"]]],\"7.12.0\",null,null,null,[true,false],null,1],[\"115bf8a9-5e00-40e8-99b3-a2bfa278cd8c\",[\"Chan cheuk ting\",[null,2,null,[null,null,\"https://play-lh.googleusercontent.com/a/ACg8ocIkS2eu5CZ3SXYCcLKEOuBVW16gR3F10Pu0nMZ-5NqqN2Sxgg\\u003dmo\"]]],2,null,\"更新後，login後彈apps自動退出..\",[1771212910,810000000],0,[\"Standard Chartered Bank PLC\",\"你好Chan cheuk ting，抱歉為你帶來不便，現